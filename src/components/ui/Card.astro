---
interface Props {
  href?: string;
  class?: string;
  padding?: 'sm' | 'md' | 'lg';
}

const {
  href,
  class: className = '',
  padding = 'md',
} = Astro.props;

const Tag = href ? 'a' : 'div';

const paddings: Record<string, string> = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const classes = `block bg-white rounded-xl border border-gray-200 ${paddings[padding]} ${href ? 'hover:border-primary/30 hover:shadow-md transition-all' : ''} ${className}`;
---

<Tag href={href} class={classes}>
  <slot />
</Tag>
