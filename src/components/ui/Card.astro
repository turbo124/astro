---
interface Props {
  href?: string;
  class?: string;
  padding?: 'sm' | 'md' | 'lg';
}

const {
  href,
  class: className = '',
  padding = 'md',
} = Astro.props;

const paddings: Record<string, string> = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const base = `rounded-xl border border-gray-200 bg-white ${paddings[padding]} ${className}`;
const interactive = 'hover:border-primary/30 hover:shadow-lg transition-all duration-200';
---

{href ? (
  <a href={href} class={`block ${base} ${interactive}`}>
    <slot />
  </a>
) : (
  <div class={base}>
    <slot />
  </div>
)}
