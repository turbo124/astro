---
const footerSections = [
  {
    title: "Products",
    links: [
      { label: "Overview", href: "/overview" },
      { label: "Invoicing", href: "/invoicing" },
      { label: "Payments", href: "/payments" },
      { label: "Projects & Tasks", href: "/projects" },
      { label: "Expenses", href: "/expenses" },
      { label: "Banking", href: "/banking" },
      { label: "Mobile & Desktop Apps", href: "/download-apps" },
    ],
  },
  {
    title: "Apps",
    links: [
      { label: "DocuNinja", href: "/documents" },
      { label: "Event Schedule", href: "/event-schedule" },
      { label: "QuickBooks Backup", href: "/quickbooks-backup-tool" },
      { label: "e-Invoicing", href: "/e-invoicing" },
      { label: "e-Signatures", href: "/e-signatures" },
      { label: "Automations", href: "/automations" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "Our Story", href: "/our-story" },
      { label: "Pricing", href: "/pricing-plans" },
      { label: "How It Works", href: "/how-it-works" },
      { label: "Blog", href: "/blog" },
      { label: "Contact & Support", href: "/contact-support" },
      { label: "Brand Kit", href: "/brand-kit" },
      { label: "Referrals", href: "/referrals" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Self-Hosting", href: "/self-hosting-privacy-data-control" },
      { label: "Hosting Recommendations", href: "/hosting-recommendations" },
      { label: "Installers", href: "/installers" },
      { label: "Invoice Templates", href: "/invoice-templates" },
      { label: "Zapier Integration", href: "/zapier" },
      { label: "Make Integration", href: "/make-integrations" },
    ],
  },
];

const legalLinks = [
  { label: "Terms", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "GDPR", href: "/gdpr" },
  { label: "PCI Compliance", href: "/pci-compliance" },
  { label: "Legal", href: "/legal" },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main Footer -->
    <div class="py-12 lg:py-16 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1 mb-4 lg:mb-0">
        <a href="/" class="flex items-center gap-2 mb-4">
          <svg viewBox="0 0 40 40" class="h-8 w-8" fill="none">
            <rect width="40" height="40" rx="8" fill="#0091EA" />
            <path d="M12 28V12h4v16h-4zm6-8h4v8h-4v-8zm6-4h4v12h-4V16z" fill="white" />
          </svg>
          <span class="text-lg font-bold text-white">Invoice Ninja</span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          Free open-source invoicing, payments, expenses & time-tracking for freelancers & businesses.
        </p>
        <!-- Social Links -->
        <div class="flex gap-3">
          <a href="https://github.com/invoiceninja" class="text-gray-400 hover:text-white transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://twitter.com/invoiceninja" class="text-gray-400 hover:text-white transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/invoiceninja" class="text-gray-400 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <!-- Link Columns -->
      {footerSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
            {section.title}
          </h3>
          <ul class="space-y-2.5">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-gray-400 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">
        &copy; {currentYear} Invoice Ninja. All rights reserved.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {legalLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs text-gray-500 hover:text-gray-300 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
