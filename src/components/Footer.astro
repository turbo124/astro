---
const products = [
  { label: "Invoice Ninja Overview", href: "/overview/" },
  { label: "Invoicing & Quotations", href: "/invoicing/" },
  { label: "Online Payments", href: "/payments/" },
  { label: "Time Track Tasks & Projects", href: "/projects/" },
  { label: "Expenses, Vendors, PO's", href: "/expenses/" },
  { label: "Integrate Bank Accounts", href: "/banking/" },
  { label: "Mobile & Desktop Apps", href: "/download-apps/" },
  { label: "DocuNinja App", href: "/documents/" },
  { label: "Event Schedule App", href: "https://www.eventschedule.com/" },
  { label: "QuickBooks Backup App", href: "/quickbooks-backup-tool/" },
];

const whyUs = [
  { label: "Referral Program -- Earn 50%!", href: "/referrals/" },
  { label: "Yes!", href: "/yes/" },
  { label: "Our Story", href: "/our-story/" },
  { label: "Who's It For?", href: "/whos-it-for/" },
  { label: "How It Works", href: "/how-it-works/" },
  { label: "How We Compare", href: "/compare/" },
  { label: "Slack", href: "https://slack.invoiceninja.com/" },
  { label: "Discord", href: "https://discord.gg/ZwEdtfCwXA" },
];

const resources = [
  { label: "Contact & Support", href: "/contact-support/" },
  { label: "EU eInvoicing", href: "/e-invoicing/" },
  { label: "App User Guide", href: "https://invoiceninja.github.io/" },
  { label: "API Documentation", href: "https://api-docs.invoicing.co/" },
  { label: "Self-Hosting Installers", href: "/installers/" },
  { label: "Self-Hosting Recommendations", href: "/hosting-recommendations/" },
  { label: "Business Blog", href: "/blog/" },
  { label: "Server Status", href: "https://status.invoiceninja.com/" },
  { label: "Branding Kit", href: "/brand-kit/" },
];

const legal = [
  { label: "Terms of Service", href: "/terms/" },
  { label: "Data Privacy", href: "/privacy-policy/" },
  { label: "PCI Compliance", href: "/pci/" },
  { label: "GDPR", href: "/gdpr/" },
  { label: "Self-Hosting Data", href: "/self-hosting-privacy-data-control/" },
  { label: "Self-Hosting Terms", href: "/self-hosting-terms-service/" },
];
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main Footer -->
    <div class="py-12 lg:py-16 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1 mb-4 lg:mb-0">
        <a href="/" class="flex items-center gap-3 mb-5">
          <img src="/images/logo-circle.png" alt="Invoice Ninja" class="h-10 w-10" />
        </a>
        <div class="space-y-3 mt-6">
          <a href="/pricing-plans/" class="block text-sm text-gray-400 hover:text-white transition-colors font-medium">Pricing</a>
          <a href="https://app.invoicing.co/#/login" class="block text-sm text-gray-400 hover:text-white transition-colors font-medium">Account Login</a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Products</h3>
        <ul class="space-y-2.5">
          {products.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Why Invoice Ninja? -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Why Invoice Ninja?</h3>
        <ul class="space-y-2.5">
          {whyUs.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-2.5">
          {resources.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">&copy; Invoice Ninja</p>
      <div class="flex flex-wrap justify-center gap-4">
        {legal.map((link) => (
          <a href={link.href} class="text-xs text-gray-500 hover:text-gray-300 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
