---
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const products = [
  { label: t(locale, 'footer.products.overview'), href: "/overview/" },
  { label: t(locale, 'footer.products.invoicing'), href: "/invoicing/" },
  { label: t(locale, 'footer.products.payments'), href: "/payments/" },
  { label: t(locale, 'footer.products.projects'), href: "/projects/" },
  { label: t(locale, 'footer.products.expenses'), href: "/expenses/" },
  { label: t(locale, 'footer.products.banking'), href: "/banking/" },
  { label: t(locale, 'footer.products.apps'), href: "/download-apps/" },
  { label: t(locale, 'footer.products.docuninja'), href: "/documents/" },
  { label: t(locale, 'footer.products.events'), href: "https://www.eventschedule.com/" },
  { label: t(locale, 'footer.products.quickbooks'), href: "/quickbooks-backup-tool/" },
];

const whyUs = [
  { label: t(locale, 'footer.whyUs.referrals'), href: "/referrals/" },
  { label: t(locale, 'footer.whyUs.yes'), href: "/yes/" },
  { label: t(locale, 'footer.whyUs.ourStory'), href: "/our-story/" },
  { label: t(locale, 'footer.whyUs.whoIsItFor'), href: "/whos-it-for/" },
  { label: t(locale, 'footer.whyUs.howItWorks'), href: "/how-it-works/" },
  { label: t(locale, 'footer.whyUs.compare'), href: "/compare/" },
  { label: t(locale, 'footer.whyUs.slack'), href: "https://slack.invoiceninja.com/" },
  { label: t(locale, 'footer.whyUs.discord'), href: "https://discord.gg/ZwEdtfCwXA" },
];

const resources = [
  { label: t(locale, 'footer.resources.contact'), href: "/contact-support/" },
  { label: t(locale, 'footer.resources.eInvoicing'), href: "/e-invoicing/" },
  { label: t(locale, 'footer.resources.userGuide'), href: "https://invoiceninja.github.io/" },
  { label: t(locale, 'footer.resources.api'), href: "https://api-docs.invoicing.co/" },
  { label: t(locale, 'footer.resources.installers'), href: "/installers/" },
  { label: t(locale, 'footer.resources.hosting'), href: "/hosting-recommendations/" },
  { label: t(locale, 'footer.resources.blog'), href: "/blog/" },
  { label: t(locale, 'footer.resources.status'), href: "https://status.invoiceninja.com/" },
  { label: t(locale, 'footer.resources.brandKit'), href: "/brand-kit/" },
];

const legal = [
  { label: t(locale, 'footer.legal.terms'), href: "/terms/" },
  { label: t(locale, 'footer.legal.privacy'), href: "/privacy-policy/" },
  { label: t(locale, 'footer.legal.pci'), href: "/pci/" },
  { label: t(locale, 'footer.legal.gdpr'), href: "/gdpr/" },
  { label: t(locale, 'footer.legal.selfHostPrivacy'), href: "/self-hosting-privacy-data-control/" },
  { label: t(locale, 'footer.legal.selfHostTerms'), href: "/self-hosting-terms-service/" },
];
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main Footer -->
    <div class="py-12 lg:py-16 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1 mb-4 lg:mb-0">
        <a href="/" class="flex items-center gap-3 mb-5">
          <img src="/images/logo-circle.png" alt="Invoice Ninja" class="h-10 w-10" />
        </a>
        <div class="space-y-3 mt-6">
          <a href="/pricing-plans/" class="block text-sm text-gray-400 hover:text-white transition-colors font-medium">{t(locale, 'footer.pricing')}</a>
          <a href="https://app.invoicing.co/#/login" class="block text-sm text-gray-400 hover:text-white transition-colors font-medium">{t(locale, 'footer.login')}</a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t(locale, 'footer.products')}</h3>
        <ul class="space-y-2.5">
          {products.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Why Invoice Ninja? -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t(locale, 'footer.whyUs')}</h3>
        <ul class="space-y-2.5">
          {whyUs.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t(locale, 'footer.resources')}</h3>
        <ul class="space-y-2.5">
          {resources.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">&copy; {new Date().getFullYear()} {t(locale, 'footer.copyright')}</p>
      <div class="flex flex-wrap justify-center gap-4">
        {legal.map((link) => (
          <a href={link.href} class="text-xs text-gray-500 hover:text-gray-300 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
