---
const navItems = [
  {
    label: "Products",
    href: "/overview",
    children: [
      { label: "Overview", href: "/overview" },
      { label: "Invoicing & Quotations", href: "/invoicing" },
      { label: "Online Payments", href: "/payments" },
      { label: "Time Track Tasks & Projects", href: "/projects" },
      { label: "Expenses, Vendors & POs", href: "/expenses" },
      { label: "Integrate Bank Accounts", href: "/banking" },
      { label: "Mobile & Desktop Apps", href: "/download-apps" },
      { label: "DocuNinja App", href: "/documents" },
      { label: "Event Schedule App", href: "/event-schedule" },
      { label: "QuickBooks Backup App", href: "/quickbooks-backup-tool" },
    ],
  },
  {
    label: "Why Us?",
    href: "/compare",
    children: [
      { label: "Compare", href: "/compare" },
      { label: "vs FreshBooks", href: "/compare/freshbooks" },
      { label: "vs Invoice2go", href: "/compare/invoice2go" },
      { label: "vs Zoho Invoice", href: "/compare/zoho" },
    ],
  },
  {
    label: "e-Invoicing",
    href: "/e-invoicing",
    children: [
      { label: "Overview", href: "/e-invoicing" },
      { label: "Spain", href: "/e-invoicing/spain" },
      { label: "Romania", href: "/e-invoicing/romania" },
      { label: "Italy", href: "/e-invoicing/italy" },
      { label: "Germany", href: "/e-invoicing/germany" },
      { label: "France", href: "/e-invoicing/france" },
    ],
  },
  { label: "Pricing", href: "/pricing-plans" },
  { label: "How It Works", href: "/how-it-works" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <svg viewBox="0 0 40 40" class="h-8 w-8" fill="none">
          <rect width="40" height="40" rx="8" fill="#0091EA" />
          <path d="M12 28V12h4v16h-4zm6-8h4v8h-4v-8zm6-4h4v12h-4V16z" fill="white" />
        </svg>
        <span class="text-xl font-bold text-dark">Invoice Ninja</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors"
            >
              {item.label}
              {item.children && (
                <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-white rounded-xl shadow-lg border border-gray-100 py-2 min-w-[240px]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="https://app.invoiceninja.com"
          class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary transition-colors"
        >
          Login
        </a>
        <a
          href="/yes"
          class="px-5 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors shadow-sm"
        >
          Get Started Free
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-gray-600 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <div>
          <button
            class="mobile-dropdown-btn flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50"
            data-has-children={item.children ? "true" : "false"}
          >
            {item.children ? (
              <>
                <span>{item.label}</span>
                <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </>
            ) : (
              <a href={item.href} class="block w-full text-left">{item.label}</a>
            )}
          </button>
          {item.children && (
            <div class="mobile-dropdown hidden pl-4 space-y-1">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50 transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-4 border-t border-gray-100 space-y-2">
        <a
          href="https://app.invoiceninja.com"
          class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 text-center"
        >
          Login
        </a>
        <a
          href="/yes"
          class="block px-3 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark text-center"
        >
          Get Started Free
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16 lg:h-20"></div>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  menuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    menuBtn.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll('.mobile-dropdown-btn[data-has-children="true"]').forEach((btn) => {
    btn.addEventListener("click", () => {
      const dropdown = btn.nextElementSibling;
      const arrow = btn.querySelector("svg");
      dropdown?.classList.toggle("hidden");
      arrow?.classList.toggle("rotate-180");
    });
  });
</script>
