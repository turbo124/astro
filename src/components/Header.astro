---
import LanguageSwitcher from './global/LanguageSwitcher.astro';
import { t, getLocaleFromURL, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromURL(Astro.url) } = Astro.props;
const currentPath = Astro.url.pathname;

const productsOverview = [
  { label: t(locale, 'nav.products.allBenefits'), desc: t(locale, 'nav.products.allBenefits.desc'), href: "/features/" },
  { label: t(locale, 'nav.products.expenses'), desc: t(locale, 'nav.products.expenses.desc'), href: "/expenses/" },
  { label: t(locale, 'nav.products.invoicing'), desc: t(locale, 'nav.products.invoicing.desc'), href: "/invoicing/" },
  { label: t(locale, 'nav.products.projects'), desc: t(locale, 'nav.products.projects.desc'), href: "/projects/" },
  { label: t(locale, 'nav.products.banking'), desc: t(locale, 'nav.products.banking.desc'), href: "/banking/" },
  { label: t(locale, 'nav.products.demo'), desc: t(locale, 'nav.products.demo.desc'), href: "https://react.invoicing.co/demo" },
];

const productsWorkflow = [
  { label: t(locale, 'nav.products.apps'), desc: t(locale, 'nav.products.apps.desc'), href: "/apps/" },
  { label: t(locale, 'nav.products.payments'), desc: t(locale, 'nav.products.payments.desc'), href: "/payments/" },
  { label: t(locale, 'nav.products.automations'), desc: t(locale, 'nav.products.automations.desc'), href: "/automations/" },
  { label: t(locale, 'nav.products.templates'), desc: t(locale, 'nav.products.templates.desc'), href: "/invoice-templates/" },
  { label: t(locale, 'nav.products.docuninja'), desc: t(locale, 'nav.products.docuninja.desc'), href: "/documents/" },
  { label: t(locale, 'nav.products.events'), desc: t(locale, 'nav.products.events.desc'), href: "https://www.eventschedule.com/" },
];

const whyUsItems = [
  { label: t(locale, 'nav.whyUs.comparison'), desc: t(locale, 'nav.whyUs.comparison.desc'), href: "/compare/" },
  { label: t(locale, 'nav.whyUs.whoIsItFor'), desc: t(locale, 'nav.whyUs.whoIsItFor.desc'), href: "/whos-it-for/" },
  { label: t(locale, 'nav.whyUs.howItWorks'), desc: t(locale, 'nav.whyUs.howItWorks.desc'), href: "/how-it-works/" },
  { label: t(locale, 'nav.whyUs.ourStory'), desc: t(locale, 'nav.whyUs.ourStory.desc'), href: "/our-story/" },
  { label: t(locale, 'nav.whyUs.yes'), desc: t(locale, 'nav.whyUs.yes.desc'), href: "/yes/" },
  { label: t(locale, 'nav.whyUs.referrals'), desc: t(locale, 'nav.whyUs.referrals.desc'), href: "/referrals/" },
];

const whyUsCompare = [
  { label: t(locale, 'nav.whyUs.vsOverview'), href: "/compare/" },
  { label: t(locale, 'nav.whyUs.vsZoho'), href: "/invoice-ninja-vs-zoho/" },
  { label: t(locale, 'nav.whyUs.vsInvoice2Go'), href: "/invoice-ninja-vs-invoice2go/" },
  { label: t(locale, 'nav.whyUs.vsFreshbooks'), href: "/invoice-ninja-vs-fresh-books/" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm shadow-gray-100/50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src="/images/logo-circle.png" alt="Invoice Ninja" class="h-9 w-9" />
        <span class="text-xl font-bold text-dark">Invoice Ninja</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">

        <!-- Products Mega Menu -->
        <div class="relative group">
          <a href="/overview/" class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
            {t(locale, 'nav.products')}
            <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="fixed left-0 right-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200" style="top: var(--header-height, 5rem);">
            <div class="bg-white shadow-xl border-t border-gray-100">
              <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-2 gap-x-12 gap-y-1">
                <div>
                  <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">{t(locale, 'nav.products.overview')}</h4>
                  {productsOverview.map((item) => (
                    <a href={item.href} class="block px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group/item">
                      <div class="text-sm font-medium text-gray-700 group-hover/item:text-primary">{item.label}</div>
                      <div class="text-xs text-gray-400 mt-0.5">{item.desc}</div>
                    </a>
                  ))}
                </div>
                <div>
                  <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">{t(locale, 'nav.products.workflow')}</h4>
                  {productsWorkflow.map((item) => (
                    <a href={item.href} class="block px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group/item">
                      <div class="text-sm font-medium text-gray-700 group-hover/item:text-primary">{item.label}</div>
                      <div class="text-xs text-gray-400 mt-0.5">{item.desc}</div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Why Us? Mega Menu -->
        <div class="relative group">
          <a href="/compare/" class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
            {t(locale, 'nav.whyUs')}
            <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="fixed left-0 right-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200" style="top: var(--header-height, 5rem);">
            <div class="bg-white shadow-xl border-t border-gray-100">
              <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-2 gap-x-12 gap-y-1">
                <div>
                  <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">{t(locale, 'nav.whyUs.whyInvoiceNinja')}</h4>
                  {whyUsItems.map((item) => (
                    <a href={item.href} class="block px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group/item">
                      <div class="text-sm font-medium text-gray-700 group-hover/item:text-primary">{item.label}</div>
                      <div class="text-xs text-gray-400 mt-0.5">{item.desc}</div>
                    </a>
                  ))}
                </div>
                <div>
                  <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">{t(locale, 'nav.whyUs.compare')}</h4>
                  {whyUsCompare.map((item) => (
                    <a href={item.href} class="block px-3 py-2.5 text-sm text-gray-600 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Simple Links -->
        <a href="/e-invoicing/" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
          {t(locale, 'nav.eInvoicing')}
        </a>
        <a href="/pricing-plans/" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
          {t(locale, 'nav.pricing')}
        </a>
        <a href="/how-it-works/" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
          {t(locale, 'nav.howItWorks')}
        </a>
      </div>

      <!-- Search + Auth Buttons + Language -->
      <div class="hidden lg:flex items-center gap-3">
        <button id="search-btn" class="p-2 text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50 transition-colors" aria-label="Search">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
        <a href="https://app.invoicing.co/#/login" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary transition-colors">
          {t(locale, 'nav.login')}
        </a>
        <a href="https://app.invoicing.co/#/register" class="px-5 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors shadow-sm">
          {t(locale, 'nav.signUp')}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-gray-600 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white max-h-[80vh] overflow-y-auto">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      <!-- Products -->
      <div>
        <button class="mobile-dropdown-btn flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50" data-has-children="true">
          <span>{t(locale, 'nav.products')}</span>
          <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-dropdown hidden pl-4 space-y-0.5 pb-2">
          <p class="px-3 pt-2 pb-1 text-xs font-semibold text-gray-400 uppercase">{t(locale, 'nav.products.overview')}</p>
          {productsOverview.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
          <p class="px-3 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase">{t(locale, 'nav.products.workflow')}</p>
          {productsWorkflow.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
        </div>
      </div>

      <!-- Why Us? -->
      <div>
        <button class="mobile-dropdown-btn flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50" data-has-children="true">
          <span>{t(locale, 'nav.whyUs')}</span>
          <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-dropdown hidden pl-4 space-y-0.5 pb-2">
          {whyUsItems.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
          <p class="px-3 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase">{t(locale, 'nav.whyUs.compare')}</p>
          {whyUsCompare.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
        </div>
      </div>

      <!-- Simple links -->
      <a href="/e-invoicing/" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">{t(locale, 'nav.eInvoicing')}</a>
      <a href="/pricing-plans/" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">{t(locale, 'nav.pricing')}</a>
      <a href="/how-it-works/" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">{t(locale, 'nav.howItWorks')}</a>

      <div class="pt-4 border-t border-gray-100 space-y-2">
        <a href="https://app.invoicing.co/#/login" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 text-center">{t(locale, 'nav.login')}</a>
        <a href="https://app.invoicing.co/#/register" class="block px-3 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark text-center">{t(locale, 'nav.signUp')}</a>
      </div>
    </div>
  </div>
</header>

<!-- Search Modal -->
<div id="search-modal" class="hidden fixed inset-0 z-[100] bg-black/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Site search">
  <div class="max-w-2xl mx-auto mt-12 sm:mt-20 px-4 max-h-[calc(100vh-6rem)] flex flex-col">
    <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden">
      <!-- Header with close hint -->
      <div class="flex items-center justify-between px-5 pt-4 pb-2 border-b border-gray-100">
        <span class="text-sm font-medium text-gray-500">{t(locale, 'nav.search')}</span>
        <kbd class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded font-mono">ESC</kbd>
      </div>
      <!-- Scrollable results area -->
      <div class="overflow-y-auto overscroll-contain px-2 pb-4" style="max-height: calc(100vh - 12rem);">
        <div id="pagefind-container"></div>
      </div>
    </div>
  </div>
</div>

<!-- Spacer for fixed header -->
<div class="h-16 lg:h-20"></div>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

<style is:inline>
  /* Pagefind UI overrides */
  .pagefind-ui {
    --pagefind-ui-primary: #0091EA;
    --pagefind-ui-text: #1f2937;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: inherit;
  }

  .pagefind-ui .pagefind-ui__search-input {
    font-size: 1rem;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
    outline: none;
  }

  .pagefind-ui .pagefind-ui__search-input:focus {
    border-color: #0091EA;
    box-shadow: 0 0 0 3px rgba(0, 145, 234, 0.15);
    background: #fff;
  }

  .pagefind-ui .pagefind-ui__search-clear {
    top: auto;
    right: 0.75rem;
    color: #9ca3af;
  }

  .pagefind-ui .pagefind-ui__result {
    padding: 1rem;
    border-radius: 10px;
    border: 1px solid transparent;
    transition: background 0.15s, border-color 0.15s;
  }

  .pagefind-ui .pagefind-ui__result:hover {
    background: #f0f9ff;
    border-color: #bae6fd;
  }

  .pagefind-ui .pagefind-ui__result-link {
    color: #0091EA;
    font-weight: 600;
    text-decoration: none;
  }

  .pagefind-ui .pagefind-ui__result-link:hover {
    text-decoration: underline;
  }

  .pagefind-ui .pagefind-ui__result-excerpt {
    color: #4b5563;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .pagefind-ui mark {
    background: rgba(0, 145, 234, 0.15);
    color: #0077C2;
    padding: 0.1em 0.2em;
    border-radius: 3px;
    font-weight: 600;
  }

  .pagefind-ui .pagefind-ui__message {
    color: #6b7280;
    font-size: 0.875rem;
    padding: 1.5rem 1rem;
  }

  .pagefind-ui .pagefind-ui__button {
    background: #0091EA;
    color: #fff;
    border-radius: 8px;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
    border: none;
    transition: background 0.15s;
  }

  .pagefind-ui .pagefind-ui__button:hover {
    background: #0077C2;
  }

  .pagefind-ui .pagefind-ui__result.is-active {
    background: #f0f9ff;
    border-color: #0091EA;
    outline: none;
  }
</style>

<script is:inline>
  // Set header height CSS variable for mega menu positioning
  const header = document.querySelector("header");
  if (header) {
    const updateHeaderHeight = () => {
      document.documentElement.style.setProperty("--header-height", header.offsetHeight + "px");
    };
    updateHeaderHeight();
    window.addEventListener("resize", updateHeaderHeight);
  }

  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  menuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    menuBtn.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll('.mobile-dropdown-btn[data-has-children="true"]').forEach((btn) => {
    btn.addEventListener("click", () => {
      const dropdown = btn.nextElementSibling;
      const arrow = btn.querySelector("svg");
      dropdown?.classList.toggle("hidden");
      arrow?.classList.toggle("rotate-180");
    });
  });

  // Search modal
  const searchBtn = document.getElementById("search-btn");
  const searchModal = document.getElementById("search-modal");
  let pagefindLoaded = false;

  function openSearch() {
    searchModal?.classList.remove("hidden");
    if (!pagefindLoaded) {
      pagefindLoaded = true;
      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => {
        // @ts-ignore
        new PagefindUI({
          element: "#pagefind-container",
          showSubResults: true,
          showImages: false,
        });
        setTimeout(() => {
          const input = document.querySelector("#pagefind-container input");
          if (input) input.focus();
        }, 100);
      };
      document.head.appendChild(script);
    } else {
      setTimeout(() => {
        const input = document.querySelector("#pagefind-container input");
        if (input) input.focus();
      }, 50);
    }
  }

  searchBtn?.addEventListener("click", openSearch);

  searchModal?.addEventListener("click", (e) => {
    if (e.target === searchModal) searchModal.classList.add("hidden");
  });

  // Arrow key navigation for search results
  let activeIndex = -1;

  function getResults() {
    return document.querySelectorAll("#pagefind-container .pagefind-ui__result");
  }

  function setActiveResult(index) {
    var results = getResults();
    results.forEach(function(r) { r.classList.remove("is-active"); });
    activeIndex = index;
    if (activeIndex >= 0 && activeIndex < results.length) {
      results[activeIndex].classList.add("is-active");
      results[activeIndex].scrollIntoView({ block: "nearest" });
    }
  }

  // Reset active index whenever results change (new search query)
  var observer = new MutationObserver(function() { activeIndex = -1; });
  var container = document.getElementById("pagefind-container");
  if (container) observer.observe(container, { childList: true, subtree: true });

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openSearch();
      return;
    }
    if (e.key === "Escape") {
      searchModal?.classList.add("hidden");
      return;
    }

    // Only handle arrows/enter when search modal is open
    if (searchModal?.classList.contains("hidden")) return;

    var results = getResults();
    if (results.length === 0) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActiveResult(activeIndex < results.length - 1 ? activeIndex + 1 : 0);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (activeIndex <= 0) {
        setActiveResult(-1);
        var input = document.querySelector("#pagefind-container input");
        if (input) input.focus();
      } else {
        setActiveResult(activeIndex - 1);
      }
    } else if (e.key === "Enter" && activeIndex >= 0) {
      e.preventDefault();
      var link = results[activeIndex].querySelector("a");
      if (link) link.click();
    }
  });
</script>
