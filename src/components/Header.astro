---
import LanguageSwitcher from './global/LanguageSwitcher.astro';
import { getLocaleFromURL, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromURL(Astro.url) } = Astro.props;
const currentPath = Astro.url.pathname;

const productsOverview = [
  { label: "All Benefits", desc: "Freelancer? Small business? Features to get you paid, fast.", href: "/features/" },
  { label: "Expenses, Vendors, PO's", desc: "Manage & re-invoice expenses, track vendors & purchase orders.", href: "/expenses/" },
  { label: "Invoicing, Quotes, Payments", desc: "Tools to run your business, invoice clients & get paid.", href: "/invoicing/" },
  { label: "Projects, Tasks, Time-Tracking", desc: "Create projects, tasks, track billable work-hours.", href: "/projects/" },
  { label: "Connect Bank & Financial Accounts", desc: "Automatically import bank, credit card and PayPal transactions.", href: "/banking/" },
  { label: "Product Demo", desc: "Need an awesome solution for invoicing clients? Test Drive!", href: "https://react.invoicing.co/demo" },
];

const productsWorkflow = [
  { label: "Apps / OS Tools", desc: "Web, Desktop, iOS, Google Play, Linux, Windows Apps", href: "/apps/" },
  { label: "Online Payments", desc: "Accept credit cards, ACH, PayPal & more", href: "/payments/" },
  { label: "Automations", desc: "Integrate with hundreds apps via Zapier, n8n, Make, Integrately & more", href: "/automations/" },
  { label: "Invoice Designs", desc: "Beautifully designed invoice templates", href: "/invoice-templates/" },
  { label: "DocuNinja", desc: "e-Signing & Document Management.", href: "/documents/" },
  { label: "Event Schedule", desc: "Set up an events calendar, create event pages, invite attendees, issue tickets!", href: "https://www.eventschedule.com/" },
];

const whyUsItems = [
  { label: "Competition Comparison", desc: "How does Invoice Ninja stack up against the competition?", href: "/compare/" },
  { label: "Who is it for?", desc: "Freelancers, service professionals, business owners", href: "/whos-it-for/" },
  { label: "How it works?", desc: "4 steps to get paid online", href: "/how-it-works/" },
  { label: "Our Story", desc: "Building business tools since 2014!", href: "/our-story/" },
  { label: "Yes!", desc: "With Invoice Ninja, the answer is always yes!", href: "/yes/" },
  { label: "Referral Program", desc: "50% on referrals for 3 years!", href: "/referrals/" },
];

const whyUsCompare = [
  { label: "Overview", href: "/compare/" },
  { label: "vs. Zoho", href: "/invoice-ninja-vs-zoho/" },
  { label: "vs. Invoice2Go", href: "/invoice-ninja-vs-invoice2go/" },
  { label: "vs. Freshbooks", href: "/invoice-ninja-vs-fresh-books/" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src="/images/logo-circle.png" alt="Invoice Ninja" class="h-9 w-9" />
        <span class="text-xl font-bold text-dark">Invoice Ninja</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">

        <!-- Products Mega Menu -->
        <div class="relative group">
          <a href="/overview/" class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
            Products
            <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute top-full -left-4 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-xl border border-gray-100 p-6 grid grid-cols-2 gap-x-8 gap-y-1 min-w-[560px]">
              <div>
                <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">Overview</h4>
                {productsOverview.map((item) => (
                  <a href={item.href} class="block px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group/item">
                    <div class="text-sm font-medium text-gray-700 group-hover/item:text-primary">{item.label}</div>
                    <div class="text-xs text-gray-400 mt-0.5">{item.desc}</div>
                  </a>
                ))}
              </div>
              <div>
                <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">Workflow</h4>
                {productsWorkflow.map((item) => (
                  <a href={item.href} class="block px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group/item">
                    <div class="text-sm font-medium text-gray-700 group-hover/item:text-primary">{item.label}</div>
                    <div class="text-xs text-gray-400 mt-0.5">{item.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Why Us? Mega Menu -->
        <div class="relative group">
          <a href="/compare/" class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
            Why Us?
            <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute top-full -left-4 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-xl border border-gray-100 p-6 grid grid-cols-2 gap-x-8 gap-y-1 min-w-[520px]">
              <div>
                <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">Why Invoice Ninja?</h4>
                {whyUsItems.map((item) => (
                  <a href={item.href} class="block px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group/item">
                    <div class="text-sm font-medium text-gray-700 group-hover/item:text-primary">{item.label}</div>
                    <div class="text-xs text-gray-400 mt-0.5">{item.desc}</div>
                  </a>
                ))}
              </div>
              <div>
                <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-3">Compare</h4>
                {whyUsCompare.map((item) => (
                  <a href={item.href} class="block px-3 py-2.5 text-sm text-gray-600 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Simple Links -->
        <a href="/e-invoicing/" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
          e-Invoicing
        </a>
        <a href="/pricing-plans/" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
          Pricing
        </a>
        <a href="/how-it-works/" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:text-primary hover:bg-gray-50 transition-colors">
          How It Works
        </a>
      </div>

      <!-- Auth Buttons + Language -->
      <div class="hidden lg:flex items-center gap-3">
        <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
        <a href="https://app.invoicing.co/#/login" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary transition-colors">
          Login
        </a>
        <a href="https://app.invoicing.co/#/register" class="px-5 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors shadow-sm">
          Sign Up
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-gray-600 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white max-h-[80vh] overflow-y-auto">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      <!-- Products -->
      <div>
        <button class="mobile-dropdown-btn flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50" data-has-children="true">
          <span>Products</span>
          <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-dropdown hidden pl-4 space-y-0.5 pb-2">
          <p class="px-3 pt-2 pb-1 text-xs font-semibold text-gray-400 uppercase">Overview</p>
          {productsOverview.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
          <p class="px-3 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase">Workflow</p>
          {productsWorkflow.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
        </div>
      </div>

      <!-- Why Us? -->
      <div>
        <button class="mobile-dropdown-btn flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50" data-has-children="true">
          <span>Why Us?</span>
          <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-dropdown hidden pl-4 space-y-0.5 pb-2">
          {whyUsItems.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
          <p class="px-3 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase">Compare</p>
          {whyUsCompare.map((item) => (
            <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-primary rounded-lg hover:bg-gray-50">{item.label}</a>
          ))}
        </div>
      </div>

      <!-- Simple links -->
      <a href="/e-invoicing/" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">e-Invoicing</a>
      <a href="/pricing-plans/" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">Pricing</a>
      <a href="/how-it-works/" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">How It Works</a>

      <div class="pt-4 border-t border-gray-100 space-y-2">
        <a href="https://app.invoicing.co/#/login" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 text-center">Login</a>
        <a href="https://app.invoicing.co/#/register" class="block px-3 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark text-center">Sign Up</a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16 lg:h-20"></div>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  menuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    menuBtn.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll('.mobile-dropdown-btn[data-has-children="true"]').forEach((btn) => {
    btn.addEventListener("click", () => {
      const dropdown = btn.nextElementSibling;
      const arrow = btn.querySelector("svg");
      dropdown?.classList.toggle("hidden");
      arrow?.classList.toggle("rotate-180");
    });
  });
</script>
