---
// Hero section — exact content from invoiceninja.com homepage
---

<section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-white to-blue-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-lg sm:text-xl text-primary font-semibold mb-4">Free Invoicing for Small Business</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-dark leading-tight tracking-tight">
        Make it easy for clients to pay you.
      </h1>
      <div class="mt-10">
        <a
          href="https://app.invoicing.co/#/register"
          class="inline-block px-10 py-4 text-lg font-semibold text-white bg-primary rounded-xl hover:bg-primary-dark transition-all shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5"
        >
          Get Started!
        </a>
      </div>
    </div>
    <!-- Dashboard screenshot placeholder -->
    <div class="mt-16 max-w-5xl mx-auto">
      <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden aspect-video flex items-center justify-center">
        <div class="text-center text-gray-400 p-8">
          <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <p class="text-sm">Dashboard screenshot</p>
        </div>
      </div>
    </div>
  </div>
  <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-t from-primary/5 to-transparent rounded-full blur-3xl pointer-events-none"></div>
</section>
