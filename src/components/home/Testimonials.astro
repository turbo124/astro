---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const testimonials = [
  {
    quote: "Invoice Ninja is a robust, flexible, yet surprisingly affordable invoicing and expense management tool that more than 200,000 sole proprietors and small business owners use every day\u2026",
    source: "CardRates.com",
    href: "https://www.cardrates.com/news/invoice-ninja-makes-getting-paid-seamless-for-smbs/",
  },
  {
    quote: "Invoice Ninja is well on its way to becoming one of the greats of the invoicing world! A great option for small business owners!",
    source: "Merchant Maverick",
    href: "https://www.merchantmaverick.com/review-category/invoicing-software/?sortby=rating&pagen=0",
  },
  {
    quote: "The best free invoice software is not only easy on the bank account but user-friendly and packed with the features!",
    source: "Forbes",
    href: "https://www.forbes.com/advisor/business/software/best-free-invoice-software/",
  },
];
---

<section class="bg-gray-50 py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark">{t(locale, 'testimonials.heading')}</h2>
      <p class="mt-3 text-lg text-gray-500">{t(locale, 'testimonials.subheading')}</p>
    </div>

    <!-- Testimonial Cards -->
    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <a href={testimonial.href} target="_blank" rel="noopener noreferrer" class="block bg-white rounded-2xl p-6 lg:p-8 border border-gray-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
          <!-- 5 Stars -->
          <div class="flex gap-1 mb-5">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="text-gray-600 leading-relaxed mb-6 text-sm lg:text-base">
            &ldquo;{testimonial.quote}&rdquo;
          </blockquote>
          <div class="text-sm font-semibold text-primary">{testimonial.source}</div>
        </a>
      ))}
    </div>
  </div>
</section>
