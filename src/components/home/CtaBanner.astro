---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<section class="bg-primary py-20 lg:py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white">{t(locale, 'ctaBanner.heading')}</h2>
    <p class="mt-4 text-lg text-white/80">{t(locale, 'ctaBanner.subheading')}</p>
    <div class="mt-10">
      <a
        href="https://app.invoicing.co/#/register"
        class="inline-block px-10 py-4 text-lg font-semibold text-primary bg-white rounded-xl hover:bg-gray-50 transition-all shadow-lg"
      >
        {t(locale, 'ctaBanner.cta')}
      </a>
    </div>
  </div>
</section>
