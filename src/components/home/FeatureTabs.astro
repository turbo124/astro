---
// Tabbed section: "Payment gateways, apps, integrations" — exact content from invoiceninja.com
---

<section class="bg-gray-50 py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark">Payment gateways, apps, integrations</h2>
    </div>

    <!-- Tab Buttons -->
    <div class="flex flex-wrap justify-center gap-2 mb-12" role="tablist">
      <button class="tab-btn active px-5 py-2.5 text-sm font-medium rounded-lg transition-colors" role="tab" aria-selected="true" data-tab="templates">
        Invoice Template Designs
      </button>
      <button class="tab-btn px-5 py-2.5 text-sm font-medium rounded-lg transition-colors" role="tab" aria-selected="false" data-tab="gateways">
        Payment Gateways
      </button>
      <button class="tab-btn px-5 py-2.5 text-sm font-medium rounded-lg transition-colors" role="tab" aria-selected="false" data-tab="apps">
        Mobile & Desktop Apps
      </button>
      <button class="tab-btn px-5 py-2.5 text-sm font-medium rounded-lg transition-colors" role="tab" aria-selected="false" data-tab="integrations">
        Integrations
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-12">

      <!-- Tab 1: Invoice Template Designs -->
      <div class="tab-panel" id="panel-templates">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark mb-4">The perfect invoice design for your business</h3>
            <p class="text-gray-600 mb-6">Creating professional invoices is easier than ever.</p>
            <div class="space-y-3 mb-6">
              <div class="flex items-center gap-3 p-3 bg-primary/5 rounded-lg">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-sm font-medium text-dark">Pro & Enterprise Plans Include 11 Invoice Templates!</span>
              </div>
              <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-sm font-medium text-dark">4 Free Invoice Template Designs!</span>
              </div>
            </div>
            <p class="text-sm text-gray-500 mb-4">Free accounts include 4 free invoice template designs, Pro & Enterprise plans include 11 invoice template designs, each invoice is 100% customizable!</p>
            <p class="text-sm text-gray-500 mb-8">Create beautiful customizable invoice templates & grow your business with Invoice Ninja!</p>
            <a href="/invoice-templates/" class="inline-block px-6 py-3 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors">
              View All Invoice Templates
            </a>
          </div>
          <div class="bg-gray-50 rounded-xl aspect-[4/3] flex items-center justify-center">
            <div class="text-center text-gray-400 p-8">
              <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              <p class="text-sm">Invoice template previews</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Payment Gateways -->
      <div class="tab-panel hidden" id="panel-gateways">
        <div class="grid lg:grid-cols-2 gap-10 items-start">
          <div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark mb-4">Get paid online with 1-click!</h3>
            <p class="text-gray-600 mb-6">Invoice Ninja integrates with many "payment gateways", also known as merchant processors. Integrating your Invoice Ninja account with a "payment gateway" allows clients to pay their invoices with 1-click!</p>
            <h4 class="text-sm font-semibold text-dark mb-4">Invoice Ninja payment integrations:</h4>
            <div class="grid sm:grid-cols-2 gap-2 mb-8">
              <a href="/payment-gateway/stripe/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Stripe Payments
              </a>
              <a href="/payment-gateway/paypal/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                PayPal Payments
              </a>
              <a href="/payment-gateway/gocardless/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                GoCardless Payments
              </a>
              <a href="/payment-gateway/payfast/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                PayFast Payments
              </a>
              <a href="/payment-gateway/authorize-net/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Authorize.net Payments
              </a>
              <a href="/payment-gateway/mollie/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Mollie Payments
              </a>
              <a href="/payments/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                BTCPay Server
              </a>
              <a href="/payments/" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                More Payment Options!
              </a>
            </div>
            <a href="/payments/" class="inline-block px-6 py-3 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors">
              View all payment gateway integrations!
            </a>
          </div>
          <div class="bg-gray-50 rounded-xl aspect-[4/3] flex items-center justify-center">
            <div class="text-center text-gray-400 p-8">
              <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
              <p class="text-sm">Payment gateway logos</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 3: Mobile & Desktop Apps -->
      <div class="tab-panel hidden" id="panel-apps">
        <div class="grid lg:grid-cols-2 gap-10 items-start">
          <div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark mb-4">Mobile & desktop apps</h3>
            <p class="text-gray-600 mb-8">Creating professional invoices is easier than ever.</p>
            <div class="space-y-3 mb-8">
              <a href="https://apps.apple.com/us/app/invoice-ninja-v5/id1503970375?platform=iphone" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
