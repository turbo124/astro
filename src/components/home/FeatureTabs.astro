      <!-- Tab 4: Integrations -->
      <div class="tab-panel hidden" id="panel-integrations">
        <div class="grid lg:grid-cols-2 gap-10 items-start">
          <div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark mb-4">The perfect invoice design for your business</h3>
            <p class="text-gray-600 mb-6">Improve cash flow by automating the creation of your customer invoices. Connect Invoice Ninja to thousands of apps via our platform integrators such as Zapier, Make and more!</p>
            <div class="space-y-2 mb-6">
              <a href="/zapier/" class="flex items-center gap-2 px-3 py-2.5 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Zapier Integrations
              </a>
              <a href="/make-integrations/" class="flex items-center gap-2 px-3 py-2.5 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Make.com Integrations
              </a>
              <a href="https://integrately.com/integrations/invoice-ninja" class="flex items-center gap-2 px-3 py-2.5 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Integrately Integrations
              </a>
              <a href="https://www.pabbly.com/connect/integrations/invoice-ninja/" class="flex items-center gap-2 px-3 py-2.5 text-sm text-gray-600 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                Pabbly Integrations
              </a>
            </div>
            <p class="text-sm text-gray-500 mb-8">Bring the power of automation to any process. Build advanced workflows that incorporate custom logic, conditions, filters, and more. No code needed.</p>
            <a href="/automations/" class="inline-block px-6 py-3 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors">
              View All Integrations
            </a>
          </div>
          <div class="bg-gray-50 rounded-xl aspect-[4/3] flex items-center justify-center">
            <div class="text-center text-gray-400 p-8">
              <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
              <p class="text-sm">Integration logos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tab-btn {
    color: var(--color-gray-500);
    background: transparent;
  }
  .tab-btn:hover {
    color: var(--color-gray-700);
    background: var(--color-gray-100);
  }
  .tab-btn.active {
    color: white;
    background: var(--color-primary);
  }
  .tab-btn.active:hover {
    background: var(--color-primary-dark);
  }
</style>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');

      tabBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      tabPanels.forEach((panel) => {
        panel.classList.add('hidden');
      });
      document.getElementById(`panel-${tabId}`)?.classList.remove('hidden');
    });
  });
</script>
