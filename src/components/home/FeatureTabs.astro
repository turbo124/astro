                </div>
                <span class="text-sm font-medium text-gray-700">Google Play Mobile App</span>
              </a>
              <a href="https://apps.apple.com/app/id1503970375" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center shrink-0">
