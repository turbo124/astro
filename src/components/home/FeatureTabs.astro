                  <svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.027-.78-.07-1.109m-7.981.105c.647-.034 1.233-.1 1.233-.1.584-.068.516-.93-.067-.898 0 0-1.755.138-2.89.138-1.064 0-2.856-.138-2.856-.138-.583-.032-.652.864-.068.898 0 0 .548.063 1.127.1l1.674 4.594-2.353 7.06L5.23 7.036c.648-.034 1.234-.1 1.234-.1.584-.068.515-.93-.068-.898 0 0-1.754.138-2.888.138-.203 0-.443-.005-.694-.013C4.842 3.3 8.178 1.5 12 1.5c2.854 0 5.458 1.092 7.404 2.88-.047-.003-.094-.008-.143-.008-1.065 0-1.82.928-1.82 1.928 0 .895.515 1.654 1.064 2.55.412.714.89 1.632.89 2.956 0 .918-.353 1.983-.82 3.466l-1.075 3.59-3.89-11.582zM12 22.5c-1.42 0-2.774-.282-4.014-.794l4.26-12.375 4.364 11.955c.03.068.066.127.105.18A10.473 10.473 0 0112 22.5M1.213 12c0-2.35.76-4.523 2.049-6.294L8.68 20.732C4.344 19.06 1.213 15.85 1.213 12"/></svg>
                </div>
                <span class="text-sm font-medium text-gray-700">WordPress Plugin</span>
              </a>
            </div>
            <a href="/apps/" class="inline-block px-6 py-3 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors">
              Learn More
            </a>
          </div>
          <div class="bg-gray-50 rounded-xl aspect-[4/3] flex items-center justify-center">
            <div class="text-center text-gray-400 p-8">
              <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
