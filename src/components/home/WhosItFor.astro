---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark">{t(locale, 'whosItFor.heading')}</h2>
      <p class="mt-3 text-lg text-gray-600">{t(locale, 'whosItFor.subheading1')}</p>
      <p class="text-lg text-gray-600">{t(locale, 'whosItFor.subheading2')}</p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <!-- Card 1: Freelancers & Small Business -->
      <div class="bg-gray-50 rounded-2xl overflow-hidden border border-gray-100 hover:border-primary/20 hover:shadow-lg transition-all duration-300">
        <div class="aspect-[16/10] overflow-hidden">
          <img src="/images/home/image.jpg" alt="Freelancer invoicing" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="p-8">
          <p class="text-xs text-gray-400 mb-3">{t(locale, 'whosItFor.card1.tags')}</p>
          <h3 class="text-xl sm:text-2xl font-bold text-dark mb-4">{t(locale, 'whosItFor.card1.title')}</h3>
          <p class="text-gray-600 leading-relaxed mb-6">
            {t(locale, 'whosItFor.card1.desc')}
          </p>
          <a href="/whos-it-for/" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
            {t(locale, 'whosItFor.learnMore')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Card 2: Tech Professionals -->
      <div class="bg-gray-50 rounded-2xl overflow-hidden border border-gray-100 hover:border-primary/20 hover:shadow-lg transition-all duration-300">
        <div class="aspect-[16/10] overflow-hidden">
          <img src="/images/home/image-1.jpg" alt="Tech professional invoicing" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="p-8">
          <p class="text-xs text-gray-400 mb-3">{t(locale, 'whosItFor.card2.tags')}</p>
          <h3 class="text-xl sm:text-2xl font-bold text-dark mb-4">{t(locale, 'whosItFor.card2.title')}</h3>
          <p class="text-gray-600 leading-relaxed mb-3">
            {t(locale, 'whosItFor.card2.desc1')}
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            {t(locale, 'whosItFor.card2.desc2')}
          </p>
          <a href="/whos-it-for/" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
            {t(locale, 'whosItFor.learnMore')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
