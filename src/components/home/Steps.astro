---
// "4 Steps to Get Paid" — styled to match invoiceninja.com homepage
const steps = [
  {
    number: 1,
    title: "Let's get started!",
    items: [
      { label: "Create a FREE account", href: "https://app.invoicing.co/#/register" },
      { label: "Confirm your email" },
      { label: "Login & customize!" },
    ],
    cta: { label: "Create Account", href: "https://app.invoicing.co/#/register" },
  },
  {
    number: 2,
    title: "Upload your logo",
    items: [
      { label: "Upload your logo" },
      { label: "Enter company info" },
      { label: "Explore invoice designs" },
    ],
    cta: { label: "Invoice Templates", href: "/invoice-templates/" },
  },
  {
    number: 3,
    title: "Setup online payments",
    items: [
      { label: "Stripe Connect", href: "/payment-gateway/stripe/" },
      { label: "PayPal & Venmo", href: "/payment-gateway/paypal/" },
      { label: "GoCardless", href: "/payment-gateway/gocardless/" },
      { label: "Many payment options", href: "/payments/" },
    ],
    cta: { label: "Payment Gateways", href: "/payments/" },
  },
  {
    number: 4,
    title: "Create invoices, get paid",
    items: [
      { label: "Email invoices & quotes", href: "/invoicing/" },
      { label: "Time-tasks & projects", href: "/projects/" },
      { label: "Track expenses & vendors", href: "/expenses/" },
      { label: "Sync your bank accounts", href: "/banking/" },
      { label: "So much more!", href: "/features/" },
    ],
    cta: { label: "Learn More", href: "/overview/" },
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <a href="/how-it-works/" class="hover:text-primary transition-colors">
        <h2 class="text-3xl sm:text-4xl font-bold text-dark">4 Steps to Get Paid.</h2>
      </a>
      <p class="mt-3 text-lg text-gray-500">Yes, it's really that easy!</p>
    </div>

    <!-- Steps Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="relative bg-gradient-to-br from-[#1e293b] to-[#0f172a] rounded-2xl p-6 text-white group hover:from-primary hover:to-primary-dark transition-all duration-300 shadow-lg">
          <!-- Step Label -->
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-widest text-white/60">{step.number} Step</span>
          </div>

          <!-- Title -->
          <h3 class="text-lg font-bold text-white mb-5">{step.title}</h3>

          <!-- Items List -->
          <ol class="space-y-2 mb-6 list-decimal list-inside">
            {step.items.map((item) => (
              <li class="text-sm text-white/80">
                {item.href ? (
                  <a href={item.href} class="text-white/80 hover:text-white transition-colors underline decoration-white/30 hover:decoration-white" target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            ))}
          </ol>

          <!-- CTA Arrow Button -->
          <a
            href={step.cta.href}
            class="absolute bottom-5 right-5 w-10 h-10 flex items-center justify-center rounded-full border border-white/30 hover:border-white hover:bg-white/10 transition-all"
            aria-label={step.cta.label}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M7 17L17 7M17 7V17M17 7H7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
