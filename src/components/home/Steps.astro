---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const steps = [
  {
    number: 1,
    title: t(locale, 'steps.1.title'),
    items: [
      { label: t(locale, 'steps.1.item1'), href: "https://app.invoicing.co/#/register" },
      { label: t(locale, 'steps.1.item2') },
      { label: t(locale, 'steps.1.item3') },
    ],
    cta: { label: t(locale, 'steps.1.cta'), href: "https://app.invoicing.co/#/register" },
  },
  {
    number: 2,
    title: t(locale, 'steps.2.title'),
    items: [
      { label: t(locale, 'steps.2.item1') },
      { label: t(locale, 'steps.2.item2') },
      { label: t(locale, 'steps.2.item3') },
    ],
    cta: { label: t(locale, 'steps.2.cta'), href: "/invoice-templates/" },
  },
  {
    number: 3,
    title: t(locale, 'steps.3.title'),
    items: [
      { label: t(locale, 'steps.3.item1'), href: "/payment-gateway/stripe/" },
      { label: t(locale, 'steps.3.item2'), href: "/payment-gateway/paypal/" },
      { label: t(locale, 'steps.3.item3'), href: "/payment-gateway/gocardless/" },
      { label: t(locale, 'steps.3.item4'), href: "/payments/" },
    ],
    cta: { label: t(locale, 'steps.3.cta'), href: "/payments/" },
  },
  {
    number: 4,
    title: t(locale, 'steps.4.title'),
    items: [
      { label: t(locale, 'steps.4.item1'), href: "/invoicing/" },
      { label: t(locale, 'steps.4.item2'), href: "/projects/" },
      { label: t(locale, 'steps.4.item3'), href: "/expenses/" },
      { label: t(locale, 'steps.4.item4'), href: "/banking/" },
      { label: t(locale, 'steps.4.item5'), href: "/features/" },
    ],
    cta: { label: t(locale, 'steps.4.cta'), href: "/overview/" },
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <a href="/how-it-works/" class="hover:text-primary transition-colors">
        <h2 class="text-3xl sm:text-4xl font-bold text-dark">{t(locale, 'steps.heading')}</h2>
      </a>
      <p class="mt-3 text-lg text-gray-500">{t(locale, 'steps.subheading')}</p>
    </div>

    <!-- Steps Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="relative bg-gradient-to-br from-[#1e293b] to-[#0f172a] rounded-2xl p-6 text-white group hover:from-primary hover:to-primary-dark transition-all duration-300 shadow-lg">
          <!-- Step Label -->
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-widest text-white/60">{step.number} {t(locale, 'steps.step')}</span>
          </div>

          <!-- Title -->
          <h3 class="text-lg font-bold text-white mb-5">{step.title}</h3>

          <!-- Items List -->
          <ol class="space-y-2 mb-6 list-decimal list-inside">
            {step.items.map((item) => (
              <li class="text-sm text-white/80">
                {item.href ? (
                  <a href={item.href} class="text-white/80 hover:text-white transition-colors underline decoration-white/30 hover:decoration-white" target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            ))}
          </ol>

          <!-- CTA Arrow Button -->
          <a
            href={step.cta.href}
            class="absolute bottom-5 right-5 w-10 h-10 flex items-center justify-center rounded-full border border-white/30 hover:border-white hover:bg-white/10 transition-all"
            aria-label={step.cta.label}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M7 17L17 7M17 7V17M17 7H7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
