---
// "4 Steps to Get Paid" — exact content from invoiceninja.com
const steps = [
  {
    number: 1,
    title: "Let's get started!",
    items: [
      { label: "Create a FREE account", href: "https://app.invoicing.co/#/register" },
      { label: "Confirm your email" },
      { label: "Login & customize!" },
    ],
    cta: { label: "Create Account", href: "https://app.invoicing.co/#/register" },
  },
  {
    number: 2,
    title: "Upload your logo",
    items: [
      { label: "Upload your logo" },
      { label: "Enter company info" },
      { label: "Explore invoice designs" },
    ],
    cta: { label: "Invoice Templates", href: "/invoice-templates/" },
  },
  {
    number: 3,
    title: "Setup online payments",
    items: [
      { label: "Stripe Connect", href: "/payment-gateway/stripe/" },
      { label: "PayPal & Venmo", href: "/payment-gateway/paypal/" },
      { label: "GoCardless", href: "/payment-gateway/gocardless/" },
      { label: "Many payment options", href: "/payments/" },
    ],
    cta: { label: "Payment Gateways", href: "/payments/" },
  },
  {
    number: 4,
    title: "Create invoices, get paid",
    items: [
      { label: "Email invoices & quotes", href: "/invoicing/" },
      { label: "Time-tasks & projects", href: "/projects/" },
      { label: "Track expenses & vendors", href: "/expenses/" },
      { label: "Sync your bank accounts", href: "/banking/" },
      { label: "So much more!", href: "/features/" },
    ],
    cta: { label: "Learn More", href: "/overview/" },
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <a href="/how-it-works/" class="hover:text-primary transition-colors">
        <h2 class="text-3xl sm:text-4xl font-bold text-dark">4 Steps to Get Paid.</h2>
      </a>
      <p class="mt-3 text-lg text-gray-500">Yes, it's really that easy!</p>
    </div>

    <!-- Steps Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step) => (
        <div class="relative group">
          <!-- Step Number Badge -->
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-primary text-white font-bold text-sm shrink-0">
              {step.number}
            </div>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Step</span>
          </div>

          <h3 class="text-xl font-bold text-dark mb-4">{step.title}</h3>

          <ul class="space-y-2.5 mb-6">
            {step.items.map((item) => (
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item.href ? (
                  <a href={item.href} class="text-sm text-gray-600 hover:text-primary transition-colors">{item.label}</a>
                ) : (
                  <span class="text-sm text-gray-600">{item.label}</span>
                )}
              </li>
            ))}
          </ul>

          <a
            href={step.cta.href}
            class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-primary-dark transition-colors"
          >
            {step.cta.label}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <!-- Connector line (desktop only, not on last) -->
          {step.number < 4 && (
            <div class="hidden lg:block absolute top-5 -right-4 w-8 border-t-2 border-dashed border-gray-200"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
