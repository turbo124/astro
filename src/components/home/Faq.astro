---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const faqs = Array.from({ length: 14 }, (_, i) => ({
  question: t(locale, `faq.q${i + 1}`),
  answer: t(locale, `faq.a${i + 1}`),
}));
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark">{t(locale, 'faq.heading')}</h2>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-3" id="faq-list">
      {faqs.map((faq, index) => (
        <div class={`faq-item border border-gray-200 rounded-xl overflow-hidden ${index >= 5 ? 'faq-extra hidden' : ''}`}>
          <button
            class="faq-toggle w-full flex items-center justify-between px-6 py-5 text-left hover:bg-gray-50 transition-colors"
            aria-expanded="false"
          >
            <span class="text-base font-semibold text-dark pr-4">{faq.question}</span>
            <svg class="faq-arrow w-5 h-5 text-gray-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <div class="text-sm text-gray-600 leading-relaxed space-y-3" set:html={faq.answer} />
          </div>
        </div>
      ))}
    </div>

    <!-- Show More Button -->
    <div class="text-center mt-8" id="faq-show-more-wrap">
      <button
        id="faq-show-more"
        class="px-6 py-3 text-sm font-semibold text-primary border border-primary/30 rounded-lg hover:bg-primary/5 transition-colors"
      >
        {t(locale, 'faq.showMore')}
      </button>
    </div>
  </div>
</section>

<script>
  // FAQ accordion toggle
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const arrow = btn.querySelector('.faq-arrow');
      const isOpen = content?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      arrow?.classList.toggle('rotate-180', isOpen);
    });
  });

  // Show more FAQs
  const showMoreBtn = document.getElementById('faq-show-more');
  const showMoreWrap = document.getElementById('faq-show-more-wrap');

  showMoreBtn?.addEventListener('click', () => {
    document.querySelectorAll('.faq-extra').forEach((el) => {
      el.classList.remove('hidden');
    });
    showMoreWrap?.classList.add('hidden');
  });
</script>
