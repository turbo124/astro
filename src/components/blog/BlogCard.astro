---
interface Props {
  title: string;
  description: string;
  slug: string;
  publishDate: Date;
  image?: string;
  category?: string;
  locale?: string;
}

const {
  title,
  description,
  slug,
  publishDate,
  image,
  category,
  locale = 'en',
} = Astro.props;

const formattedDate = publishDate.toLocaleDateString(locale === 'be' ? 'nl-BE' : locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group flex flex-col h-full">
  <a href={`/blog/${slug}/`} class="block flex-1">
    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full aspect-video object-cover rounded-xl mb-4 group-hover:shadow-lg transition-shadow duration-200"
      />
    ) : (
      <div class="w-full aspect-video bg-gradient-to-br from-primary/5 via-primary/10 to-blue-50 rounded-xl mb-4 flex items-center justify-center group-hover:shadow-lg transition-shadow duration-200">
        <svg class="w-10 h-10 text-primary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
    )}

    <div class="space-y-2">
      <div class="flex items-center gap-3 text-xs text-gray-500">
        {category && (
          <span class="px-2.5 py-0.5 bg-primary/8 text-primary rounded-full font-medium capitalize">
            {category}
          </span>
        )}
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
      </div>

      <h3 class="text-lg font-bold text-dark group-hover:text-primary transition-colors duration-200 line-clamp-2 leading-snug">
        {title}
      </h3>

      <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed">{description}</p>
    </div>
  </a>
</article>
