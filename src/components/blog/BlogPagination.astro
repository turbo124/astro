---
interface Props {
  currentPage: number;
  totalPages: number;
  baseURL?: string;
  prevLabel?: string;
  nextLabel?: string;
}

const {
  currentPage,
  totalPages,
  baseURL = '/blog',
  prevLabel = 'Previous',
  nextLabel = 'Next',
} = Astro.props;

const prevURL = currentPage > 1
  ? currentPage === 2 ? `${baseURL}/` : `${baseURL}/${currentPage - 1}/`
  : null;

const nextURL = currentPage < totalPages
  ? `${baseURL}/${currentPage + 1}/`
  : null;
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-4 mt-12 pt-8 border-t border-gray-200" aria-label="Pagination">
    {prevURL ? (
      <a href={prevURL} class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-primary hover:text-primary transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {prevLabel}
      </a>
    ) : (
      <span class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-300 border border-gray-200 rounded-lg cursor-not-allowed">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {prevLabel}
      </span>
    )}

    <span class="text-sm text-gray-500">
      Page {currentPage} of {totalPages}
    </span>

    {nextURL ? (
      <a href={nextURL} class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:border-primary hover:text-primary transition-colors">
        {nextLabel}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <span class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-300 border border-gray-200 rounded-lg cursor-not-allowed">
        {nextLabel}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    )}
  </nav>
)}
