---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Invoice Templates" description="Professional invoice templates and customizable designs. 4 free templates, 11 with Pro plan." path="/invoice-templates/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Invoice Templates</h1>
        <p class="text-xl text-gray-600">Beautifully designed, fully customizable invoice templates.</p>
      </div>

      <div class="mb-16">
        <h2 class="text-2xl font-bold text-dark mb-6">Free Plan — 4 Designs</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
          {[
            { name: "Bold", img: "/images/templates/V5-BOLDNESS-page-001-1.jpg" },
            { name: "Creative", img: "/images/templates/Invoice_0525-CREATIVE-page-001-1.jpg" },
            { name: "Business", img: "/images/templates/v5-BUSINESS-page-001-1.jpg" },
            { name: "Hipster", img: "/images/templates/Invoice_0523-HIPSTER-page-001-1.jpg" },
          ].map((t) => (
            <div class="p-4 rounded-xl border border-gray-200 text-center">
              <img src={t.img} alt={`${t.name} invoice template`} class="w-full rounded-lg mb-3" loading="lazy" />
              <p class="text-sm font-medium text-gray-700">{t.name}</p>
            </div>
          ))}
        </div>

        <h2 class="text-2xl font-bold text-dark mb-6">Pro & Enterprise — 11 Designs</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
          {[
            { name: "Elegant", img: "/images/templates/Invoice_0522-ELEGANT-page-001-1.jpg" },
            { name: "Tech", img: "/images/templates/Invoice_0519-TECH-page-001-1.jpg" },
            { name: "Playful", img: "/images/templates/Invoice_0520-PLAYFUL-page-001-1.jpg" },
            { name: "Modern", img: "/images/templates/Invoice_0527-MODERN-page-001.jpg" },
            { name: "Plain", img: "/images/templates/Invoice_0526-PLAIN-page-001.jpg" },
            { name: "Clean", img: "/images/templates/v5-CLEAN-page-001.jpg" },
            { name: "Business (New)", img: "/images/templates/Invoice-09136-C-Business-new-page-001-scaled.jpg" },
            { name: "Playful (New)", img: "/images/templates/Invoice-B-0191-Playful-page-001-scaled.jpg" },
            { name: "Tech (New)", img: "/images/templates/Tech-Invoice_03982022-page-001.jpg" },
            { name: "Hipster (New)", img: "/images/templates/Invoice-208027-Hipster-New-page-001-scaled.jpg" },
            { name: "Elegant (New)", img: "/images/templates/Invoice-20802-Elegant-New-page-001-scaled.jpg" },
          ].map((t) => (
            <div class="p-4 rounded-xl border border-primary/20 bg-primary/5 text-center">
              <img src={t.img} alt={`${t.name} invoice template`} class="w-full rounded-lg mb-3" loading="lazy" />
              <p class="text-sm font-medium text-gray-700">{t.name}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="prose prose-lg max-w-none mb-12">
        <h2>Industry Templates</h2>
        <p>Specialized templates for: Graphic Design, Programming, Coaching, Consulting, Web Design, Video Production, SEO, Photography, Auto Repair, Law Firms, Non-Profits, Digital Marketing, Manufacturing, IT Services, and more.</p>

        <h2>Customization</h2>
        <ul>
          <li>Upload your company logo</li>
          <li>Custom invoice number sequences</li>
          <li>Personalized email subject lines and body text</li>
          <li>Invoice approval checkboxes or e-signature</li>
          <li>Attach PDF files to emails</li>
          <li>Custom reminder email schedules</li>
        </ul>
      </div>

      <div class="text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
