---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const freeTemplates = [
  { name: "Bold", img: "/images/templates/V5-BOLDNESS-page-001-1.jpg" },
  { name: "Creative", img: "/images/templates/Invoice_0525-CREATIVE-page-001-1.jpg" },
  { name: "Business", img: "/images/templates/v5-BUSINESS-page-001-1.jpg" },
  { name: "Hipster", img: "/images/templates/Invoice_0523-HIPSTER-page-001-1.jpg" },
];

const proTemplates = [
  { name: "Elegant", img: "/images/templates/Invoice_0522-ELEGANT-page-001-1.jpg" },
  { name: "Tech", img: "/images/templates/Invoice_0519-TECH-page-001-1.jpg" },
  { name: "Playful", img: "/images/templates/Invoice_0520-PLAYFUL-page-001-1.jpg" },
  { name: "Modern", img: "/images/templates/Invoice_0527-MODERN-page-001.jpg" },
  { name: "Plain", img: "/images/templates/Invoice_0526-PLAIN-page-001.jpg" },
  { name: "Clean", img: "/images/templates/v5-CLEAN-page-001.jpg" },
  { name: "Business (New)", img: "/images/templates/Invoice-09136-C-Business-new-page-001-scaled.jpg" },
  { name: "Playful (New)", img: "/images/templates/Invoice-B-0191-Playful-page-001-scaled.jpg" },
  { name: "Tech (New)", img: "/images/templates/Tech-Invoice_03982022-page-001.jpg" },
  { name: "Hipster (New)", img: "/images/templates/Invoice-208027-Hipster-New-page-001-scaled.jpg" },
  { name: "Elegant (New)", img: "/images/templates/Invoice-20802-Elegant-New-page-001-scaled.jpg" },
];

const faqs = [
  {
    question: "What are the benefits of using invoice templates?",
    answer: "Businesses need their invoices to be clear, legally valid, set on time and professional &mdash; a hastily typed Word document or email simply doesn't give the right impression and can easily be mistaken for spam. Invoice templates provide a done-for-you format. All you need to do is upload your logo and company details and enter the relevant billing to have a professional invoice. It's quick, simple, and free! Our templates are ready to go, with options to link to your preferred payment method, ensuring you don't skip past anything important such as sales tax, payment due dates, or your contact details.",
  },
  {
    question: "Which invoice template formats should I use?",
    answer: "The choice of invoice template is yours &mdash; browse through our professional templates and pick a style that feels right for your business! Our free plan includes four invoice templates to choose from, or you can go Pro and unlock access to a library of eleven invoice formats. When you first create your Invoice Ninja account, we'll give you a nudge to upload your business logo to invoices, so every invoice you produce is tailored to you.",
  },
  {
    question: "How do I make an invoice for my small business?",
    answer: "It's simple, and you don't need bookkeeping or accounting expertise! Create an Invoice Ninja account, enter your details, and upload your logo. Pick the template you like best, type in the relevant info: customer name, address, and any other relevant invoicing details. Shoot your invoice over to your client directly and integrate your payments solution &mdash; such as a Pay Now button linked to your Stripe, PayPal or WePay account &mdash; and you can tick your invoicing off the list.",
  },
  {
    question: "Which are the best invoice templates?",
    answer: "We set out to make business invoicing stress-free and seamless, combining advanced software features and security with transparent pricing, amazing service, and all the tools you need. Our pricing plans are varied and scalable, starting with a zero-cost option for up to 5 clients, unlimited invoicing, four templates, branded documents, and auto-billing functionality. As your business grows, we're right here with you, offering Pro and Enterprise solutions.",
  },
  {
    question: "How do I start invoicing online?",
    answer: "1. Create a FREE Invoice Ninja account. 2. Upload your logo &amp; choose an invoice design. 3. Integrate your payment gateway (Stripe, PayPal, etc.). 4. Create clients, invoices, and get paid!",
  },
  {
    question: "How do my clients pay their invoices online?",
    answer: "After integrating a payment gateway with your Invoice Ninja account, your clients will see a 'Pay Now' button on their invoices. The payment gateway processes your client's payment within their Invoice Ninja client-portal, then deposits the money into your business bank account. Invoice Ninja supports dozens of payment gateways.",
  },
  {
    question: "How do I upload my company logo on invoices?",
    answer: "Navigate to Settings > Company Details, and click 'Logo' to upload or change your logo. This is available to all invoice plans, including the free plan!",
  },
  {
    question: "How do I customize my invoice template design?",
    answer: "Free Invoice Ninja accounts include 4 free invoice template designs, Pro &amp; Enterprise plans include 11 invoice template designs! All plans allow you to upload your company logo/branding to invoice clients with a professionally branded invoice design. The Pro &amp; Enterprise plans also allow advanced customization of invoice designs.",
  },
];
---

<BaseLayout title="Free Invoice Templates: Find the Perfect Invoice Template" description="Professional invoice templates and customizable designs. 4 free templates, 11 with Pro & Enterprise plan. 100% customizable!" path="/invoice-templates/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-3">Product &mdash; Free Invoice Templates</p>
          <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-6">Find the Perfect Invoice Template for Your Needs</h1>
          <p class="text-lg text-gray-600 mb-4">Professional invoicing is critical to getting paid on time.</p>
          <p class="text-gray-600 mb-6">Creating professional invoices is easier than ever. Free accounts include 4 free invoice template designs, Pro & Enterprise plans include 11 invoice template designs, each invoice is 100% customizable!</p>
          <p class="text-gray-700 font-medium mb-8">Access beautiful customizable invoice templates & grow your business with Invoice Ninja!</p>
          <div class="flex flex-wrap gap-4">
            <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
            <Button href="https://react.invoicing.co/demo" variant="outline" size="lg">Try Demo</Button>
          </div>
        </div>
        <div>
          <img src="/images/templates/invoice-template.png" alt="Invoice Ninja invoice templates" class="w-full rounded-xl shadow-lg" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Great Invoice Designs = Great Business -->
  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <img src="/images/templates/the-best-way-to-invoice.png" alt="The best way to invoice" class="w-full rounded-xl shadow-lg" loading="lazy" />
        </div>
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-6">Great Invoice Designs = Great Business</h2>
          <p class="text-gray-600 mb-4">As a business owner you're busy with sales, invoicing, marketing, customer service, and doing everything you can to grow your business! You need an invoice generator that's easy and gets you paid!</p>
          <p class="text-gray-600">Impress clients with beautiful invoices they can view & pay online or download as an invoice PDF.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Template Gallery -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Invoice & Quotation Templates</h2>
        <p class="text-xl text-gray-600">Beautiful & Professional Template Designs</p>
      </div>

      <!-- Free Templates -->
      <div class="mb-16">
        <h3 class="text-2xl font-bold text-dark mb-2">Free Plan &mdash; 4 Designs</h3>
        <p class="text-gray-500 mb-6">Included with every free account</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {freeTemplates.map((t) => (
            <div class="group bg-white p-4 rounded-xl border border-gray-200 hover:border-primary hover:shadow-lg transition-all duration-200 text-center">
              <div class="overflow-hidden rounded-lg mb-3">
                <img src={t.img} alt={`${t.name} invoice template`} class="w-full rounded-lg group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <p class="text-sm font-semibold text-gray-700">{t.name} Invoice</p>
              <span class="inline-block mt-1 text-xs font-medium text-green-700 bg-green-100 px-2 py-0.5 rounded-full">Free</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Pro & Enterprise Templates -->
      <div>
        <h3 class="text-2xl font-bold text-dark mb-2">Pro & Enterprise &mdash; 11 Designs</h3>
        <p class="text-gray-500 mb-6">Unlock all templates with Pro or Enterprise plans</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {proTemplates.map((t) => (
            <div class="group bg-white p-4 rounded-xl border border-primary/20 bg-primary/5 hover:border-primary hover:shadow-lg transition-all duration-200 text-center">
              <div class="overflow-hidden rounded-lg mb-3">
                <img src={t.img} alt={`${t.name} invoice template`} class="w-full rounded-lg group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <p class="text-sm font-semibold text-gray-700">{t.name} Invoice</p>
              <span class="inline-block mt-1 text-xs font-medium text-primary bg-primary/10 px-2 py-0.5 rounded-full">Pro / Enterprise</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Professional invoices, for every industry -->
  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-6">Professional invoices, for every industry</h2>
          <p class="text-gray-600 mb-6">We have beautiful invoice templates for entrepreneurs and freelancers, who need accurate invoices that reflect their business.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
            {[
              "Graphic Design Template",
              "Programmer Invoice Template",
              "Executive Coaching Invoicing",
              "Business Consultant Invoicing",
              "Web Design Invoice Template",
              "Video Production Template",
              "SEO Agency Invoice Template",
              "Photographer Invoice Template",
              "Auto Repair Invoicing Template",
              "Law Firm Invoice Template",
              "Non-Profit Invoice Template",
              "Gig Economy Invoice Template",
              "Digital Marketing Firm Invoicing",
              "Manufacturer Invoice Template",
              "IT Services Invoice Template",
              "Travel & Tourism Invoicing",
              "Logistics Company Invoice Template",
              "Landscaping & Lawncare Invoicing",
            ].map((industry) => (
              <div class="flex items-center gap-2 py-1">
                <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-gray-700">{industry}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <img src="/images/templates/by-industry.png" alt="Invoice templates for every industry" class="w-full rounded-xl shadow-lg" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Upgrade Your Invoicing -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Upgrade Your Invoicing!</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">Invoice Ninja offers beautiful professional invoicing templates for free. The Pro & Enterprise plans provide unlimited clients & unlimited invoicing! Get paid faster with Invoice Ninja.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Standard Invoice -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-dark">Standard Invoice</h3>
          </div>
          <p class="text-gray-600">A standard invoice that you create online & email out, your client pays in 1 click.</p>
        </div>

        <!-- Recurring Invoicing -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-dark">Recurring Invoicing</h3>
          </div>
          <p class="text-gray-600">This invoice acts as an 'umbrella' creating additional invoices that are generated & emailed out by time parameters you define (weekly, monthly, annually, etc.).</p>
        </div>

        <!-- Deposit / Partial Payment -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-dark">Deposit / Partial Payment Invoice</h3>
          </div>
          <p class="text-gray-600">A standard invoice with a partial payment/deposit amount defined. You can set separate due dates for the deposit, the final balance, and enable automated invoice reminder emails!</p>
        </div>

        <!-- Time-Based Task/Project -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-dark">Time-Based Task / Project Invoice</h3>
          </div>
          <p class="text-gray-600">Create projects & tasks, and when you are finished you can send the tasks to invoice with 1-click! An invoice can have both regular products/services and completed tasks together on one invoice!</p>
        </div>
      </div>

      <div class="text-center mt-10">
        <p class="text-gray-600 mb-2">Find out why small businesses around the world trust Invoice Ninja as their invoicing solution.</p>
        <p class="text-gray-700 font-medium">You can focus on doing what you love, we'll help with the invoicing.</p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-12 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-lg font-semibold text-dark hover:bg-gray-50 transition-colors">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200 flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
              <p set:html={faq.answer} />
            </div>
          </details>
        ))}
      </div>
      <div class="text-center mt-10">
        <p class="text-gray-600 mb-1">Find out why small businesses around the world trust Invoice Ninja.</p>
        <p class="text-gray-700 font-medium">You can focus on doing what you love, we'll help with the invoicing.</p>
      </div>
    </div>
  </section>

  <!-- Let's Connect -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Get the support you need</h2>
      <p class="text-lg text-gray-600 text-center mb-12">Let's Connect</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Forums -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 text-center hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Ninja Support Forums</h3>
          <p class="text-gray-600 mb-5">Connect with thousands of Invoice Ninja users on our community forums.</p>
          <a href="https://forum.invoiceninja.com" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors" target="_blank" rel="noopener noreferrer">Launch Forums! &rarr;</a>
        </div>

        <!-- Email -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 text-center hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Contact Email</h3>
          <p class="text-gray-600 mb-5">We want to hear from you! Questions? We're here to help!</p>
          <a href="mailto:contact@invoiceninja.com" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Contact@invoiceninja.com &rarr;</a>
        </div>

        <!-- Slack -->
        <div class="bg-white p-8 rounded-xl border border-gray-200 text-center hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Slack Community</h3>
          <p class="text-gray-600 mb-5">Join over 5,000 Invoice Ninja members on our community Slack channel!</p>
          <a href="https://invoiceninja.slack.com" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors" target="_blank" rel="noopener noreferrer">Join Slack &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center bg-primary rounded-xl py-12 px-6">
        <h2 class="text-3xl font-bold text-white mb-2">Start Invoicing Today!</h2>
        <p class="text-lg text-white/90 mb-6">Invoice Clients, Get Paid Fast!</p>
        <Button href="https://app.invoicing.co/#/register" size="lg">Test Drive!</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
