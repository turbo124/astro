---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout title="Zeiterfassung und Projekte" description="Projekte erstellen und Arbeitszeiten erfassen." locale="de">
  <Header slot="header" locale="de" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Zeiterfassung und Projekte</h1>
        <p class="text-xl text-gray-600">Projekte erstellen und Arbeitszeiten erfassen.</p>
      </div>
      <div class="text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Kostenlos starten</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
