---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
---

<BaseLayout title="Online Payments" description="Accept credit cards, ACH, PayPal and more. No platform fees — Invoice Ninja never takes a cut." path="/payments/">
  <Header slot="header" />

  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-6">Accept Payments Online</h1>
      <p class="text-xl text-gray-600 mb-4">Integrate payment gateways directly into your invoices. Clients pay with a single click.</p>
      <p class="text-lg font-medium text-primary">Invoice Ninja does not charge or take any fee or % whatsoever!</p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-dark mb-8 text-center">Recommended Gateways</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <Card padding="lg">
          <h3 class="text-xl font-bold text-dark mb-2">Stripe Connect</h3>
          <p class="text-sm text-gray-600 mb-4">135+ currencies with dozens of payment methods. Rapid market expansion.</p>
          <a href="/payment-gateway/stripe/" class="text-sm text-primary hover:underline">Learn more &rarr;</a>
        </Card>
        <Card padding="lg">
          <h3 class="text-xl font-bold text-dark mb-2">PayPal & Venmo</h3>
          <p class="text-sm text-gray-600 mb-4">300+ million PayPal customers globally. Flexible purchasing options.</p>
          <a href="/payment-gateway/paypal/" class="text-sm text-primary hover:underline">Learn more &rarr;</a>
        </Card>
        <Card padding="lg">
          <h3 class="text-xl font-bold text-dark mb-2">GoCardless</h3>
          <p class="text-sm text-gray-600 mb-4">85,000+ businesses. Instant one-off payments and automated recurring billing.</p>
          <a href="/payment-gateway/gocardless/" class="text-sm text-primary hover:underline">Learn more &rarr;</a>
        </Card>
      </div>

      <h2 class="text-2xl font-bold text-dark mb-8 text-center">All Payment Gateways</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        {[
          { name: "BTCPay", img: "/images/gateways-logos/BTCPay.png", href: "/payment-gateway/btcpay/" },
          { name: "Braintree", img: "/images/gateways-logos/BRAINTREE.png", href: "/payment-gateway/braintree/" },
          { name: "Payfast", img: "/images/gateways-logos/Payfast-By-Network_dark-1024x541.png", href: "/payment-gateway/payfast/" },
          { name: "Mollie", img: "/images/gateways-logos/MollieLogo23-Black-1024x302.png", href: "/payment-gateway/mollie/" },
          { name: "Square", img: "/images/gateways-logos/SQUARE-1024x576.jpg", href: "/payment-gateway/square/" },
          { name: "CSG Forte", img: "/images/gateways-logos/MicrosoftTeams-image-4.png", href: "/payment-gateway/csg-forte/" },
          { name: "PayTrace", img: "/images/gateways-logos/paytrace.png", href: "/payment-gateway/paytrace/" },
          { name: "eWAY", img: "/images/gateways-logos/EWAY-1024x298.png", href: "/payment-gateway/eway/" },
          { name: "Alipay", img: "/images/gateways-logos/ALIPAY.jpg", href: "/payment-gateway/alipay-com/" },
          { name: "Apple Pay", img: "/images/gateways-logos/APPLE-AY.png", href: "/payment-gateway/apple-pay/" },
          { name: "Razorpay", img: "/images/gateways-logos/Razorpay-1024x1024.png", href: "/payment-gateway/razorpay/" },
          { name: "Authorize.net", img: "/images/gateways-logos/AUTHORIZE-1024x235.png", href: "/payment-gateway/authorize-net/" },
          { name: "Checkout.com", img: "/images/gateways-logos/CHECKOUT-1-1024x538.png", href: "/payment-gateway/checkout-com/" },
        ].map((gw) => (
          <a href={gw.href} class="p-4 rounded-lg border border-gray-200 hover:border-primary/30 hover:shadow-md transition-all flex flex-col items-center justify-center gap-2">
            <img src={gw.img} alt={gw.name} class="h-10 object-contain" loading="lazy" />
            <span class="text-xs text-gray-500">{gw.name}</span>
          </a>
        ))}
      </div>

      <div class="bg-gray-50 rounded-2xl p-8 space-y-4">
        <h3 class="text-lg font-bold text-dark">How It Works</h3>
        <ul class="space-y-2 text-gray-600">
          <li class="flex items-start gap-2"><span class="text-primary font-bold">1.</span> OAuth-based gateways offer automatic integration; others require API credentials.</li>
          <li class="flex items-start gap-2"><span class="text-primary font-bold">2.</span> Most gateways charge ~2.9% for credit cards; ACH transfers cost substantially less.</li>
          <li class="flex items-start gap-2"><span class="text-primary font-bold">3.</span> Initial deposits within 1-2 weeks; subsequent deposits in 2-3 days.</li>
        </ul>
      </div>

      <div class="mt-12 text-center">
        <Button href="/payment-gateway/" size="lg">View All Gateways</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
