---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const gateways = [
  {
    name: "Stripe Connect",
    img: "/images/gateways-logos/STRIPE-1024x488.png",
    href: "/payment-gateway/stripe/",
    description: "With Stripe you can create an account online in minutes to securely accept payments. With 135+ currencies and dozens of payment methods, Stripe enables rapid market expansion.",
    recommended: true,
  },
  {
    name: "PayPal & Venmo",
    img: "/images/gateways-logos/PAYPAL.png",
    href: "/payment-gateway/paypal/",
    description: "PayPal connects you with more than 300 million PayPal customers around the world, all while giving your customers the freedom to buy with flexible purchasing options.",
    recommended: true,
  },
  {
    name: "GoCardless",
    img: "/images/gateways-logos/GoCardless-Symbol-Negative-RGB-500px-1024x1024.png",
    href: "/payment-gateway/gocardless/",
    description: "85,000+ businesses around the world use GoCardless to power their payments collection! Easy for your customers to make instant, one-off payments and automated recurring billing.",
    recommended: true,
  },
  {
    name: "BTCPay",
    img: "/images/gateways-logos/BTCPay.png",
    href: "/payment-gateway/btcpay/",
    description: "Accept Bitcoin and cryptocurrency payments with BTCPay Server. Self-hosted, open-source, and fully decentralized payment processing.",
    recommended: false,
  },
  {
    name: "Braintree",
    img: "/images/gateways-logos/BRAINTREE.png",
    href: "/payment-gateway/braintree/",
    description: "A PayPal service offering a full-stack payment platform. Accept credit cards, debit cards, and digital wallets with one integration.",
    recommended: false,
  },
  {
    name: "Payfast",
    img: "/images/gateways-logos/Payfast-By-Network_dark-1024x541.png",
    href: "/payment-gateway/payfast/",
    description: "South Africa's leading payment gateway. Accept payments via credit card, instant EFT, debit orders, and more across Southern Africa.",
    recommended: false,
  },
  {
    name: "Mollie",
    img: "/images/gateways-logos/MollieLogo23-Black-1024x302.png",
    href: "/payment-gateway/mollie/",
    description: "European payment gateway supporting iDEAL, credit cards, SEPA, Bancontact, and many more local payment methods across Europe.",
    recommended: false,
  },
  {
    name: "Square",
    img: "/images/gateways-logos/SQUARE-1024x576.jpg",
    href: "/payment-gateway/square/",
    description: "Accept payments online and in-person with Square. Transparent pricing with no hidden fees and fast deposits to your bank account.",
    recommended: false,
  },
  {
    name: "CSG Forte",
    img: "/images/gateways-logos/MicrosoftTeams-image-4.png",
    href: "/payment-gateway/csg-forte/",
    description: "Enterprise-grade payment processing with CSG Forte. Accept ACH, credit cards, and electronic payments with robust reporting tools.",
    recommended: false,
  },
  {
    name: "PayTrace",
    img: "/images/gateways-logos/paytrace.png",
    href: "/payment-gateway/paytrace/",
    description: "B2B payment processing with Level 2 and Level 3 data support. Lower interchange rates for business-to-business transactions.",
    recommended: false,
  },
  {
    name: "eWAY",
    img: "/images/gateways-logos/EWAY-1024x298.png",
    href: "/payment-gateway/eway/",
    description: "Australia's leading payment gateway. Accept Visa, Mastercard, and AMEX with fast settlement and advanced fraud protection.",
    recommended: false,
  },
  {
    name: "Alipay",
    img: "/images/gateways-logos/ALIPAY.jpg",
    href: "/payment-gateway/alipay-com/",
    description: "Reach over 1 billion users with Alipay, the world's largest mobile payment platform. Expand into the Chinese market seamlessly.",
    recommended: false,
  },
  {
    name: "Apple Pay",
    img: "/images/gateways-logos/APPLE-AY.png",
    href: "/payment-gateway/apple-pay/",
    description: "Let your customers pay quickly and securely with Apple Pay. One-tap checkout for a fast, frictionless payment experience.",
    recommended: false,
  },
  {
    name: "Razorpay",
    img: "/images/gateways-logos/Razorpay-1024x1024.png",
    href: "/payment-gateway/razorpay/",
    description: "India's leading payment gateway. Accept payments via UPI, credit cards, debit cards, net banking, and popular Indian wallets.",
    recommended: false,
  },
  {
    name: "Authorize.net",
    img: "/images/gateways-logos/AUTHORIZE-1024x235.png",
    href: "/payment-gateway/authorize-net/",
    description: "One of the most widely used payment gateways in the US. Reliable, secure payment processing trusted by hundreds of thousands of merchants.",
    recommended: false,
  },
  {
    name: "Checkout.com",
    img: "/images/gateways-logos/CHECKOUT-1-1024x538.png",
    href: "/payment-gateway/checkout-com/",
    description: "Global payment processing built for performance. Accept payments in 150+ currencies with intelligent routing and optimization.",
    recommended: false,
  },
];

const faqs = [
  {
    question: "What is a Payment Gateway?",
    answer: "Payment gateways allow merchants to accept credit card payments online. Simply put, gateways are a payment service that process your clients' credit cards and transfer the funds from the client's bank account to yours. Invoice Ninja integrates with leading payment gateways so your clients can pay invoices online with a single click.",
  },
  {
    question: "Does Invoice Ninja Charge for Online Payments?",
    answer: "No! Invoice Ninja does not charge or take any fee or % whatsoever! The only fees you pay are to the payment gateway provider directly. We believe in transparent pricing, and we never take a cut of your hard-earned revenue.",
  },
  {
    question: "How do I Integrate a Payment Gateway with Invoice Ninja?",
    answer: "Some gateways like Stripe offer oAuth-based integration, which means you can connect your account with just a few clicks — no API keys needed. For other gateways, you simply enter your API credentials in Settings > Payment Settings. Our documentation provides step-by-step guides for each gateway.",
  },
  {
    question: "What Does it Cost to Accept Payments Online?",
    answer: "Most payment gateways charge approximately 2.9% +/- for credit card transactions, but ACH/bank transfers are much less expensive (or even free with some providers). Each gateway has its own pricing structure, so we recommend comparing options to find the best fit for your business.",
  },
  {
    question: "How Fast will my Client's Payment be Deposited to my Bank?",
    answer: "For most payment gateways, you will need to initially wait 1-2 weeks for your first deposit(s) while the gateway verifies your account. After that initial period, subsequent deposits typically arrive in 2-3 business days. Some gateways offer instant or next-day deposits for an additional fee.",
  },
];
---

<BaseLayout title="Payment Gateway Integrations" description="Accept credit cards, ACH, PayPal and more. Integrate payment gateways with Invoice Ninja. No platform fees — we never take a cut." path="/payments/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-3">Payment Gateway Integrations</h1>
      <p class="text-2xl lg:text-3xl font-semibold text-primary mb-6">Get Paid Online</p>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Integrating your Invoice Ninja account with a payment gateway allows clients to pay their invoices with 1-click! Invoice Ninja does not charge or take any fee or % whatsoever.</p>
    </div>
  </section>

  <!-- Gateway Card Grid -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {gateways.map((gw) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 hover:border-primary/30 hover:shadow-lg transition-all duration-200 flex flex-col">
            <div class="flex items-center gap-4 mb-4">
              <img src={gw.img} alt={gw.name} class="h-12 w-auto max-w-[120px] object-contain" loading="lazy" />
              <div>
                <h3 class="text-lg font-bold text-dark">{gw.name}</h3>
                {gw.recommended && (
                  <span class="text-xs font-semibold text-green-600 bg-green-50 px-2 py-0.5 rounded-full">*Recommended!</span>
                )}
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-4 flex-grow">{gw.description}</p>
            <a href={gw.href} class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Let's Connect -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-12 text-center">Let's Connect</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Forums -->
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center hover:shadow-lg transition-all duration-200">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Ninja Support Forums</h3>
          <p class="text-sm text-gray-600 mb-6">Connect with thousands of Invoice Ninja users on our community forums.</p>
          <a href="https://forum.invoiceninja.com/" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-lg text-white bg-primary hover:bg-primary-dark transition-colors">Launch Forums!</a>
        </div>

        <!-- Email -->
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center hover:shadow-lg transition-all duration-200">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Contact Email</h3>
          <p class="text-sm text-gray-600 mb-6">We want to hear from you! Questions? We're here to help!</p>
          <a href="mailto:contact@invoiceninja.com" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-lg text-white bg-primary hover:bg-primary-dark transition-colors">contact@invoiceninja.com</a>
        </div>

        <!-- Slack -->
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center hover:shadow-lg transition-all duration-200">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Slack Community</h3>
          <p class="text-sm text-gray-600 mb-6">Join over 5,000 Invoice Ninja members on our community Slack channel!</p>
          <a href="https://slack.invoiceninja.com/" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-lg text-white bg-primary hover:bg-primary-dark transition-colors">Join Slack</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-12 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details class="group rounded-xl border border-gray-200 bg-white overflow-hidden" open={index === 0}>
            <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-lg font-semibold text-dark hover:bg-gray-50 transition-colors list-none [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-gray-600 leading-relaxed">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center bg-primary rounded-xl py-12 px-6">
        <h2 class="text-3xl font-bold text-white mb-2">Start Invoicing Today!</h2>
        <p class="text-lg text-white/90 mb-6">Create. Send. Get Paid.</p>
        <Button href="https://app.invoicing.co/#/register" size="lg">Test Drive!</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
