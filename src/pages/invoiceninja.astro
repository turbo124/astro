  <Footer slot="footer" />
</BaseLayout>

<script>
  // FAQ accordion toggle
  document.querySelectorAll('.ninja-faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const arrow = btn.querySelector('.ninja-faq-arrow');
      const isOpen = content?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      arrow?.classList.toggle('rotate-180', isOpen);
    });
  });

  // Show more FAQs
  const ninjaShowMoreBtn = document.getElementById('ninja-faq-show-more');
  const ninjaShowMoreWrap = document.getElementById('ninja-faq-show-more-wrap');

  ninjaShowMoreBtn?.addEventListener('click', () => {
    document.querySelectorAll('.ninja-faq-extra').forEach((el) => {
      el.classList.remove('hidden');
    });
    ninjaShowMoreWrap?.classList.add('hidden');
  });
</script>
