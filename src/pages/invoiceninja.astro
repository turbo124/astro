---

<BaseLayout title="Invoice Ninja - Free Invoicing Software" description="Free invoicing software for freelancers and small businesses. Create invoices, accept payments, track expenses, and manage projects." path="/invoiceninja/">
  <Header slot="header" />

  <!-- ==================== HERO SECTION ==================== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-white to-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-dark leading-tight tracking-tight">
          Focus On Doing What You Love!
        </h1>
        <ul class="mt-8 space-y-3 text-lg sm:text-xl text-gray-600">
          <li class="flex items-center justify-center gap-3">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Invoice Clients & Get Paid with 1-Click!
          </li>
          <li class="flex items-center justify-center gap-3">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Track Billable Tasks & Projects Like a Pro
          </li>
          <li class="flex items-center justify-center gap-3">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Robust Expense & Vendor Management
          </li>
          <li class="flex items-center justify-center gap-3">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            And Much More!
          </li>
        </ul>
        <div class="mt-10">
          <Button href="https://app.invoicing.co/#/register" size="lg">Get Started</Button>
        </div>
      </div>
      <div class="mt-16 max-w-5xl mx-auto">
        <img src="/images/home/Frame-37210.png" alt="Invoice Ninja Dashboard" class="w-full rounded-2xl shadow-2xl border border-gray-200" loading="lazy" />
      </div>
    </div>
    <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-t from-primary/5 to-transparent rounded-full blur-3xl pointer-events-none"></div>
  </section>

  <!-- ==================== #1 FREE INVOICING PLATFORM ==================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark mb-6">#1 Free Invoicing Platform For Small Businesses</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-8">
        As a freelancer, you wear many hats. You're a skilled professional offering premium services. But sometimes, managing invoices, payments, and cash flow can feel like trying to scale a skyscraper. What if you could turn that skyscraper into an easy sidewalk? Welcome to Invoice Ninja, your ultimate companion in professional invoicing and payment management. We're here to make your invoicing tasks as breezy and enjoyable as scrolling through your favorite social media feed over a cup of coffee.
      </p>
      <Button href="https://app.invoicing.co/#/register" size="lg">Get Started</Button>
    </div>
  </section>

  <!-- ==================== CORE FEATURES ==================== -->
  <section class="py-20 lg:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Feature 1: Accept Payments -->
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-dark mb-4">Unleash The Power Of Easy Invoicing</h2>
          <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Accept Payments Online</p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Create, send and manage invoices with ease. Say goodbye to navigating complex payment gateways. Connect with multiple platforms and receive payments with just 1 click.
          </p>
        </div>
        <img src="/images/home/Invoice-Ninja-v5-1.png" alt="Accept payments online with Invoice Ninja" class="w-full rounded-2xl shadow-lg" loading="lazy" />
      </div>

      <!-- Feature 2: Time Tracking -->
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <img src="/images/home/image-2-1.png" alt="Time tracking tasks and projects" class="w-full rounded-2xl shadow-lg md:order-first" loading="lazy" />
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-dark mb-4">Effortlessly Time-Track Tasks & Projects</h2>
          <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Tracking Billable Hours</p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Create and keep track of your tasks. When done, simply "Send to invoice" and all details will be sent ready for your clients to pay!
          </p>
        </div>
      </div>

      <!-- Feature 3: Vendors & Expenses -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-dark mb-4">Vendors & Expenses</h2>
          <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Inventory & Payables</p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Track inventory, categorize vendors, re-invoice expenses and manage your expenses, all under one roof. It's inventory management, supercharged.
          </p>
        </div>
        <img src="/images/home/image-1-1.png" alt="Vendor and expense management" class="w-full rounded-2xl shadow-lg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ==================== PAIN POINTS ==================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark mb-10">Are These Common Freelancing Hurdles Keeping You Up At Night?</h2>
      <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto text-left mb-10">
        <div class="flex items-start gap-3 p-4 bg-red-50 rounded-xl">
          <svg class="w-6 h-6 text-red-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span class="text-gray-700">Late payments disrupting your cash flow</span>
        </div>
        <div class="flex items-start gap-3 p-4 bg-red-50 rounded-xl">
          <svg class="w-6 h-6 text-red-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
