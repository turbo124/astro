---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Invoice Ninja" description="Free open-source invoicing for small businesses." path="/invoiceninja/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Invoice Ninja</h1>
        <p class="text-xl text-gray-600">Free open-source invoicing for small businesses.</p>
      </div>

      <div class="prose prose-lg max-w-none mx-auto text-center">
        <p class="text-2xl font-medium text-dark">The #1 Open Source Invoicing Platform</p>
        <p>200,000+ businesses trust Invoice Ninja to send invoices, accept payments, track expenses, and manage projects.</p>
        <div class="flex flex-wrap justify-center gap-8 my-12 not-prose">
          <div class="text-center"><p class="text-3xl font-bold text-primary">200K+</p><p class="text-sm text-gray-500">Users</p></div>
          <div class="text-center"><p class="text-3xl font-bold text-primary">$0</p><p class="text-sm text-gray-500">Forever Free</p></div>
          <div class="text-center"><p class="text-3xl font-bold text-primary">100%</p><p class="text-sm text-gray-500">Open Source</p></div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
