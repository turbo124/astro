  <!-- ==================== FINAL CTA ==================== -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-primary to-primary-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Free Invoicing Software for Small Business</h2>
      <p class="text-lg text-white/80 mb-4">Focus on doing what you love. We'll help with the invoicing :)</p>
      <p class="text-white/70 mb-8">Step into a stress-free financial future. Focus on your passion and let us take care of the rest. Start your free trial today with Invoice Ninja.</p>
      <Button href="https://app.invoicing.co/#/register" variant="secondary" size="lg" class="!bg-white !text-primary hover:!bg-gray-100">Create a Free Account!</Button>
    </div>
