---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const faqs = [
  {
    q: "What are the benefits of using invoice templates?",
    a: "Businesses require invoices to be clear, legally valid, timely, and professional. A hastily prepared Word document or email fails to create the right impression and can be mistaken for spam. Templates provide pre-formatted structures where you upload your logo and company details to generate professional invoices quickly and simply. Templates prevent common mistakes when creating invoices manually, ensuring important elements like sales tax, payment due dates, and contact information aren't overlooked.",
  },
  {
    q: "Which invoice template formats should I use?",
    a: "Template selection is flexible. The free plan includes four freelance invoice templates; upgrading to Pro unlocks eleven formats. All plans allow logo uploads so every invoice reflects your branding. Pro and Enterprise plans enable advanced customization of invoice designs.",
  },
  {
    q: "How do I make an invoice for my small business?",
    a: "The process involves three straightforward steps: create an account and upload your logo, select your preferred template and enter customer information, then send the invoice to clients. Payment integration is optional. Support resources include community Slack groups with 5,000+ members, online forums, and direct team assistance.",
  },
  {
    q: "Which are the best invoice templates?",
    a: "Invoice Ninja offers varied, scalable pricing starting with a free option supporting up to five clients with unlimited invoicing, four templates, branded documents, and auto-billing. Pro and Enterprise solutions scale with business growth, all supported by friendly customer service. Desktop and mobile apps enable remote invoicing management.",
  },
  {
    q: "How do I start invoicing online?",
    a: "Follow these four steps: create a free account, upload your logo and select an invoice design, integrate your preferred payment gateway, then create clients and invoices to get paid.",
  },
  {
    q: "How do my clients pay their invoices online?",
    a: "A payment gateway processes client payments. After integration, clients see a 'Pay Now' button on invoices within their client portal, and funds deposit into your business account. Invoice Ninja supports numerous payment gateways.",
  },
];

const connectCards = [
  { title: "Support Forums", desc: "Connect with thousands of Invoice Ninja users on our community forums.", cta: "Launch Forums!", href: "https://forum.invoiceninja.com" },
  { title: "Contact Email", desc: "We want to hear from you! Questions? We're here to help!", cta: "Email Us", href: "mailto:contact@invoiceninja.com" },
  { title: "Slack Community", desc: "Join over 5,000 Invoice Ninja members on our community Slack channel!", cta: "Join Slack", href: "https://invoiceninja.slack.com" },
];
---

<BaseLayout title="Automations" description="Integrate Invoice Ninja with hundreds of apps via Zapier, Make, n8n, Integrately, Pabbly and more." path="/automations/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Automations</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">Integrate Invoice Ninja with hundreds of apps via Zapier, Make, n8n, Integrately, Pabbly and more.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-12">
        <a href="/zapier/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">Zapier</h3>
          <p class="text-sm text-gray-500">5,000+ app integrations</p>
        </a>
        <a href="/make-integrations/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">Make</h3>
          <p class="text-sm text-gray-500">Visual automation builder</p>
        </a>
        <a href="/software/n8n/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">n8n</h3>
          <p class="text-sm text-gray-500">Open-source automation</p>
        </a>
        <a href="/software/integrately/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">Integrately</h3>
          <p class="text-sm text-gray-500">One-click automations</p>
        </a>
        <a href="/software/pabbly/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">Pabbly Connect</h3>
          <p class="text-sm text-gray-500">Affordable automation</p>
        </a>
        <a href="https://boost.space/integrations/invoiceninja/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">Boost.space</h3>
          <p class="text-sm text-gray-500">Centralize & sync your data</p>
        </a>
        <a href="https://pipedream.com/apps/invoice-ninja" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">Pipedream</h3>
          <p class="text-sm text-gray-500">2,000+ app workflows</p>
        </a>
        <a href="https://ottokit.com/integrations/invoice_ninja" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">OttoKit</h3>
          <p class="text-sm text-gray-500">890+ app integrations</p>
        </a>
        <a href="/software/" class="p-5 rounded-xl border border-gray-200 hover:border-primary/30 hover:shadow-lg transition-all bg-white">
          <h3 class="font-bold text-dark mb-1">View All</h3>
          <p class="text-sm text-gray-500">All integrations &rarr;</p>
        </a>
      </div>
      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-4">Frequently Asked Questions</h2>
      <p class="text-center text-gray-500 mb-10">Everything you need to know about Invoice Ninja automations.</p>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-semibold text-dark hover:bg-gray-50 transition-colors">
              {faq.q}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4">
              <p class="text-sm text-gray-600">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Community & Support -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-10">Let's Connect!</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {connectCards.map((card) => (
          <div class="bg-white rounded-xl p-6 border border-gray-200 text-center hover:border-primary/30 hover:shadow-lg transition-all">
            <h3 class="text-lg font-bold text-dark mb-2">{card.title}</h3>
            <p class="text-sm text-gray-500 mb-4">{card.desc}</p>
            <a href={card.href} class="inline-block px-5 py-2 text-sm font-semibold text-primary border border-primary rounded-lg hover:bg-primary hover:text-white transition-colors">
              {card.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
