---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout title="Applications" description="Téléchargez Invoice Ninja pour toutes les plateformes." locale="fr" path="/apps/">
  <Header slot="header" locale="fr" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Applications</h1>
        <p class="text-xl text-gray-600">Téléchargez Invoice Ninja pour toutes les plateformes.</p>
      </div>
      <div class="text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">
          Commencer gratuitement
        </Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
