---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/home/Hero.astro";
import Steps from "../../components/home/Steps.astro";
import FeatureTabs from "../../components/home/FeatureTabs.astro";
import WhosItFor from "../../components/home/WhosItFor.astro";
import Testimonials from "../../components/home/Testimonials.astro";
import CtaBanner from "../../components/home/CtaBanner.astro";
import Faq from "../../components/home/Faq.astro";
---

