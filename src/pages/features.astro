---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const freeFeatures = [
  {
    title: "Create & Email Invoices & Quotes in Real-Time",
    description: "Real-time PDF preview creation shows your invoice as you build it in real-time.",
  },
  {
    title: "Upload your Company Logo",
    description: "Add your company logo and customize your invoice template colors to match your branding!",
  },
  {
    title: "Online Payment Gateways",
    description: "Stripe, PayPal, GoCardless, Braintree, PayFast, Authorize, Square, Mollie, and more!",
  },
  {
    title: "Dynamic Dashboard Data",
    description: "View revenue, invoices sent, recent activity data. Track upcoming invoices, invoices past due, and more!",
  },
  {
    title: "Invoice Template Designs",
    description: "4 free invoice templates. Pro and Enterprise members have 11 professional designs!",
  },
  {
    title: "Track Inventory Levels",
    description: "Inventory levels are reduced automatically as products are invoiced, with notifications for low inventory thresholds.",
  },
  {
    title: "Recurring Invoicing & Auto-Billing Clients",
    description: "Save time by automatically billing long-term clients with recurring invoices.",
  },
  {
    title: "Client-Side Portal & Invoices/Payments History",
    description: "Clients can view their invoices, quotes, payments, documents, and all transaction history.",
  },
  {
    title: "Approved Quotes Auto-Convert to Payable Invoices",
    description: "Turn an approved quote into an invoice with one click, or allow auto-conversion from client approval.",
  },
  {
    title: "Accept Deposits & Partial Payments",
    description: "Set up partial payment or deposit requests, and the invoice will update itself automatically!",
  },
  {
    title: "Projects, Tasks & Track Time",
    description: "Log every task, record every second. When completed, one click sends completed tasks to an invoice.",
  },
  {
    title: "Alerts When Client Views & Pays Invoices",
    description: "Receive notifications when a client views and/or pays their invoice.",
  },
  {
    title: "Item & Product Library System",
    description: "Quickly select from potentially thousands of predefined service and product descriptions.",
  },
  {
    title: "Importing Expenses & Vendors",
    description: "Automatically import your expenses data to your Invoice Ninja account.",
  },
  {
    title: "Multiple Currencies & Languages",
    description: "Dozens of languages and currencies. You can set different languages and currencies per client!",
  },
  {
    title: "Multiple Shipping Addresses per Client",
    description: "Define multiple locations or shipping addresses per client to show per invoice.",
  },
  {
    title: "Bulk Emailing Invoices & Quotations",
    description: "Save time by quickly selecting multiple invoices and emailing them out together.",
  },
  {
    title: "Setup Automatic Credit Card Gateway Fees",
    description: "Automatically add credit card percentage or flat fees within predetermined price ranges you define!",
  },
  {
    title: "Enable/Disable Recurring When Cloning",
    description: "Clone recurring invoices to a regular invoice, and vice versa!",
  },
  {
    title: "Create Taxes per Invoice Total or per Invoice Line-Item",
    description: "Inclusive or exclusive taxation, invoice total or line-item taxation, up to 3 unique tax rates per invoice or line-item!",
  },
  {
    title: "Enabling/Disabling Nav Modules",
    description: "Show more or less menu navigation based on your work preference, in both your admin portal and client-portal.",
  },
  {
    title: "Custom Payment Instructions",
    description: "Have a unique method of receiving payment? Create custom payment instructions directly on the invoice and/or client-portal!",
  },
  {
    title: "Multiple Contacts Per Client",
    description: "Create multiple contacts within each client, to ensure the right people are notified for each invoice you send out!",
  },
  {
    title: "Kanban Boards to Manage Projects",
    description: "Organize and plan your client work with our visual project management tool.",
  },
  {
    title: "Vendor Purchase Orders",
    description: "Create Purchase Orders to email vendors. Approved POs convert into expenses to rebill or log for reporting.",
  },
  {
    title: "Localization of Language & Currency Settings",
    description: "Define your currency code, customize language, set preferred currency formatting '.' vs ','.",
  },
  {
    title: "Overpayment & Underpayment Settings",
    description: "Enable clients to pay extra (tipping), or set a minimum payment required on an invoice to allow a payment schedule.",
  },
  {
    title: "Invoice Payment Schedules",
    description: "A Payment Schedule lets you split a single invoice into multiple scheduled payments.",
  },
  {
    title: "Live .PDF Invoice Preview",
    description: "Enable a live PDF preview below or side-by-side the invoice edit page. PDF updates as you create!",
  },
];

const proFeatures = [
  {
    title: "Link Multiple Companies (x10) with 1 Login",
    description: "Manage invoicing for up to 10 business accounts all under one Invoice Ninja account.",
  },
  {
    title: "Create Custom Fields & Invoice Designs",
    description: "Create dynamic custom fields for your company, client details, invoice product columns, and more!",
  },
  {
    title: "Send Invoices & Quotes via Gmail & MSN Accounts",
    description: "Email invoices, quotes, and payment reminders via your Gmail or MSN accounts!",
  },
  {
    title: "Send Invoices & Quotes via Your Custom SMTP Setup",
    description: "Email invoices, quotes, and payment emails via your own SMTP server for a 100% branded experience.",
  },
  {
    title: "Create 'Client Groups' Workflow Settings",
    description: "Create groups of custom settings: payment terms, designs and more, for different groups of clients.",
  },
  {
    title: "Create Payment Links: Recurring & Auto-Billing",
    description: "Create Payment Links for Products and Services: One-Off Products or Recurring Services.",
  },
  {
    title: "Attach Invoice & Quotations PDFs to Emails",
    description: "Invoice and quote emails sent to clients include both a payment link and document PDF attachment.",
  },
  {
    title: "Fully Customizable Invoice Template Designs",
    description: "Match the look of your invoice with the design of your brand!",
  },
  {
    title: "Customize Email Subjects & Body Text",
    description: "Tailor your invoice email text for improved open rates and brand recognition.",
  },
  {
    title: "Enable Invoice Approval Checkbox or Client Signature",
    description: "Ensure clients understand your terms of agreement prior to payments.",
  },
  {
    title: "Create Reports, Accounts Aging & Client Statements",
    description: "Understand the bigger financial picture with our advanced report features.",
  },
  {
    title: "Automatic Late Fees on Unpaid Invoices",
    description: "Bill a client extra for unpaid invoices with automatic late payment fees.",
  },
  {
    title: "Custom Invoice & Quote Number Sequencing",
    description: "Use dynamic variables to create unique invoice sequencing.",
  },
  {
    title: "Set a 'BCC' Address for Invoice & Quote Emails",
    description: "Include additional company members in notifications.",
  },
  {
    title: "Custom Invoice Email Design",
    description: "Use light or dark templates, or create your own! Invoice emails are 100% customizable!",
  },
  {
    title: "Custom Reminder Emails",
    description: "Create unique templates for past-due reminder emails. Emails are automatically sent per date parameters you define!",
  },
  {
    title: "Automated Workflow",
    description: "Use the power of Zapier, Make, Pabbly, Integrately to integrate Invoice Ninja with hundreds of apps to automate workflow!",
  },
  {
    title: "Storefront Functionality",
    description: "Enable third-party apps to create invoices within your account.",
  },
  {
    title: "Custom Client-Portal Subdomain",
    description: "Customize your client portal URL to match your branding: YourBrand.Invoicing.co.",
  },
  {
    title: "Scheduled Reports + Attach Documents to Reports",
    description: "Configure auto-creation of reports and auto-email yourself on a regular basis with the report and send parameters you define.",
  },
  {
    title: "Invoice Data Import Template Mapping",
    description: "If you regularly import CSV file data into Invoice Ninja, the app will store your data format mapping to speed up imports!",
  },
];

const enterpriseFeatures = [
  {
    title: "Attach 3rd Party Files to Invoices & Expenses",
    description: "Attach important files for your client: .doc, .ppt, .xls, .jpg, .png, .pdf, and more, all together with your client's invoices and portal!",
  },
  {
    title: 'Custom Domain "Billing.YourCompany.com"',
    description: "100% branded experience! Your clients view invoices and pay on your custom company URL.",
  },
  {
    title: "Banking Integration",
    description: "With Yodlee and GoCardless (Nordigen) integrations, automatically import expenses and transactions from your bank accounts, credit cards, and PayPal.",
  },
  {
    title: "Additional Users & Set Permissions",
    description: "Add account users and set or limit access permissions per user on creating, editing, and viewing records.",
  },
  {
    title: "Client-Portal & Vendor Document Upload",
    description: "Allow clients and vendors to upload documents to their portal. Signed POs, receipts, and more!",
  },
  {
    title: "Additional Users Activity Notification Settings",
    description: "Enable or disable account activity and email notifications for different account users.",
  },
  {
    title: "Unlock Documents After Payment",
    description: 'Enable "locking" documents from being downloaded until after an invoice has been paid.',
  },
  {
    title: "e-Invoicing (PEPPOL)",
    description: "Start sending and receiving e-invoices immediately. All Enterprise Plans automatically receive 250 e-invoicing credits, free of charge!",
  },
];
---

<BaseLayout title="Features" description="More than invoicing. Explore all Invoice Ninja features for freelancers and small businesses." path="/features/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-lg text-primary font-semibold mb-3">More than invoicing&hellip;.</p>
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Get Paid, Fast!</h1>
      <p class="text-lg text-gray-600 mb-2">
        Invoice Ninja is a leading free invoicing software for small business invoicing, online payments, tracking expenses & billable-tasks.
      </p>
      <p class="text-lg text-gray-500 mb-8">Focus on doing what you love. We'll help with the invoicing :)</p>
      <Button href="https://app.invoicing.co/#/register" size="lg">Sign Up</Button>
    </div>
    <img src="/images/common/Ornament-11.svg" alt="" class="hidden lg:block absolute left-0 top-1/3 w-32 opacity-20 pointer-events-none" aria-hidden="true" />
  </section>

  <!-- Pricing Tier Cards -->
  <section class="relative py-16 overflow-hidden">
    <!-- Decorative blue shape behind cards -->
    <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-64 mx-auto max-w-5xl rounded-3xl bg-gradient-to-r from-primary/10 via-primary/5 to-primary/10 -z-0"></div>
    <div class="relative max-w-6xl mx-auto px-4 z-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Forever Free -->
        <div class="text-center p-8 rounded-2xl border border-gray-200 bg-white shadow-[0_100px_80px_rgba(0,0,0,0.03),0_20px_30px_rgba(0,0,0,0.04)] hover:shadow-lg transition-shadow">
          <h3 class="text-lg font-bold text-dark mb-2">Forever Free</h3>
          <p class="text-4xl font-bold text-primary mb-1">$0<span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="text-sm text-gray-500 mb-6">Yes, it's really free :)</p>
          <Button href="https://app.invoicing.co/#/register" size="sm">Create & Email Invoices in Real-Time</Button>
        </div>
        <!-- Ninja Pro -->
        <div class="text-center p-8 rounded-2xl border-2 border-primary bg-primary/5 shadow-[0_100px_80px_rgba(0,0,0,0.03),0_20px_30px_rgba(0,0,0,0.04)] hover:shadow-lg transition-shadow">
          <h3 class="text-lg font-bold text-dark mb-2">Ninja Pro</h3>
          <p class="text-4xl font-bold text-primary mb-1">$12<span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="text-sm text-gray-500 mb-6">Pay annually for 10 months + 2 free!</p>
          <p class="text-sm font-semibold text-dark">Unlimited Everything</p>
        </div>
        <!-- Enterprise -->
        <div class="text-center p-8 rounded-2xl border border-gray-200 bg-white shadow-[0_100px_80px_rgba(0,0,0,0.03),0_20px_30px_rgba(0,0,0,0.04)] hover:shadow-lg transition-shadow">
          <h3 class="text-lg font-bold text-dark mb-2">Ninja Enterprise</h3>
          <p class="text-4xl font-bold text-primary mb-1">$16<span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="text-sm text-gray-500 mb-6">Pay annually for 10 months + 2 free!</p>
          <p class="text-sm font-semibold text-dark">Free + Pro + Enterprise Features</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Jump-to Navigation -->
  <nav class="sticky top-16 lg:top-20 z-30 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-4xl mx-auto px-4 flex items-center justify-center gap-4 py-3">
      <span class="text-sm text-gray-400 font-medium">Jump to</span>
      <a href="#features_free" class="px-5 py-2 text-sm font-semibold text-white bg-primary rounded-full hover:bg-primary-dark transition-colors">
        Free
      </a>
      <a href="#features_pro" class="px-5 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-full hover:bg-primary hover:text-white transition-colors">
        Pro
      </a>
      <a href="#features_enterprise" class="px-5 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-full hover:bg-primary hover:text-white transition-colors">
        Enterprise
      </a>
    </div>
  </nav>

  <!-- Free Features -->
  <section id="features_free" class="py-16 bg-gray-50 scroll-mt-28">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-3">Forever Free</h2>
        <p class="text-gray-600 text-lg">Everything you need to start invoicing, completely free.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {freeFeatures.map((feature) => (
          <div class="bg-white rounded-2xl p-6 shadow-[0_100px_80px_rgba(0,0,0,0.03),0_20px_30px_rgba(0,0,0,0.04)] hover:shadow-lg transition-shadow border border-gray-100">
            <h3 class="font-bold text-dark mb-2">{feature.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pro Features -->
  <section id="features_pro" class="py-16 scroll-mt-28">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-3">Ninja Pro</h2>
        <p class="text-gray-600 text-lg">Unlimited Everything</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {proFeatures.map((feature) => (
          <div class="bg-primary/5 rounded-2xl p-6 shadow-[0_100px_80px_rgba(0,0,0,0.03),0_20px_30px_rgba(0,0,0,0.04)] hover:shadow-lg transition-shadow border border-primary/10">
            <h3 class="font-bold text-dark mb-2">{feature.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Enterprise Features -->
  <section id="features_enterprise" class="py-16 bg-gray-50 scroll-mt-28">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-3">Enterprise Ninja</h2>
        <p class="text-gray-600 text-lg">Free + Pro Features + Enterprise</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {enterpriseFeatures.map((feature) => (
          <div class="bg-white rounded-2xl p-6 shadow-[0_100px_80px_rgba(0,0,0,0.03),0_20px_30px_rgba(0,0,0,0.04)] hover:shadow-lg transition-shadow border border-gray-200">
            <h3 class="font-bold text-dark mb-2">{feature.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <Button href="/pricing-plans/" size="lg" variant="outline">View Full Pricing</Button>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20" style="background: linear-gradient(336.7deg, #161C27 0%, #0E466D 100%);">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-3">Start Invoicing Today!</h2>
      <p class="text-lg text-white/80 mb-8">Invoice Clients, Get Paid Fast!</p>
      <a href="https://app.invoicing.co/#/register" class="inline-flex items-center justify-center px-10 py-4 text-lg font-semibold rounded-xl bg-white text-primary hover:bg-gray-100 transition-colors shadow-lg">
        Test Drive!
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
