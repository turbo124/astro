---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Hosting Recommendations" description="Recommended hosting providers for self-hosting Invoice Ninja on your own server." path="/hosting-recommendations/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Hosting Recommendations</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">Recommended hosting providers for self-hosting Invoice Ninja on your own server.</p>
      </div>

      <div class="mt-12 text-center">
        <a href="/hosting/" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors">View Hosting Partners</a>
      </div>
      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
