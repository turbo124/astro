---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Invoicing, Quotes, Payments" description="Free invoicing software enabling small businesses to create invoices, send quotes, and accept online payments." path="/invoicing/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-6xl font-bold text-dark mb-4">Create. Send. Get Paid.</h1>
      <p class="text-lg text-gray-500 mb-2">Invoicing, Quotes, Payments</p>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">Free invoicing software enabling small businesses to manage client billing efficiently.</p>
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
        <Button href="https://react.invoicing.co/demo" variant="outline" size="lg">Try Demo</Button>
      </div>
      <img src="/images/how-it-works/email-invoices-thumbnail.png" alt="Invoice Ninja invoicing dashboard" class="w-full max-w-3xl mx-auto rounded-xl shadow-lg" loading="lazy" />
    </div>
  </section>

  <!-- Invoicing & Quotations -->
  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Invoicing & Quotations</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">Everything you need to create, send, and manage invoices and quotes from a single platform.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Create & Send Invoices in Seconds</h3>
          <p class="text-sm text-gray-600">Create clients and send professional invoices in seconds. Accept deposits and partial payments with multi-currency support.</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Recurring Invoices & Auto-Billing</h3>
          <p class="text-sm text-gray-600">Create recurring invoices and client payment profiles. Set it and forget it -- get paid on time, every time.</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Send via Gmail, MSN, or Custom SMTP</h3>
          <p class="text-sm text-gray-600">Send invoices via your Gmail, MSN, or custom SMTP setup ensuring a fully branded client experience.</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8 5-8-5m16 0v10a2 2 0 01-2 2H6a2 2 0 01-2-2V7m16 0l-8-5-8 5" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Product Library</h3>
          <p class="text-sm text-gray-600">Product library tool populates invoices and quotes instantly. Track inventory levels and manage your item catalog.</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Attach 3rd Party Files</h3>
          <p class="text-sm text-gray-600">Attach proposal files, agreements, and design work files to client invoices and emails (.doc, .ppt, .xls, .jpg, .png, .pdf).</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Reporting & Client Statements</h3>
          <p class="text-sm text-gray-600">Reporting, accounts aging, and client statements. Generate P&L, invoice, payment, task, and transaction reports.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients Pay Faster -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-6">Clients Pay Faster</h2>
          <p class="text-gray-600 mb-8">Accept credit cards, ACH payments, PayPal, and more. Clients pay directly from the invoice with a single click.</p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Accept credit cards, ACH payments, PayPal, and more payment methods</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Clients pay directly from invoice with single click</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Receive app and email notifications when clients view invoices</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">View instant data updates when payments are made</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Automate payment reminders and past due notifications</span>
            </li>
          </ul>
        </div>
        <img src="/images/how-it-works/gateway.png" alt="Payment gateways" class="w-full rounded-xl shadow-lg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Detailed Feature Grid: Forever Free -->
  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Forever Free Features</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">Powerful invoicing tools included at no cost, forever.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Live PDF Invoice Preview</h3>
          <p class="text-sm text-gray-600">View invoice PDFs in real-time as created before sending for payment.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Overpayment & Underpayment Settings</h3>
          <p class="text-sm text-gray-600">Enable clients to underpay (within minimum limits) or overpay as tips.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Localization of Language & Currency</h3>
          <p class="text-sm text-gray-600">Support dozens of languages, currencies, time/date formatting options.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Vendor Purchase Orders</h3>
          <p class="text-sm text-gray-600">Create and email POs to vendors; convert approved POs into expenses.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Kanban Boards to Manage Projects</h3>
          <p class="text-sm text-gray-600">Visual project management tool for task planning and workflow visualization.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Multiple Contacts Per Client</h3>
          <p class="text-sm text-gray-600">Add multiple contacts per client to ensure correct invoice delivery.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Custom Payment Instructions</h3>
          <p class="text-sm text-gray-600">Create custom payment guidance (bank details, wire instructions) for clients.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Enabling/Disabling Nav Modules</h3>
          <p class="text-sm text-gray-600">Add or remove navigation modules: Invoices, Quotes, Credits, Projects, Tasks, Vendors, Purchase Orders.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Feature Grid: Ninja Pro -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Ninja Pro Features</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">Advanced tools to customize your workflow and impress your clients.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Custom Invoice Email Design</h3>
          <p class="text-sm text-gray-600">Customize invoice emails using Light, Dark, Plain templates or create custom designs with variables.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">BCC Address for Invoice & Quote Emails</h3>
          <p class="text-sm text-gray-600">Include additional company members in invoice and quote email notifications.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Custom Number Sequencing</h3>
          <p class="text-sm text-gray-600">Create custom invoice number sequencing for invoices, quotations, payments, and clients using dozens of dynamic variables.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Automatic Late Fees</h3>
          <p class="text-sm text-gray-600">Set up invoice late fees that apply automatically when invoices pass their due dates as percentage or flat value.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Reports, Accounts Aging & Statements</h3>
          <p class="text-sm text-gray-600">Robust reporting: Client, Contact, Document, Invoice, Payment, P&L, Task, and Transaction Reports.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Approval Checkbox or Client Signature</h3>
          <p class="text-sm text-gray-600">Require approval checkbox or e-signature for client quotation and payment page access.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Customize Email Subjects & Body Text</h3>
          <p class="text-sm text-gray-600">Create custom email subject lines and body templates for invoices, payments, reminders, and custom emails.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Customizable Invoice Template Designs</h3>
          <p class="text-sm text-gray-600">Pro and Enterprise accounts have 11 invoice template designs with the ability to create fully custom designs.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Attach PDFs to Emails</h3>
          <p class="text-sm text-gray-600">Enable attaching quotation and invoice PDFs to all client communications.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Client Subscriptions & Auto-Billing</h3>
          <p class="text-sm text-gray-600">Set up recurring subscriptions with automatic client billing. Set it and forget it.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Client Groups Workflow Settings</h3>
          <p class="text-sm text-gray-600">Show different company logos and contact details to different client groups, configure different payment terms per group.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Send via Gmail & MSN Accounts</h3>
          <p class="text-sm text-gray-600">Email invoices, quotes, and payment reminders via your Gmail or MSN accounts ensuring a branded experience.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Custom Fields & Invoice Designs</h3>
          <p class="text-sm text-gray-600">Create custom fields on quotes and invoices: single line text, calendar dates, paragraphs, dropdown selectors.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Link Multiple Companies (x10)</h3>
          <p class="text-sm text-gray-600">Interlink up to 10 companies and switch between accounts with a single click.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Feature Grid: Enterprise -->
  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Enterprise Ninja Features</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">Enterprise-grade capabilities for growing businesses.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Unlock Documents After Payment</h3>
          <p class="text-sm text-gray-600">Enable locking documents from being downloaded until after an invoice has been paid.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Additional Users & Notifications</h3>
          <p class="text-sm text-gray-600">Create additional account users, set permissions, and receive notifications for actions taken by users.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Client-Portal & Vendor Document Upload</h3>
          <p class="text-sm text-gray-600">Allow your clients and vendors to upload documents in their client/vendor-side portal.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Banking Integration</h3>
          <p class="text-sm text-gray-600">Import bank and card transactions, match deposits to invoices, match withdrawals to vendors, enable autosync.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Custom Domain</h3>
          <p class="text-sm text-gray-600">Create a custom URL like Billing.YourCompany.com for your client portal.</p>
        </div>
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-bold text-dark mb-2">Attach 3rd Party Files to Invoices</h3>
          <p class="text-sm text-gray-600">Attach proposal files, agreements, design work files to invoices and client-side portal (.doc, .ppt, .xls, .jpg, .png, .pdf).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Invoicing & Payments Checklist -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Invoicing & Payments</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">A comprehensive list of invoicing and payment features built into every account.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {[
          "Create & Email Invoices & Quotes in Real-Time",
          "Upload your Company Logo",
          "Payment Gateways (Stripe, PayPal, Checkout, Braintree, PayFast, Authorize, Square, Mollie)",
          "Dynamic Dashboard Data",
          "Invoice Template Designs (4 free; Pro has 10+ professional designs)",
          "Track Inventory Levels",
          "Additional Users & Set Permissions",
          "Link Multiple Companies (x10) with 1 Login",
          "Recurring Invoicing & Auto-Billing Clients",
          "Attach 3rd Party Files to Invoices & Expenses",
          "Customize Invoice Fields",
          "Client-Side Account Portal",
          "Projects, Tasks & Track Time",
          "Send Invoices & Quotes via Gmail & MSN Accounts",
          "Email via your SMTP Setup",
          "Create Group Workflow Settings",
          "Custom Domain 'Billing.YourCompany.com'",
          "Kanban Boards for Projects",
          "Approved Quotes Auto-Convert to Payable Invoices",
          "Fully Customizable Invoice Template Design",
          "Customize Email Subjects & Body Text",
          "Accept Deposits & Partial Payments",
          "Invoice Payment Auto-Reminder Emails",
          "Alerts When Client Views & Pays Invoices",
          "Enable Invoice Approval Checkbox or Client Signature",
          "Item & Product Library System",
          "Bulk Emailing Invoices & Quotations",
          "Create Reports, Accounts Aging & Client Statements",
          "Importing Expenses & Vendors",
          "Multiple Currencies & Languages",
          "Currency Formatting '.' vs ','",
          "Setup Automatic Credit Card Gateway Fees",
          "Setup Automatic Late Fees on Unpaid Invoices",
          "Enable/Disable Recurring When Cloning",
          "Set a 'BCC' Address for Invoice & Quote Emails",
          "Tax Settings per Line Item or Invoice Total",
          "Enabling/Disabling Nav Modules",
          "Create Custom Payment Instructions",
          "Automated Currency Exchange",
          "Auto Sales Tax Calculation",
        ].map((feature) => (
          <div class="flex items-start gap-3 p-3 bg-white rounded-lg">
            <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm text-gray-700">{feature}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Section -->
  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4 text-center">Community</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">Building business tools since 2014. Connect with our global community.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Forums</h3>
          <p class="text-sm text-gray-600 mb-4">Connect with thousands of Invoice Ninja users on our community forums.</p>
          <a href="https://forum.invoiceninja.com/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Community Forums &rarr;</a>
        </div>
        <div class="text-center p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-dark mb-2">Contact Email</h3>
          <p class="text-sm text-gray-600 mb-4">We want to hear from you! Questions? We're here to help!</p>
          <a href="mailto:Contact@InvoiceNinja.com" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Contact@InvoiceNinja.com</a>
        </div>
        <div class="text-center p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
