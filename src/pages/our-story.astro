---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Our Story" description="Invoice Ninja — bootstrapped since 2014. Building business tools for freelancers and small businesses." path="/our-story/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-8">Our Story</h1>
      <p class="text-xl text-gray-600 mb-12">Bootstrapped since 2014. No VC overlords.</p>

      <div class="prose prose-lg max-w-none">
        <p>Invoice Ninja was founded in 2014 by Hillel and Shalom. Dave joined as CTO in 2015, completing the founding trio. The platform launched in March 2014 as a beta product.</p>

        <img
          src="/images/our-story/Team-Invoice-Ninja.jpg"
          alt="Invoice Ninja Team"
          loading="lazy"
          class="rounded-xl shadow-lg w-full my-8"
        />

        <p>We're a bootstrapped company — self-funded from day one with no venture capital. This means we answer to our users, not investors.</p>

        <h2>Timeline</h2>
        <ul>
          <li><strong>2014</strong> — Beta launch</li>
          <li><strong>2015</strong> — Dave joins as CTO</li>
          <li><strong>2019</strong> — Development of v5 begins</li>
          <li><strong>2021</strong> — Invoice Ninja v5 launches using Google Flutter</li>
          <li><strong>2022</strong> — 200,000+ account milestone</li>
          <li><strong>2023</strong> — React-based application launches</li>
        </ul>

        <img
          src="/images/our-story/Rectangle-18-1.jpg"
          alt="Invoice Ninja"
          loading="lazy"
          class="rounded-xl shadow-lg w-full my-8"
        />

        <h2>Self-Hosting</h2>
        <p>We offer users the ability to self-host the platform on their own servers through our open-source project.</p>

        <h2>Community</h2>
        <p>Our co-founders personally handle customer support. We maintain active community channels including Slack (5,000+ members) and Discord.</p>
      </div>
    </div>
  </section>

  <!-- Let's Connect! Community Section -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-dark text-center mb-12">Let's Connect!</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <a href="https://forum.invoiceninja.com" target="_blank" rel="noopener noreferrer" class="block bg-white rounded-2xl p-8 border border-gray-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300 text-center">
          <h3 class="text-xl font-bold text-dark mb-2">Support Forums</h3>
          <p class="text-gray-600">forum.invoiceninja.com</p>
        </a>
        <a href="mailto:contact@invoiceninja.com" class="block bg-white rounded-2xl p-8 border border-gray-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300 text-center">
          <h3 class="text-xl font-bold text-dark mb-2">Contact Email</h3>
          <p class="text-gray-600">contact@invoiceninja.com</p>
        </a>
        <a href="https://slack.invoiceninja.com" target="_blank" rel="noopener noreferrer" class="block bg-white rounded-2xl p-8 border border-gray-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300 text-center">
          <h3 class="text-xl font-bold text-dark mb-2">Slack Community</h3>
          <p class="text-gray-600">slack.invoiceninja.com</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-primary py-20 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">Start Invoicing Today!</h2>
      <p class="mt-4 text-lg text-white/80">Create. Send. Get Paid.</p>
      <div class="mt-10">
        <a
          href="https://app.invoicing.co/#/register"
          class="inline-block px-10 py-4 text-lg font-semibold text-primary bg-white rounded-xl hover:bg-gray-50 transition-all shadow-lg"
        >
          Test Drive!
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
