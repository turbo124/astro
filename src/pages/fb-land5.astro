---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Invoice Ninja" description="Professional invoicing made simple and free." path="/fb-land5/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Invoice Ninja</h1>
        <p class="text-xl text-gray-600">Professional invoicing made simple and free.</p>
      </div>

      <div class="max-w-xl mx-auto text-center not-prose">
        <p class="text-2xl font-bold text-dark mb-4">Professional Invoicing Made Simple</p>
        <p class="text-gray-600 mb-8">Join 200,000+ freelancers and small businesses using Invoice Ninja to get paid faster.</p>
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="p-4 rounded-lg bg-gray-50"><p class="font-bold text-dark">Invoicing</p><p class="text-xs text-gray-500">Create & send in seconds</p></div>
          <div class="p-4 rounded-lg bg-gray-50"><p class="font-bold text-dark">Payments</p><p class="text-xs text-gray-500">Accept online payments</p></div>
          <div class="p-4 rounded-lg bg-gray-50"><p class="font-bold text-dark">Expenses</p><p class="text-xs text-gray-500">Track & categorize</p></div>
          <div class="p-4 rounded-lg bg-gray-50"><p class="font-bold text-dark">Time Tracking</p><p class="text-xs text-gray-500">Bill for your time</p></div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
