---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex>
  <Header slot="header" />

  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-bold text-primary mb-4">404</p>
    <h1 class="text-2xl font-bold text-dark mb-3">Page Not Found</h1>
    <p class="text-gray-500 mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <Button href="/" variant="primary" size="lg">Go Home</Button>
  </div>

  <Footer slot="footer" />
</BaseLayout>
