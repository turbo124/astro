---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Gmail Integration" description="Send invoices directly from Gmail with Invoice Ninja integration." path="/gmail-and-invoice-ninja-integrations/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Gmail Integration</h1>
        <p class="text-xl text-gray-600">Send invoices directly from Gmail with Invoice Ninja integration.</p>
      </div>

      <div class="prose prose-lg prose-gray max-w-none mx-auto">
        <h2>Send Invoices via Gmail</h2>
        <p>With Invoice Ninja Pro, you can send invoices directly through your Gmail account. Your clients see emails from your address, not ours.</p>
        <h2>Setup</h2>
        <ol>
          <li>Upgrade to Invoice Ninja Pro</li>
          <li>Navigate to Settings &gt; Email Settings</li>
          <li>Select Gmail and authenticate with OAuth</li>
          <li>Start sending invoices from your Gmail address</li>
        </ol>
        <p>Also supports Microsoft Outlook/MSN and custom SMTP servers.</p>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
