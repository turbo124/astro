---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Gmail and Invoice Ninja Integrations" description="Connect Gmail with Invoice Ninja. Design, build, and automate anything for your work by integrating apps like Gmail to create visual automated workflows." path="/gmail-and-invoice-ninja-integrations/">
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-6">Gmail and Invoice Ninja Integrations</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-10">Connect Gmail with any of your favorite apps in just a few clicks. Design, build, and automate anything for your work by integrating apps like Gmail to create visual automated workflows. Choose from thousands of ready-made apps or use our no-code toolkit to connect to apps not yet in our library.</p>
      <div class="flex items-center justify-center gap-6">
        <img src="/images/zapier/gmail.png" alt="Gmail" class="w-16 h-16 object-contain" loading="lazy" />
        <svg class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        <img src="/images/logo.svg" alt="Invoice Ninja" class="w-16 h-16 object-contain" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Setup Steps -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-12">Send Invoices via Gmail</h2>
      <p class="text-lg text-gray-600 text-center mb-10 max-w-3xl mx-auto">With Invoice Ninja Pro, you can send invoices directly through your Gmail account. Your clients see emails from your address, not ours — building trust and brand consistency with every invoice.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        {[
          { step: "1", title: "Upgrade to Pro", desc: "Unlock Gmail integration as part of the Invoice Ninja Pro or Enterprise plans." },
          { step: "2", title: "Configure Email Settings", desc: "Navigate to Settings > Email Settings and select Gmail as your email provider." },
          { step: "3", title: "Authenticate with OAuth", desc: "Securely connect your Gmail account using Google OAuth — no passwords stored." },
          { step: "4", title: "Start Sending", desc: "Send invoices, quotes, and reminders directly from your Gmail address." },
        ].map((item) => (
          <div class="flex gap-4 p-6 rounded-xl border border-gray-200 bg-white">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">{item.step}</div>
            <div>
              <h3 class="text-lg font-bold text-dark mb-1">{item.title}</h3>
              <p class="text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Supported Triggers and Actions -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-4">Supported Triggers and Actions</h2>
      <p class="text-lg text-gray-600 text-center mb-12 max-w-3xl mx-auto">Create custom Invoice Ninja workflows by choosing triggers, actions, and searches. A trigger is an event that launches the workflow, an action is the event.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { title: "Mark an Email as Unread", type: "Action", desc: "Marks an email or draft in a selected directory as unread by setting the 'Unread' flag." },
          { title: "Create a Draft", type: "Feeder", desc: "Creates a new draft and adds it to a selected folder." },
          { title: "Copy an Email", type: "Action", desc: "Copies an email or a draft into a selected folder." },
          { title: "Delete an Email", type: "Action", desc: "Removes an email or a draft from a selected folder." },
          { title: "Mark an Email as Read", type: "Action", desc: "Marks an email or a draft in a selected directory as read by setting the 'Read' flag." },
          { title: "Iterate Attachments", type: "Feeder", desc: "Iterates through received attachments." },
        ].map((item) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white">
            <div class="flex items-center gap-3 mb-2">
              <h3 class="text-lg font-bold text-dark">{item.title}</h3>
              <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${item.type === "Action" ? "bg-blue-100 text-blue-700" : "bg-green-100 text-green-700"}`}>{item.type}</span>
            </div>
            <p class="text-sm text-gray-600">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <Button href="https://zapier.com/apps/invoice-ninja/integrations/gmail" size="lg">Learn More on Zapier!</Button>
      </div>
    </div>
  </section>

  <!-- Zapier + Invoice Ninja -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-dark mb-6">Zapier + Invoice Ninja</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-8">With Zapier you can integrate your Invoice Ninja with thousands of other apps and streamline your cross-app workflow with smooth automated functions.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          {[
            { title: "5,000+ Apps", desc: "Connect Invoice Ninja with thousands of apps through Zapier's extensive library." },
            { title: "No-Code Automation", desc: "Build powerful workflows without writing a single line of code." },
            { title: "Instant Triggers", desc: "Workflows fire automatically when events happen in Invoice Ninja." },
          ].map((item) => (
            <div class="p-6 rounded-xl border border-gray-200 bg-gray-50 text-center">
              <h3 class="text-lg font-bold text-dark mb-2">{item.title}</h3>
              <p class="text-sm text-gray-600">{item.desc}</p>
            </div>
          ))}
        </div>
        <Button href="/zapier/" variant="outline" size="lg">Explore Zapier Integration</Button>
      </div>
    </div>
  </section>

  <!-- Also Supports Microsoft Outlook/MSN and Custom SMTP -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-6">Also Supports Microsoft Outlook/MSN and Custom SMTP</h2>
      <p class="text-lg text-gray-600 text-center mb-12 max-w-3xl mx-auto">Gmail is just the start. Invoice Ninja also supports Microsoft Outlook, MSN, and custom SMTP servers so you can send invoices from virtually any email provider.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: "Microsoft Outlook / MSN", desc: "Connect your Outlook or MSN account via OAuth for secure, branded email delivery to your clients." },
          { title: "Custom SMTP", desc: "Use your own SMTP server for full control over email delivery, SPF, DKIM, and domain reputation." },
          { title: "Gmail", desc: "Authenticate with Google OAuth and send invoices directly from your Gmail address with zero configuration." },
        ].map((item) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white text-center">
            <h3 class="text-lg font-bold text-dark mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-12">Frequently Asked Questions</h2>

      <div class="space-y-6">
        {[
          {
            q: "Does Invoice Ninja offer an API?",
            a: "Yes! As part of the Pro & Enterprise plans you have REST API access."
          },
          {
            q: "How do my clients pay their invoices online?",
            a: "After integrating a 'payment gateway' to your Invoice Ninja account, your clients will see a 'Pay Now' button on their invoices. The payment gateway processes the payment and your clients never leave their Invoice Ninja client-side portal. It subsequently deposits the money to your bank account. Invoice Ninja supports dozens of payment gateways."
          },
          {
            q: "How do I upload my company logo on invoices?",
            a: "Navigate to Settings > Company Details, and click 'Logo' to upload or change your logo. This is available to all plans, including free!"
          },
          {
            q: "Do you offer a client-side portal for my clients?",
            a: "Yes, all your clients have access to a client-side portal to view their invoices, payment history, documents, and more. Your clients can also update their payment details on file for recurring invoices with auto-billing."
          },
          {
            q: "Can I add more users but limit what they see or do?",
            a: "Yes, the Enterprise plans allow you to add up to 50 additional account users! You can adjust user permissions to create/edit/view only."
          },
          {
            q: "Can I run reports & year-end P&L's?",
            a: "Yes, as part of the Pro & Enterprise plans you have access to a robust reporting module to create custom reports within calendar/date parameters you define."
          },
          {
            q: "How do I integrate with Zapier?",
            a: "After upgrading to Pro or Enterprise, navigate to Settings > Account Management, and click 'Zapier'."
          },
        ].map((faq) => (
          <details class="group rounded-xl border border-gray-200 bg-white">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-bold text-dark text-lg">
              {faq.q}
              <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Ready to Get Started?</h2>
      <p class="text-lg text-gray-600 mb-8">Create a free account and start sending invoices from Gmail in minutes. No credit card required.</p>
      <Button href="https://app.invoicing.co/#/register" size="lg">Create a Free Account!</Button>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
