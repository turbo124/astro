---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Zapier Integration" description="Connect Invoice Ninja with 5,000+ apps through Zapier automation. No coding required." path="/zapier/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Zapier + Invoice Ninja</h1>
      <p class="text-xl text-gray-600 mb-10">Connect Invoice Ninja with 5,000+ apps. No coding required.</p>
      <img
        src="/images/zapier/connect.png"
        alt="Invoice Ninja + Zapier"
        class="mx-auto max-w-full rounded-lg"
        loading="lazy"
      />
    </div>
  </section>

  <!-- Text Block -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-lg text-gray-700 leading-relaxed">
        Improve cash flow by automating the creation of your customer invoices using Invoice Ninja and Zapier. Zapier lets you connect Invoice Ninja to 5,000+ other web services. Automated connections called Zaps, set up in minutes with no coding, can automate your day-to-day tasks and build workflows between apps that otherwise wouldn't be possible.
      </p>
    </div>
  </section>

  <!-- Integration Logos Grid -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-12">Popular Integrations</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 justify-items-center">
        {[
          { src: "/images/zapier/sheets.png", name: "Google Sheets" },
          { src: "/images/zapier/gmail.png", name: "Gmail" },
          { src: "/images/zapier/gdrive.png", name: "Google Drive" },
          { src: "/images/zapier/air.png", name: "Airtable" },
          { src: "/images/zapier/slack.png", name: "Slack" },
          { src: "/images/zapier/gcalendar.png", name: "Google Calendar" },
          { src: "/images/zapier/woo.png", name: "WooCommerce" },
          { src: "/images/zapier/dropbox.png", name: "Dropbox" },
          { src: "/images/zapier/mailchimp.png", name: "Mailchimp" },
          { src: "/images/zapier/hubspot.png", name: "HubSpot" },
          { src: "/images/zapier/discord.png", name: "Discord" },
          { src: "/images/zapier/trello.png", name: "Trello" },
          { src: "/images/zapier/google-forms.png", name: "Google Forms" },
          { src: "/images/zapier/shopify.png", name: "Shopify" },
          { src: "/images/zapier/monda.png", name: "Monday.com" },
          { src: "/images/zapier/pipedrive.png", name: "Pipedrive" },
        ].map((app) => (
          <div class="flex flex-col items-center gap-3 p-4">
            <img
              src={app.src}
              alt={app.name}
              class="w-16 h-16 object-contain"
              loading="lazy"
            />
            <span class="text-sm text-gray-600 text-center font-medium">{app.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Do More Section -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-6">Do More! Zapier + Invoice Ninja</h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-4">
        Each Zap consists of a trigger step and one or more action steps. When you turn your Zap on, it will run the action steps every time the trigger event occurs. You can connect Invoice Ninja with thousands of the most popular apps, so you can automate your work and have more time for what matters most -- no code required.
      </p>
      <p class="text-lg text-gray-700 leading-relaxed">
        Popular automations include creating invoices from form submissions, syncing new clients to your CRM, sending notifications when payments arrive, and logging time entries from project management tools.
      </p>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-12">Frequently Asked Questions</h2>
      <div class="space-y-3" id="zapier-faq-list">
        <div class="faq-item border border-gray-200 rounded-xl overflow-hidden bg-white">
          <button
            class="zapier-faq-toggle w-full flex items-center justify-between px-6 py-5 text-left hover:bg-gray-50 transition-colors"
            aria-expanded="false"
          >
            <span class="text-base font-semibold text-dark pr-4">What is Zapier?</span>
            <svg class="zapier-faq-arrow w-5 h-5 text-gray-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="zapier-faq-content hidden px-6 pb-6">
            <p class="text-sm text-gray-600 leading-relaxed">Zapier is an online automation tool that connects your favorite apps, such as Gmail, Slack, Mailchimp, and over 5,000 more. You can connect two or more apps to automate repetitive tasks without coding or relying on developers to build the integration. Move info between your web apps automatically, so you can focus on your most important work.</p>
          </div>
        </div>

        <div class="faq-item border border-gray-200 rounded-xl overflow-hidden bg-white">
          <button
            class="zapier-faq-toggle w-full flex items-center justify-between px-6 py-5 text-left hover:bg-gray-50 transition-colors"
            aria-expanded="false"
          >
            <span class="text-base font-semibold text-dark pr-4">How do I connect Invoice Ninja with Zapier?</span>
            <svg class="zapier-faq-arrow w-5 h-5 text-gray-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="zapier-faq-content hidden px-6 pb-6">
            <p class="text-sm text-gray-600 leading-relaxed">Sign up for a free Zapier account, search for Invoice Ninja in the app directory, and connect it using your Invoice Ninja API key. From there, you can create Zaps that trigger actions in other apps whenever events happen in Invoice Ninja -- such as when a new invoice is created, a payment is received, or a new client is added.</p>
          </div>
        </div>

        <div class="faq-item border border-gray-200 rounded-xl overflow-hidden bg-white">
          <button
            class="zapier-faq-toggle w-full flex items-center justify-between px-6 py-5 text-left hover:bg-gray-50 transition-colors"
            aria-expanded="false"
          >
            <span class="text-base font-semibold text-dark pr-4">What are some popular Invoice Ninja Zaps?</span>
            <svg class="zapier-faq-arrow w-5 h-5 text-gray-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="zapier-faq-content hidden px-6 pb-6">
            <p class="text-sm text-gray-600 leading-relaxed">Some of the most popular Invoice Ninja Zaps include: creating invoices automatically from Google Sheets rows, sending Slack notifications when payments are received, adding new Invoice Ninja clients to HubSpot or Mailchimp, and creating Invoice Ninja invoices from WooCommerce or Shopify orders.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center bg-primary rounded-xl py-12 px-6">
        <h2 class="text-3xl font-bold text-white mb-2">Start Automating Today!</h2>
        <p class="text-lg text-white/90 mb-6">Connect Invoice Ninja with your favorite apps using Zapier.</p>
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.querySelectorAll('.zapier-faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const arrow = btn.querySelector('.zapier-faq-arrow');
      const isOpen = content?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      arrow?.classList.toggle('rotate-180', isOpen);
    });
  });
</script>
