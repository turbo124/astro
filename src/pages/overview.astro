---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const invoicingFeatures = [
  "Clients Pay Invoices Online with 1-Click",
  'Branded URL: "YourBrand".Invoicing.co',
  "Professional Invoice Template Designs",
  "Accept Deposits & Partial Payments",
  "Send Invoices via Gmail, Microsoft, SMTP",
  "Customize Payment Auto-Reminder Emails",
  "Display E-Signature on Invoices & Quotes",
  "Auto-Billing & Recurring Invoicing",
  "Product Item Library Management",
  "Inventory Management",
  "Run Profit & Loss Reports",
  "Much more!",
];

const quotationFeatures = [
  "Clients Approve & Convert Quotes to Pay Invoices",
  "Quotes Share Invoice Custom Template Designs",
  "Bulk Email Clients Quotations & Invoices",
  "Set Quotation Validity / Expiration Dates",
  "Auto-Archived Approved/Converted Quotes",
  "Much more!",
];

const paymentGateways = [
  { name: "Stripe", logo: "/images/gateways-logos/STRIPE-1024x488.png" },
  { name: "PayPal & Venmo", logo: "/images/gateways-logos/PAYPAL.png" },
  { name: "Authorize.net", logo: "/images/gateways-logos/AUTHORIZE-1024x235.png" },
  { name: "Checkout.com", logo: "/images/gateways-logos/CHECKOUT-1-1024x538.png" },
  { name: "GoCardless", logo: "/images/gateways-logos/GoCardless-Symbol-Negative-RGB-500px-1024x1024.png" },
  { name: "Square", logo: "/images/gateways-logos/SQUARE-1024x576.jpg" },
  { name: "Mollie", logo: "/images/gateways-logos/MollieLogo23-Black-1024x302.png" },
  { name: "PayFast", logo: "/images/gateways-logos/Payfast-By-Network_dark-1024x541.png" },
  { name: "PayTrace", logo: "/images/gateways-logos/paytrace.png" },
  { name: "RazorPay", logo: "/images/gateways-logos/Razorpay-1024x1024.png" },
  { name: "Eway Rapid", logo: "/images/gateways-logos/EWAY-1024x298.png" },
  { name: "Forte", logo: "/images/gateways-logos/MicrosoftTeams-image-4.png" },
  { name: "BTCPay", logo: "/images/gateways-logos/BTCPay.png" },
];

const projectFeatures = [
  "Organize Tasks under a Project Umbrella",
  "Set Project Budget Control Limits",
  "Invoice Completed Tasks with 1-Click",
  "Assign Tasks to Account Users",
  "Kanban Board Tasks Control",
];

const vendorFeatures = [
  "Easily Create & Manage Expenses",
  "Convert & Invoice Clients for Expenses",
  "Create Vendors & Organize Categories",
  "Expense Reporting, Vendor Statements",
  "Create & Email Purchase Orders to Vendors",
  "Convert Purchase Orders to Billable Expenses",
];

const testimonials = [
  {
    quote: "Invoice Ninja is a robust, flexible, yet surprisingly affordable invoicing and expense management tool that more than 200,000 sole proprietors and small business owners use every day\u2026",
    source: "CardRates.com",
    href: "https://www.cardrates.com/news/invoice-ninja-makes-getting-paid-seamless-for-smbs/",
  },
  {
    quote: "Invoice Ninja is well on its way to becoming one of the greats of the invoicing world! A great option for small business owners!",
    source: "Merchant Maverick",
    href: "https://www.merchantmaverick.com/review-category/invoicing-software/?sortby=rating&pagen=0",
  },
  {
    quote: "The best free invoice software is not only easy on the bank account but user-friendly and packed with the features!",
    source: "Forbes",
    href: "https://www.forbes.com/advisor/business/software/best-free-invoice-software/",
  },
  {
    quote: "2023 Best Invoicing for Freelancers. Invoice Ninja can give any other free invoicing and billing software a run for its money!",
    source: "Money.com",
    href: "https://money.com/best-invoicing-software/",
  },
];
---

<BaseLayout title="Product Overview" description="Make it easy for clients to pay you. Powerful apps to run your business: invoicing, quotes, payments, projects, tasks, expenses and more." path="/overview/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Make it easy for clients to pay you</h1>
      <p class="text-xl text-gray-600 mb-4">Powerful Apps to Run Your Business</p>
      <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-500 mb-8">
        <a href="#invoicing" class="hover:text-primary transition-colors">Invoicing, Quotes, Payments</a>
        <span class="text-gray-300">|</span>
        <a href="#projects" class="hover:text-primary transition-colors">Tasks & Projects</a>
        <span class="text-gray-300">|</span>
        <a href="#expenses" class="hover:text-primary transition-colors">Create Vendors & Track Expenses</a>
      </div>
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <Button href="https://app.invoicing.co/#/register" size="lg">Create a Free Account</Button>
        <Button href="https://react.invoicing.co/demo" variant="outline" size="lg">Try Demo</Button>
      </div>
      <img src="/images/home/Frame-37210.png" alt="Invoice Ninja product overview" class="w-full max-w-4xl mx-auto rounded-xl shadow-lg" loading="lazy" />
    </div>
  </section>

  <!-- Dynamic Dashboard -->
  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Apps to Run Your Business</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-dark">Create. Send. Get Paid.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <img src="/images/how-it-works/email-invoices-thumbnail.png" alt="Invoice Ninja dynamic dashboard" class="w-full rounded-xl shadow-lg" loading="lazy" />
        <div>
          <h3 class="text-2xl lg:text-3xl font-bold text-dark mb-6">Dynamic Dashboard</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Intuitive overview of all company activity</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Track upcoming & past due invoices, quotes</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Set dashboard data date-range parameters</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">View revenue, client activity, system logs</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Navigate through system logs & data records</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Invoicing Module -->
  <section id="invoicing" class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Invoicing, Quotes, Payments</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-dark">Create. Send. Get Paid.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl lg:text-3xl font-bold text-dark mb-6">Invoicing</h3>
          <div class="grid grid-cols-1 gap-3">
            {invoicingFeatures.map((feature) => (
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-sm text-gray-700">{feature}</span>
              </div>
            ))}
          </div>
          <a href="/invoicing/" class="inline-block mt-6 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
        <img src="/images/how-it-works/recurring-invoices.png" alt="Invoice Ninja invoicing" class="w-full rounded-xl shadow-lg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Quotations Module -->
  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <img src="/images/how-it-works/invoices.png" alt="Invoice Ninja quotations" class="w-full rounded-xl shadow-lg" loading="lazy" />
        <div>
          <h3 class="text-2xl lg:text-3xl font-bold text-dark mb-6">Quotations</h3>
          <div class="grid grid-cols-1 gap-3">
            {quotationFeatures.map((feature) => (
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-sm text-gray-700">{feature}</span>
              </div>
            ))}
          </div>
          <a href="/invoicing/" class="inline-block mt-6 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Payments Module -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h3 class="text-2xl lg:text-3xl font-bold text-dark mb-4">Payments</h3>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">When you email out an invoice, it's a 'payment gateway' that processes the payment. Invoice Ninja integrates payment gateways across the world, allowing your clients to pay an invoice in 1-click!</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
        {paymentGateways.map((gw) => (
          <div class="flex flex-col items-center gap-3 p-5 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-primary/20 transition-all">
            <img src={gw.logo} alt={gw.name} class="h-10 w-auto object-contain" loading="lazy" />
            <span class="text-sm font-medium text-gray-700">{gw.name}</span>
          </div>
        ))}
        <div class="flex flex-col items-center justify-center gap-3 p-5 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-primary/20 transition-all">
          <span class="text-2xl text-gray-400">+</span>
          <span class="text-sm font-medium text-gray-700">And More!</span>
        </div>
      </div>
      <p class="text-center mt-8">
        <a href="/payments/" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more about payments &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Projects, Tasks & Time Tracking -->
  <section id="projects" class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Create Projects, Tasks & Track Time</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-dark">Send billable-tasks to invoice with 1-click.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl lg:text-3xl font-bold text-dark mb-4">Projects</h3>
          <p class="text-gray-600 mb-6">Whether you bill by the minute, hour, or project, tracking tasks work-time allows you to speed up processes and bill clients accurately. All time is accurately recorded and can then be sent to an invoice with one-click.</p>
          <ul class="space-y-3">
            {projectFeatures.map((feature) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-sm text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
          <a href="/projects/" class="inline-block mt-6 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
        <img src="/images/how-it-works/track-work-tasks.png" alt="Projects, tasks and time tracking" class="w-full rounded-xl shadow-lg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Vendors & Expenses -->
  <section id="expenses" class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Create Vendors, PO's, Track Expenses</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-dark">Manage Vendors & Track Expenses</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <img src="/images/how-it-works/track-expanses.png" alt="Expense tracking and vendor management" class="w-full rounded-xl shadow-lg" loading="lazy" />
        <div>
          <h3 class="text-2xl lg:text-3xl font-bold text-dark mb-4">Track Vendors & Expenses</h3>
          <p class="text-gray-600 mb-6">With Invoice Ninja, all your earnings, expenses, clients and vendors are stored and managed in one, smart system designed to keep you on top of things.</p>
          <ul class="space-y-3">
            {vendorFeatures.map((feature) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-sm text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
          <a href="/expenses/" class="inline-block mt-6 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Testimonials -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-dark">Join over 200,000+ users that rely on Invoice Ninja</h2>
        <p class="mt-3 text-lg text-gray-500">See what the press is saying about Invoice Ninja</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {testimonials.map((t) => (
          <a href={t.href} target="_blank" rel="noopener noreferrer" class="block bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-lg hover:border-primary/20 transition-all duration-300">
            <div class="flex gap-1 mb-4">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-gray-600 leading-relaxed mb-4 text-sm">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <div class="text-sm font-semibold text-primary">{t.source}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-primary py-20 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">Start Invoicing Today!</h2>
      <p class="mt-4 text-lg text-white/80">Create. Send. Get Paid.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="https://app.invoicing.co/#/register"
          class="inline-block px-10 py-4 text-lg font-semibold text-primary bg-white rounded-xl hover:bg-gray-50 transition-all shadow-lg"
        >
          Create a Free Account
        </a>
        <a
          href="https://react.invoicing.co/demo"
          class="inline-block px-10 py-4 text-lg font-semibold text-white border-2 border-white/30 rounded-xl hover:bg-white/10 transition-all"
        >
          Test Drive!
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
