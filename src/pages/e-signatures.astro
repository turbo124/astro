---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="E-Signatures" description="Legally binding e-signatures with DocuNinja. Sign documents securely from anywhere." path="/e-signatures/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">E-Signatures</h1>
        <p class="text-xl text-gray-600">Legally binding e-signatures with DocuNinja. Sign documents securely from anywhere.</p>
      </div>

      <div class="prose prose-lg prose-gray max-w-none mx-auto">
        <p>This page is being migrated from WordPress. Full content coming soon.</p>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
