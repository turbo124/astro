---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const features = [
  {
    icon: "invoice",
    title: "Invoicing & Quotations",
    description: "Create professional invoices and quotes in seconds. Customize templates, set recurring schedules, and get paid faster.",
    href: "/invoicing",
  },
  {
    icon: "payment",
    title: "Online Payments",
    description: "Accept payments via Stripe, PayPal, GoCardless, and 10+ gateways. Auto-reconcile and reduce chasing.",
    href: "/payments",
  },
  {
    icon: "time",
    title: "Tasks & Projects",
    description: "Track time, manage tasks, and organize projects. Convert tracked hours directly into invoices.",
    href: "/projects",
  },
  {
    icon: "expense",
    title: "Expenses & Vendors",
    description: "Log expenses, manage vendors, and create purchase orders. Attach receipts and categorize spending.",
    href: "/expenses",
  },
  {
    icon: "bank",
    title: "Bank Integration",
    description: "Connect your bank accounts for automatic transaction import and seamless reconciliation.",
    href: "/banking",
  },
  {
    icon: "einvoice",
    title: "e-Invoicing",
    description: "Compliant e-invoicing for EU markets — Peppol, FatturaPA, Factur-X, and XRechnung ready.",
    href: "/e-invoicing",
  },
];

const stats = [
  { value: "400K+", label: "Businesses" },
  { value: "10M+", label: "Invoices Sent" },
  { value: "160+", label: "Countries" },
  { value: "100%", label: "Open Source" },
];

const testimonials = [
  {
    quote: "Invoice Ninja replaced three separate tools for us. Invoicing, time tracking, and expense management — all in one place.",
    author: "Sarah M.",
    role: "Freelance Designer",
  },
  {
    quote: "We self-host Invoice Ninja for complete data control. The flexibility and feature set rival tools costing 10x more.",
    author: "James K.",
    role: "Agency Owner",
  },
  {
    quote: "The recurring invoice feature alone saves me hours every month. Setup was instant and my clients love the payment portal.",
    author: "Maria L.",
    role: "Consultant",
  },
];

const iconPaths: Record<string, string> = {
  invoice: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  payment: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z",
  time: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  expense: "M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2v16z",
  bank: "M3 6l9-4 9 4v2H3V6zm1 4h4v8H4v-8zm6 0h4v8h-4v-8zm6 0h4v8h-4v-8zM2 20h20v2H2v-2z",
  einvoice: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
};
---

<BaseLayout title="Home" description="Invoice Ninja — Free open-source invoicing, payments, expenses & time-tracking for freelancers & businesses worldwide.">
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-white to-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-sm font-medium text-primary bg-primary/10 rounded-full">
          <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
          100% Free &amp; Open Source
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-dark leading-tight tracking-tight">
          Invoicing that
          <span class="text-primary"> works for you</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto">
          Create invoices, accept payments, track time and expenses — all from one powerful platform trusted by over 400,000 businesses worldwide.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/yes"
            class="w-full sm:w-auto px-8 py-4 text-base font-semibold text-white bg-primary rounded-xl hover:bg-primary-dark transition-all shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5"
          >
            Start for Free
          </a>
          <a
            href="/how-it-works"
            class="w-full sm:w-auto px-8 py-4 text-base font-semibold text-gray-700 bg-white rounded-xl border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-all"
          >
            See How It Works
          </a>
        </div>
        <p class="mt-4 text-sm text-gray-400">No credit card required. Free forever plan available.</p>
      </div>
    </div>
    <!-- Decorative gradient blob -->
    <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-t from-primary/5 to-transparent rounded-full blur-3xl pointer-events-none"></div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-white border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl lg:text-4xl font-extrabold text-primary">{stat.value}</div>
            <div class="mt-1 text-sm text-gray-500 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="bg-white py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-dark">Everything you need to run your business</h2>
        <p class="mt-4 text-lg text-gray-500">
          One platform for invoicing, payments, expenses, time tracking, and more.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <a
            href={feature.href}
            class="group p-6 rounded-2xl border border-gray-100 hover:border-primary/20 hover:shadow-lg hover:shadow-primary/5 transition-all duration-300"
          >
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary/10 text-primary mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[feature.icon]} />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-dark group-hover:text-primary transition-colors">
              {feature.title}
            </h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">
              {feature.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Highlight: Self-Host or Cloud -->
  <section class="bg-gray-50 py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-dark">
            Your data, your rules
          </h2>
          <p class="mt-4 text-lg text-gray-600 leading-relaxed">
            Choose cloud hosting for zero-maintenance convenience, or self-host for complete control over your data and privacy.
          </p>
          <ul class="mt-8 space-y-4">
            {[
              "Host on your own server with Docker or manual install",
              "Full source code on GitHub — audit, extend, contribute",
              "GDPR-compliant with data residency options",
              "White-label and customize to match your brand",
              "Migrate freely — no vendor lock-in, ever",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-600">{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/self-hosting-privacy-data-control" class="px-6 py-3 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors">
              Self-Host Guide
            </a>
            <a href="/pricing-plans" class="px-6 py-3 text-sm font-semibold text-primary border border-primary/30 rounded-lg hover:bg-primary/5 transition-colors">
              View Cloud Plans
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 lg:p-10">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
              <span class="ml-2 text-xs text-gray-400 font-mono">terminal</span>
            </div>
            <pre class="text-sm font-mono text-gray-600 leading-loose overflow-x-auto"><code><span class="text-gray-400">$</span> docker pull invoiceninja/invoiceninja
<span class="text-gray-400">$</span> docker compose up -d
<span class="text-green-500">✓</span> Invoice Ninja is running on <span class="text-primary">localhost:8080</span></code></pre>
          </div>
          <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-primary/10 rounded-2xl -z-10"></div>
          <div class="absolute -top-4 -left-4 w-16 h-16 bg-primary/5 rounded-xl -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-dark">Trusted by businesses worldwide</h2>
        <p class="mt-4 text-lg text-gray-500">See why over 400,000 businesses choose Invoice Ninja.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="flex gap-1 mb-4">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-gray-600 leading-relaxed mb-4">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <div>
              <div class="text-sm font-semibold text-dark">{t.author}</div>
              <div class="text-xs text-gray-400">{t.role}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-primary py-20 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">Ready to get started?</h2>
      <p class="mt-4 text-lg text-white/80">
        Join 400,000+ businesses using Invoice Ninja. Free forever, no credit card required.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/yes"
          class="w-full sm:w-auto px-8 py-4 text-base font-semibold text-primary bg-white rounded-xl hover:bg-gray-50 transition-all shadow-lg"
        >
          Start for Free
        </a>
        <a
          href="/self-hosting-privacy-data-control"
          class="w-full sm:w-auto px-8 py-4 text-base font-semibold text-white border-2 border-white/30 rounded-xl hover:bg-white/10 transition-all"
        >
          Self-Host Instead
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
