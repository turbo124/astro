---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/blog/BlogCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Invoicing tips, freelancing advice, and small business insights from Invoice Ninja."
  path="/blog/"
>
  <Header slot="header" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
    <header class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-dark mb-3">Blog</h1>
      <p class="text-lg text-gray-600">Tips and insights for freelancers and small business owners.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          slug={post.id}
          publishDate={post.data.publishDate}
          image={post.data.image}
          category={post.data.category}
        />
      ))}
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
