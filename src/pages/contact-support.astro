---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Contact & Support" description="Get in touch with the Invoice Ninja team. Email support, Slack community, Discord, and documentation." path="/contact-support/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Contact & Support</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">Get in touch with the Invoice Ninja team. Email support, Slack community, Discord, and documentation.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <h3 class="text-lg font-bold text-dark mb-2">Email Support</h3>
          <p class="text-sm text-gray-600 mb-3">For account and billing questions.</p>
          <a href="mailto:contact@invoiceninja.com" class="text-primary hover:underline text-sm">contact@invoiceninja.com</a>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <h3 class="text-lg font-bold text-dark mb-2">Slack Community</h3>
          <p class="text-sm text-gray-600 mb-3">5,000+ members. Get help from the community.</p>
          <a href="https://slack.invoiceninja.com/" class="text-primary hover:underline text-sm">Join Slack</a>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <h3 class="text-lg font-bold text-dark mb-2">Discord</h3>
          <p class="text-sm text-gray-600 mb-3">Chat with developers and other users.</p>
          <a href="https://discord.gg/ZwEdtfCwXA" class="text-primary hover:underline text-sm">Join Discord</a>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <h3 class="text-lg font-bold text-dark mb-2">Documentation</h3>
          <p class="text-sm text-gray-600 mb-3">User guide and API documentation.</p>
          <a href="https://invoiceninja.github.io/" class="text-primary hover:underline text-sm">View Docs</a>
        </div>
      </div>
      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
