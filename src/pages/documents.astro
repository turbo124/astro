---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const features = [
  "Legally binding e-signatures with single, multiple, co-signing, and sequential workflows",
  "Real-time document status tracking -- know when documents are opened, viewed, and signed",
  "Document analytics to track engagement and viewer activity",
  "Seamless Invoice Ninja integration -- attach signed contracts to invoices and request payments upon signature",
  "SOC 2, HIPAA, and GDPR compliance with data encryption and MFA",
  "Team roles and permissions for signers, approvers, and viewers",
  "Custom branding with your company logo, colors, and styling on every document",
  "Custom fields including checkboxes, dates, and text fields",
];

const enterpriseBlocks = [
  {
    title: "Unlock Documents After Payment",
    desc: "Restrict document downloads until after invoice payment is received. Lock deliverables or project files behind payment requirements, ensuring you get paid before clients access final assets.",
    image: null,
    reversed: false,
  },
  {
    title: "User Activity Notifications",
    desc: "Create additional user accounts with customizable permissions and receive activity notifications when other team members take actions. Stay informed about every document interaction across your organization.",
    image: null,
    reversed: true,
  },
  {
    title: "Client & Vendor Document Upload",
    desc: "Permit clients and vendors to upload documents directly to their respective portals, centralizing document management and agreements in one place. Simplify collaboration and reduce email back-and-forth.",
    image: null,
    reversed: false,
  },
  {
    title: "Banking Integration",
    desc: "Securely sync transactions from banks, credit cards, and PayPal via Yodlee. Includes autosync capability and automatic transaction-to-invoice matching to streamline reconciliation.",
    image: null,
    reversed: true,
  },
  {
    title: "Custom Domain URLs",
    desc: "Fully branded client portal URLs using your own custom domain (e.g., Billing.YourCompany.com) for a professional appearance. Strengthen your brand identity across every client touchpoint.",
    image: null,
    reversed: false,
  },
  {
    title: "File Attachments",
    desc: "Attach third-party files (.doc, .ppt, .xls, .jpg, .png, .pdf) at company, client, or invoice/expense levels. Keep all relevant documentation organized alongside your financial records.",
    image: null,
    reversed: true,
  },
  {
    title: "Additional Users & Permissions",
    desc: "Create multiple user accounts and configure granular permission levels for what each user can view, create, or edit. Receive notifications when team members take specific actions.",
    image: null,
    reversed: false,
  },
];
---

<BaseLayout title="DocuNinja" description="E-signing and document management integrated with Invoice Ninja. Send. eSign. Manage." path="/documents/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">DocuNinja</h1>
      <p class="text-xl text-gray-600 mb-4">Send. eSign. Manage. Without the hefty price tag.</p>
      <p class="text-gray-600 max-w-2xl mx-auto">E-signing and document management fully integrated with Invoice Ninja. Streamline your document workflows, collect legally binding signatures, and keep everything organized in one place.</p>
    </div>
  </section>

  <!-- Feature Highlights -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-8">Everything You Need for Document Management</h2>
      <ul class="space-y-4">
        {features.map((feature) => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-700">{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center bg-primary rounded-xl py-12 px-6">
        <h2 class="text-3xl font-bold text-white mb-2">Start Invoicing Today!</h2>
        <p class="text-lg text-white/90 mb-6">Invoice Clients, Get Paid Fast!</p>
        <Button href="https://app.invoicing.co/#/register" size="lg">Test Drive!</Button>
      </div>
    </div>
  </section>

  <!-- Enterprise Feature Detail Blocks -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-dark mb-4">Enterprise Plan Features</h2>
        <p class="text-gray-600">DocuNinja is available in-app for Enterprise Plan accounts. Unlock additional powerful features with Enterprise.</p>
      </div>

      <div class="space-y-16">
        {enterpriseBlocks.map((block) => (
          <div class={`grid md:grid-cols-2 gap-10 items-center ${block.reversed ? '' : ''}`}>
            <div class={block.reversed ? 'md:order-2' : ''}>
              <span class="inline-block px-3 py-1 text-xs font-semibold text-primary bg-primary/10 rounded-full mb-4">Enterprise</span>
              <h3 class="text-2xl font-bold text-dark mb-4">{block.title}</h3>
              <p class="text-gray-600">{block.desc}</p>
            </div>
            <div class={`bg-white rounded-xl border border-gray-200 p-8 flex items-center justify-center min-h-[200px] ${block.reversed ? 'md:order-1' : ''}`}>
              <div class="text-center">
                <svg class="w-16 h-16 text-primary/30 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                </svg>
                <p class="text-sm text-gray-400">{block.title}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
