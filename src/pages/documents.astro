---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const enterpriseFeatures = [
  { title: "Unlock Documents After Payment", desc: "Restrict document downloads until after invoice payment is received. Lock deliverables or project files behind payment requirements." },
  { title: "User Activity Notifications", desc: "Create additional user accounts with customizable permissions and activity notifications when other team members take actions." },
  { title: "Client & Vendor Document Upload", desc: "Permit clients and vendors to upload documents to their respective portals, centralizing document management and agreements." },
  { title: "Banking Integration", desc: "Securely sync transactions from banks, credit cards, and PayPal via Yodlee. Includes autosync capability and transaction-to-invoice matching." },
  { title: "Custom Domain URLs", desc: "Fully branded client portal URLs using your own custom domain (e.g. Billing.YourCompany.com) for a professional appearance." },
  { title: "File Attachments", desc: "Attach third-party files (.doc, .ppt, .xls, .jpg, .png, .pdf) at company, client, or invoice/expense levels." },
  { title: "Additional Users & Permissions", desc: "Create multiple user accounts, configure permission levels for what each user can view, create, or edit, and receive action notifications." },
];

const faqs = [
  {
    q: "What is free invoicing software?",
    a: "Free invoicing software is an easier, faster, and smarter way to get paid, issuing professional, customized, and official invoice documentation to your clients in seconds -- leaving you free to concentrate on everything else.",
  },
  {
    q: "Is invoicing software secure?",
    a: "We take security seriously and provide invoicing software with the latest data protection and cybersecurity safeguards to protect your information, billing details, and client contact information. Issuing invoices through our secure portal is massively safer than attaching invoice files to emails, which are vulnerable to hacking and data breaches as they travel from one server to the next.",
  },
];
---

<BaseLayout title="DocuNinja" description="E-signing and document management integrated with Invoice Ninja. Send. eSign. Manage." path="/documents/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">DocuNinja</h1>
        <p class="text-xl text-gray-600">Send. eSign. Manage. Without the hefty price tag.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {[
          { title: "E-Signatures", desc: "Legally binding e-signatures with single, multiple, co-signing, and sequential workflows." },
          { title: "Document Analytics", desc: "Track who opens, views, and engages with your documents." },
          { title: "Invoice Ninja Integration", desc: "Attach signed contracts to invoices and request payments upon signature." },
          { title: "Real-Time Document Status Tracking", desc: "Monitor document progress in real time -- know exactly when documents are opened, viewed, and signed." },
          { title: "Security & Compliance", desc: "SOC 2, HIPAA, and GDPR compliance. Data encryption & MFA." },
          { title: "Team Roles & Permissions", desc: "Assign roles for signers, approvers, and viewers." },
          { title: "Custom Branding", desc: "Add your company logo, colors, and branding to every document." },
          { title: "Custom Fields", desc: "Add custom field options including checkboxes, dates, and text fields to your documents." },
        ].map((f) => (
          <div class="p-6 rounded-xl border border-gray-200">
            <h3 class="text-lg font-bold text-dark mb-2">{f.title}</h3>
            <p class="text-sm text-gray-600">{f.desc}</p>
          </div>
        ))}
      </div>

      <div class="prose prose-lg max-w-none">
        <h2>Pre-Built Templates</h2>
        <p>10 professional document templates included: Contractor Agreements, NDAs, Partnership Agreements, Sales Contracts, Scope of Work, Service Agreements, and more.</p>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started</Button>
      </div>
    </div>
  </section>

  <!-- Enterprise Plan Callout -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-dark mb-4">Enterprise Plan Features</h2>
        <p class="text-gray-600">DocuNinja is available in-app for Enterprise Plan accounts. Unlock additional powerful features with Enterprise.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {enterpriseFeatures.map((f) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white">
            <h3 class="text-lg font-bold text-dark mb-2">{f.title}</h3>
            <p class="text-sm text-gray-600">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-4">Frequently Asked Questions</h2>
      <p class="text-center text-gray-500 mb-10">Everything you need to know about DocuNinja and Invoice Ninja.</p>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-semibold text-dark hover:bg-gray-50 transition-colors">
              {faq.q}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4">
              <p class="text-sm text-gray-600">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
