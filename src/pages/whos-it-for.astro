---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const audiences = [
  {
    subtitle: "Serving freelancers, service providers & SMB's",
    title: "Freelancers, tradesmen, consultants, coaches, business services, 'gig economy' providers",
    description: "Impress clients with professionally designed invoices that match your brand. Accept credit cards, ACH payments, and send automated late-payment reminders. With Invoice Ninja, getting paid is effortless.",
  },
  {
    subtitle: "A suite of tools to advance your business",
    title: "IT experts, developers, web designers, media & digital marketers, tech services",
    description: "Your clients can access their client-side portal to view all invoices, payment history, documents, and much more. With every dollar, every invoice, every task accounted for, you and your clients will always know where business stands.",
  },
  {
    subtitle: "Invoice Ninja is incredibly easy to use",
    title: "Wholesalers, transportation, construction, manufacturing, logistics, non-profits",
    description: "Ditch the spreadsheets and disconnected tools. Invoice Ninja brings invoicing, expenses, time-tracking, and payments into one incredibly easy-to-use platform — so you can focus on running your business.",
  },
];

const testimonials = [
  {
    quote: "Invoice Ninja is a robust, flexible, yet surprisingly affordable invoicing and expense management tool that more than 200,000 sole proprietors and small business owners use every day…",
    source: "CardRates.com",
  },
  {
    quote: "Invoice Ninja is well on its way to becoming one of the greats of the invoicing world! A great option for small business owners!",
    source: "Merchant Maverick",
  },
  {
    quote: "The best free invoice software is not only easy on the bank account but user-friendly and packed with the features!",
    source: "Forbes",
  },
  {
    quote: "Invoice Ninja is an excellent alternative for small businesses that want a free, full-featured invoicing solution.",
    source: "Money.com",
  },
];

const userTestimonials = [
  { name: "Alberto O.", quote: "I love this app! It's simple and easy to use." },
  { name: "Aslan C.", quote: "Best invoicing software I've ever used." },
  { name: "Aaron L.", quote: "Great tool for freelancers. Highly recommended!" },
  { name: "Kyle G.", quote: "Saves me hours every week on invoicing." },
  { name: "Joseph S.", quote: "The client portal is a game changer." },
  { name: "Robbe D.", quote: "Perfect for small businesses. Love the recurring invoices." },
];

const enterpriseFeatures = [
  { title: "Unlock Documents After Payment", desc: "Restrict document access until invoices are paid." },
  { title: "Additional Users Activity Notification Settings", desc: "Get notified when team members perform actions." },
  { title: "Client-Portal & Vendor Document Upload", desc: "Allow clients and vendors to upload documents directly." },
  { title: "Additional Users & Set Permissions", desc: "Add team members with granular role-based permissions." },
  { title: "Banking Integration", desc: "Automatically import bank, credit card and PayPal transactions via Yodlee partnership." },
  { title: "Custom Domain", desc: 'Use your own domain for the client portal: "Billing.YourCompany.com".' },
  { title: "Attach 3rd Party Files to Invoices & Expenses", desc: "Link external files to any invoice or expense record." },
];

const proFeatures = [
  { title: "Custom Client-Portal Subdomain", desc: "Brand your client portal with a custom subdomain." },
  { title: "Storefront Functionality", desc: "Create a storefront for products and services." },
  { title: "Automated Workflow", desc: "Integrate with Zapier, Make, Pabbly and hundreds of other apps." },
  { title: "Custom Reminder Emails", desc: "Set up automated reminder schedules for unpaid invoices." },
  { title: "Custom Invoice Email Design", desc: "Design branded email templates for your invoices." },
  { title: "BCC Address for Invoices & Quotes", desc: "Automatically BCC an address on all outgoing emails." },
  { title: "Custom Invoice & Quote Number Sequencing", desc: "Set custom numbering patterns for invoices and quotes." },
  { title: "Automatic Late Fees on Unpaid Invoices", desc: "Automatically apply late fees to overdue invoices." },
  { title: "Create Reports, Accounts Aging & Client Statements", desc: "Generate detailed financial reports and client statements." },
  { title: "Enable Invoice Approval Checkbox or Client Signature", desc: "Require client approval or e-signature on invoices." },
  { title: "Customize Email Subjects & Body Text", desc: "Personalize every email that goes out." },
  { title: "11 Customizable Invoice Template Designs", desc: "Choose from 11 professionally designed templates." },
  { title: "Attach Invoice & Quotation PDFs to Emails", desc: "Automatically attach PDF files to outgoing emails." },
  { title: "Create Client Subscriptions: Recurring & Auto-Billing", desc: "Set up recurring billing with auto-charge." },
  { title: 'Create "Client Groups" Workflow Settings', desc: "Group clients with shared settings and defaults." },
  { title: "Send Invoices via Gmail & MSN Accounts", desc: "Send directly from your own email account." },
  { title: "Custom Fields & Invoice Designs", desc: "Add custom fields and design your own invoice layouts." },
  { title: "Link Multiple Companies (x10) with 1 Login", desc: "Manage up to 10 companies from a single login." },
];

const freeFeatures = [
  { title: "Live PDF Invoice Preview", desc: "See a real-time preview of your invoice as you build it." },
  { title: "Overpayment & Underpayment Settings", desc: "Handle partial and excess payments automatically." },
  { title: "Localization of Language & Currency Settings", desc: "Support for multiple languages and currencies." },
  { title: "Vendor Purchase Orders", desc: "Create and manage purchase orders for vendors." },
  { title: "Kanban Boards to Manage Projects", desc: "Visual project management with drag-and-drop boards." },
  { title: "Multiple Contacts Per Client", desc: "Add multiple contacts to each client record." },
  { title: "Custom Payment Instructions", desc: "Add custom payment instructions to invoices." },
  { title: "Enabling/Disabling Nav Modules", desc: "Customize the interface by toggling features on/off." },
  { title: "Create Taxes per Invoice Total or Line-Item", desc: "Flexible tax configuration per invoice or per line item." },
  { title: "Setup Automatic Credit Card Gateway Fees", desc: "Pass processing fees to clients automatically." },
  { title: "Bulk Emailing Invoices & Quotations", desc: "Send multiple invoices and quotes in one click." },
  { title: "Multiple Currencies & Languages", desc: "Invoice clients in their own language and currency." },
  { title: "Importing Expenses & Vendors", desc: "Import data from CSV and other formats." },
  { title: "Item & Product Library System", desc: "Build a reusable library of products and services." },
];

const connectCards = [
  { title: "Ninja Support Forums", desc: "Get help from the community and our support team.", cta: "Launch Forums!", href: "https://forum.invoiceninja.com" },
  { title: "Contact Email", desc: "Reach us directly at Contact@invoiceninja.com", cta: "Email Us", href: "mailto:contact@invoiceninja.com" },
  { title: "Slack Community", desc: "Join 5,000+ members in our Slack community.", cta: "Join Slack", href: "https://invoiceninja.slack.com" },
];
---

<BaseLayout title="Who's It For?" description="Freelancers, consultants, contractors, and small business owners who need to invoice clients and get paid fast." path="/whos-it-for/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Who's it for?</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">Do you have clients you need to invoice? Invoice Ninja is your solution to get paid.</p>
      <Button href="https://react.invoicing.co/demo" size="lg">Test Drive!</Button>
    </div>
  </section>

  <!-- Target Audiences -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 space-y-16">
      {audiences.map((audience, i) => (
        <div class={`grid md:grid-cols-2 gap-10 items-center ${i % 2 === 1 ? 'md:direction-rtl' : ''}`}>
          <div class={i % 2 === 1 ? 'md:order-2' : ''}>
            <p class="text-sm font-semibold text-primary mb-2">{audience.subtitle}</p>
            <h2 class="text-2xl font-bold text-dark mb-4">{audience.title}</h2>
            <p class="text-gray-600 leading-relaxed mb-6">{audience.description}</p>
            <Button href="https://app.invoicing.co/#/register">Get Started Free</Button>
          </div>
          <div class={`bg-gray-50 rounded-2xl p-8 aspect-square flex items-center justify-center ${i % 2 === 1 ? 'md:order-1' : ''}`}>
            <img src="/images/home/Frame-37210.png" alt={audience.subtitle} class="w-full rounded-lg" loading="lazy" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Social Proof -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-12">Join over 200,000+ users that rely on Invoice Ninja</h2>

      <!-- Press Testimonials -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        {testimonials.map((t) => (
          <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">&ldquo;{t.quote}&rdquo;</p>
            <p class="text-xs font-bold text-primary">{t.source}</p>
          </div>
        ))}
      </div>

      <!-- User Testimonials -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {userTestimonials.map((t) => (
          <div class="bg-white rounded-xl p-5 border border-gray-100 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center shrink-0">
              {t.name.charAt(0)}
            </div>
            <div>
              <p class="text-sm text-gray-600 mb-2">&ldquo;{t.quote}&rdquo;</p>
              <p class="text-xs font-semibold text-dark">{t.name}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Let's Connect -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-10">Let's Connect!</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {connectCards.map((card) => (
          <div class="bg-white rounded-xl p-6 border border-gray-200 text-center hover:border-primary/30 hover:shadow-lg transition-all">
            <h3 class="text-lg font-bold text-dark mb-2">{card.title}</h3>
            <p class="text-sm text-gray-500 mb-4">{card.desc}</p>
            <a href={card.href} class="inline-block px-5 py-2 text-sm font-semibold text-primary border border-primary rounded-lg hover:bg-primary hover:text-white transition-colors">
              {card.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-primary py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Start Invoicing Today!</h2>
      <p class="text-lg text-white/80 mb-8">Invoice Clients, Get Paid Fast!</p>
      <a href="https://react.invoicing.co/demo" class="inline-block px-10 py-4 text-lg font-semibold text-primary bg-white rounded-xl hover:bg-gray-50 transition-all shadow-lg">
        Test Drive!
      </a>
    </div>
  </section>

  <!-- Feature Showcase: Enterprise -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-4">Enterprise Ninja Features</h2>
      <p class="text-center text-gray-500 mb-10">Advanced features for growing teams and businesses.</p>
      <div class="space-y-4">
        {enterpriseFeatures.map((f) => (
          <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-semibold text-dark hover:bg-gray-50 transition-colors">
              {f.title}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4">
              <p class="text-sm text-gray-600 mb-3">{f.desc}</p>
              <a href="https://app.invoicing.co/#/register" class="text-xs font-semibold text-primary hover:text-primary-dark transition-colors">Create a Free Account! &rarr;</a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature Showcase: Pro -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-4">Ninja Pro Features</h2>
      <p class="text-center text-gray-500 mb-10">Professional tools to grow your business.</p>
      <div class="space-y-4">
        {proFeatures.map((f) => (
          <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-semibold text-dark hover:bg-gray-50 transition-colors">
              {f.title}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4">
              <p class="text-sm text-gray-600 mb-3">{f.desc}</p>
              <a href="https://app.invoicing.co/#/register" class="text-xs font-semibold text-primary hover:text-primary-dark transition-colors">Create a Free Account! &rarr;</a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature Showcase: Free -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark text-center mb-4">Forever Free Features</h2>
      <p class="text-center text-gray-500 mb-10">All of these features are included free, forever.</p>
      <div class="space-y-4">
        {freeFeatures.map((f) => (
          <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-semibold text-dark hover:bg-gray-50 transition-colors">
              {f.title}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4">
              <p class="text-sm text-gray-600 mb-3">{f.desc}</p>
              <a href="https://app.invoicing.co/#/register" class="text-xs font-semibold text-primary hover:text-primary-dark transition-colors">Create a Free Account! &rarr;</a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
