---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/ui/Card.astro';

const integrations = (await getCollection('software'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  title="Software Integrations"
  description="Connect Invoice Ninja with your favorite tools and automate your workflow."
  path="/software/"
>
  <Header slot="header" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
    <header class="mb-12 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-dark mb-3">Software Integrations</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Connect Invoice Ninja with your favorite tools to automate your invoicing workflow.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {integrations.map((sw) => (
        <Card href={`/software/${sw.id}/`}>
          <div class="flex items-center gap-4 mb-4">
            <img src={sw.data.logo} alt={sw.data.title} class="h-10 w-10 object-contain" />
            <div>
              <h3 class="text-lg font-bold text-dark">{sw.data.title}</h3>
              <span class="text-xs text-gray-400 capitalize">{sw.data.category}</span>
            </div>
          </div>
          <p class="text-sm text-gray-500">{sw.data.description}</p>
        </Card>
      ))}
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
