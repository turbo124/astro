---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Steps from "../components/home/Steps.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="How It Works" description="4 steps to start invoicing and get paid online with Invoice Ninja." path="/how-it-works/">
  <Header slot="header" />

  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">How It Works</h1>
      <p class="text-xl text-gray-600 mb-8">Create. Send. Get Paid.</p>
      <img src="/images/how-it-works/create.png" alt="Create invoices" class="w-24 h-24 mx-auto" loading="lazy" />
    </div>
  </section>

  <!-- Reuse the same Steps component from the homepage -->
  <Steps />

  <!-- Everything you need -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-16 text-center">Everything you need</h2>

      <!-- Feature 1: Email Invoices -->
      <div class="grid md:grid-cols-2 gap-10 items-center mb-16">
        <div>
          <h3 class="text-2xl font-bold text-dark mb-4">Email invoices & quotes</h3>
          <p class="text-gray-600 mb-4">Create & email professional invoices in seconds. Accept deposits & partial payments. Multi-currency & multi-language per client.</p>
          <a href="/invoicing/" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
        <img src="/images/how-it-works/email-invoices-thumbnail.png" alt="Email invoices" class="w-full rounded-xl shadow-lg" loading="lazy" />
      </div>

      <!-- Feature 2: Recurring Invoices -->
      <div class="grid md:grid-cols-2 gap-10 items-center mb-16">
        <img src="/images/how-it-works/recurring-invoices.png" alt="Recurring invoices" class="w-full rounded-xl shadow-lg md:order-first" loading="lazy" />
        <div>
          <h3 class="text-2xl font-bold text-dark mb-4">Recurring invoicing</h3>
          <p class="text-gray-600 mb-4">Automate your billing with recurring invoices and auto-billing. Set it and forget it — get paid on time, every time.</p>
          <a href="/features/" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
      </div>

      <!-- Feature 3: Track Work & Tasks -->
      <div class="grid md:grid-cols-2 gap-10 items-center mb-16">
        <div>
          <h3 class="text-2xl font-bold text-dark mb-4">Time-tasks & projects</h3>
          <p class="text-gray-600 mb-4">Record hours on individual tasks. Transfer tracked time directly to invoices. Kanban board project management.</p>
          <a href="/projects/" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
        <img src="/images/how-it-works/track-work-tasks.png" alt="Track work tasks" class="w-full rounded-xl shadow-lg" loading="lazy" />
      </div>

      <!-- Feature 4: Track Expenses -->
      <div class="grid md:grid-cols-2 gap-10 items-center mb-16">
        <img src="/images/how-it-works/track-expanses.png" alt="Track expenses" class="w-full rounded-xl shadow-lg md:order-first" loading="lazy" />
        <div>
          <h3 class="text-2xl font-bold text-dark mb-4">Expenses & vendors</h3>
          <p class="text-gray-600 mb-4">Track all expenses in a unified system. Categorize vendors & re-invoice expenses. Generate expense reports.</p>
          <a href="/expenses/" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">Learn more &rarr;</a>
        </div>
      </div>

      <div class="text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
