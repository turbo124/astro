---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Steps from "../components/home/Steps.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="How It Works" description="4 steps to start invoicing and get paid online with Invoice Ninja." path="/how-it-works/">
  <Header slot="header" />

  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">How It Works</h1>
      <p class="text-xl text-gray-600">4 simple steps to start invoicing and get paid online.</p>
    </div>
  </section>

  <!-- Reuse the same Steps component from the homepage -->
  <Steps />

  <!-- Additional detail sections -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-dark mb-8 text-center">Core Invoicing Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="p-6 bg-white rounded-xl border border-gray-100">
          <h3 class="text-lg font-bold text-dark mb-3">Invoicing</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Create & email professional invoices in seconds
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Recurring invoicing with auto-billing
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Convert billable tasks to invoices with one click
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Accept deposits & partial payments
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Multi-currency & multi-language per client
            </li>
          </ul>
        </div>
        <div class="p-6 bg-white rounded-xl border border-gray-100">
          <h3 class="text-lg font-bold text-dark mb-3">Expenses & Vendors</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Track all expenses in a unified system
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Categorize vendors & re-invoice expenses
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Generate expense reports
            </li>
          </ul>
        </div>
        <div class="p-6 bg-white rounded-xl border border-gray-100">
          <h3 class="text-lg font-bold text-dark mb-3">Time Tracking & Projects</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Record hours on individual tasks
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Transfer tracked time directly to invoices
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Kanban board project management
            </li>
          </ul>
        </div>
        <div class="p-6 bg-white rounded-xl border border-gray-100">
          <h3 class="text-lg font-bold text-dark mb-3">Free Plan Extras</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              PDF invoice preview
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Vendor purchase orders
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Product library & inventory
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Client notifications for views & payments
            </li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
