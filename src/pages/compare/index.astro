---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout title="Compare Invoice Ninja" description="See how Invoice Ninja compares to FreshBooks, QuickBooks, Xero, Zoho and more." path="/compare/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Overpaying, just to get paid?</h1>
        <p class="text-xl text-gray-600">See how Invoice Ninja stacks up against the competition.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="py-4 pr-4 text-sm font-semibold text-gray-700">Software</th>
              <th class="py-4 text-sm font-semibold text-gray-700 text-right">Annual Cost</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100 bg-primary/5">
              <td class="py-4 pr-4 font-bold text-primary">Invoice Ninja Pro</td>
              <td class="py-4 text-right font-bold text-primary">$140</td>
            </tr>
            {[
              ["FreshBooks", "$756"], ["Invoice2Go", "$450"], ["HiveAge", "$504+"],
              ["Invoicely", "$288"], ["QuickBooks", "$1,188"], ["Xero", "$960"],
              ["Invoiced", "$6,000"], ["Zoho", "$468"],
            ].map(([name, price]) => (
              <tr class="border-b border-gray-100">
                <td class="py-4 pr-4 text-gray-700">{name}</td>
                <td class="py-4 text-right text-gray-700">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
