---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Download Apps" description="Download Invoice Ninja for iOS, Android, macOS, Windows, and Linux." path="/download-apps/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Download Invoice Ninja</h1>
        <p class="text-xl text-gray-600">Available on every platform. Auto-syncing across all devices.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl border border-gray-200 text-center">
          <h3 class="text-xl font-bold text-dark mb-6">Mobile</h3>
          <div class="space-y-4">
            <a href="https://apps.apple.com/app/id1503970375?platform=iphone" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">iOS — App Store</a>
            <a href="https://play.google.com/store/apps/details?id=com.invoiceninja.app" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Android — Google Play</a>
            <a href="https://f-droid.org/en/packages/com.invoiceninja.app" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Android — F-Droid</a>
          </div>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 text-center">
          <h3 class="text-xl font-bold text-dark mb-6">Desktop</h3>
          <div class="space-y-4">
            <a href="https://apps.apple.com/app/id1503970375?platform=mac" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">macOS — App Store</a>
            <a href="https://apps.microsoft.com/store/detail/invoice-ninja/9N3F2BBCFDR6" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Windows — Microsoft Store</a>
            <a href="https://flathub.org/apps/com.invoiceninja.InvoiceNinja" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Linux — Flathub</a>
            <a href="https://snapcraft.io/invoiceninja" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Linux — Snapcraft</a>
          </div>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 text-center">
          <h3 class="text-xl font-bold text-dark mb-6">Web & Extensions</h3>
          <div class="space-y-4">
            <a href="https://app.invoicing.co" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Web App</a>
            <a href="https://chromewebstore.google.com/detail/invoice-ninja-tasks/dlfcbfdpemfnjbjlladogijcchfmmaaf" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">Chrome Extension</a>
            <a href="https://wordpress.org/plugins/invoiceninja/" class="block p-3 rounded-lg bg-gray-50 hover:bg-primary/5 text-sm font-medium text-gray-700 hover:text-primary transition-colors">WordPress Plugin</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
