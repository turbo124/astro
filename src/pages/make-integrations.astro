---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Make (Integromat) Integration" description="Visual automation platform connecting Invoice Ninja with hundreds of apps." path="/make-integrations/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Make Integration</h1>
        <p class="text-xl text-gray-600">Design, build, and automate workflows visually with Make (formerly Integromat).</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {[
          { title: "Visual Builder", desc: "Drag-and-drop scenario builder for complex workflows." },
          { title: "Real-time Execution", desc: "Workflows run instantly when triggered." },
          { title: "Error Handling", desc: "Built-in error handling and retry logic." },
          { title: "Data Transformation", desc: "Transform and map data between apps." },
        ].map((f) => (
          <div class="p-6 rounded-xl border border-gray-200">
            <h3 class="text-lg font-bold text-dark mb-2">{f.title}</h3>
            <p class="text-sm text-gray-600">{f.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
