---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const section1 = [
  {
    q: "Is Invoice Ninja really FREE?",
    a: "Yes! Invoice Ninja offers a forever-free plan with unlimited invoicing.",
  },
  {
    q: "Is Invoice Ninja PCI compliant & secure?",
    a: "Yes! We use the latest security safeguards to protect your data.",
  },
  {
    q: "Can I upload my logo and customize colors to match my brand?",
    a: "Yes! Fully customize invoices with your logo, colors, and fonts.",
  },
  {
    q: "Can I integrate multiple payment gateways at the same time?",
    a: "Yes! Stripe, PayPal, Square, and more — all simultaneously.",
  },
  {
    q: "Can I set minimums & maximums for credit card payments?",
    a: "Yes! Configure minimum and maximum payment amounts.",
  },
  {
    q: "Can I pass along the credit card processing fee % to my clients?",
    a: "Yes! Automatically add a surcharge to pass fees to clients.",
  },
  {
    q: "Can I attach additional files & docs to invoices & quote emails?",
    a: "Yes! Attach any files directly to invoice and quote emails.",
  },
  {
    q: "Can I add account users & set permissions on what they view or create?",
    a: "Yes! Invite team members with granular permissions.",
  },
  {
    q: "Does Invoice Ninja offer inventory management that updates as I create invoices?",
    a: "Yes! Stock levels update automatically with each invoice.",
  },
  {
    q: "Does Invoice Ninja offer a client-side portal for viewing quotes and paying invoices?",
    a: "Yes! Clients get their own secure portal.",
  },
  {
    q: "Does Invoice Ninja offer an e-signature feature to display client signatures on invoices?",
    a: "Yes! Clients can sign invoices electronically.",
  },
  {
    q: "Can I enable an 'accept terms' checkbox before clients pay?",
    a: "Yes! Require clients to accept terms before payment.",
  },
  {
    q: "Can I email invoices to multiple client email contacts at the same time?",
    a: "Yes! Send to multiple contacts for the same client.",
  },
  {
    q: "Can clients approve quotes to convert them into payable invoices?",
    a: "Yes! Approved quotes automatically convert into invoices.",
  },
  {
    q: "Can I set different currencies for different clients?",
    a: "Yes! Assign unique currencies to individual clients.",
  },
  {
    q: "Can I be notified when my clients view or pay invoices?",
    a: "Yes! Get real-time notifications on views and payments.",
  },
  {
    q: "Can I set 'inclusive' or 'exclusive' taxes per client or invoice?",
    a: "Yes! Configure tax-inclusive or tax-exclusive pricing.",
  },
  {
    q: "Can I set multiple taxes per line-item or per invoice total?",
    a: "Yes! Apply multiple tax rates per line item or invoice total.",
  },
  {
    q: "Can Invoice Ninja automate taxation based on my client's location?",
    a: "Yes! Tax rates are calculated automatically by location.",
  },
];

const section2 = [
  {
    q: "Can I integrate with 3rd party tools via Zapier.com or Make.com?",
    a: "Yes! Connect to thousands of apps through Zapier and Make.com.",
  },
  {
    q: "Can I export all our data any time we want?",
    a: "Yes! Export everything at any time in standard formats.",
  },
  {
    q: "Can I deliver finished work to our clients via Invoice Ninja?",
    a: "Yes! Attach deliverables directly to invoices.",
  },
  {
    q: "Can I use Invoice Ninja without a long-term agreement?",
    a: "Yes! No contracts — use month-to-month and cancel anytime.",
  },
  {
    q: "Can I run simultaneous projects on Invoice Ninja?",
    a: "Yes! Manage multiple projects at the same time.",
  },
  {
    q: "Can I create vendors to enter expenses per vendor?",
    a: "Yes! Set up vendor profiles and categorize expenses.",
  },
  {
    q: "Can I create purchase orders that I can email out to vendors?",
    a: "Yes! Generate and email purchase orders to vendors.",
  },
  {
    q: "Can I create expenses for reporting and/or re-billing to clients?",
    a: "Yes! Log expenses and optionally re-invoice them to clients.",
  },
  {
    q: "Can I assign different account users to projects or tasks?",
    a: "Yes! Assign team members to specific projects or tasks.",
  },
  {
    q: "Can I create P&L reports, payments & invoice reports, and client reports?",
    a: "Yes! Generate P&L statements, payment summaries, and client reports.",
  },
  {
    q: "Can I create projects & time-track billable tasks?",
    a: "Yes! Log billable hours and convert tracked time into invoices.",
  },
  {
    q: "Does Invoice Ninja offer Kanban boards to visually manage projects?",
    a: "Yes! Use drag-and-drop Kanban boards for project management.",
  },
  {
    q: "Can I send out invoices via Gmail or MSN accounts?",
    a: "Yes! Connect your Gmail or Microsoft account to send invoices.",
  },
  {
    q: "Can Invoice Ninja automate invoice past-due payment reminder emails?",
    a: "Yes! Set up automated reminder schedules for overdue payments.",
  },
  {
    q: "Does Invoice Ninja have an API?",
    a: "Yes! A full REST API for custom integrations and automation.",
  },
  {
    q: "Does Invoice Ninja offer desktop apps, mobile apps, and Chrome extensions?",
    a: "Yes! Native apps for desktop, iOS, Android, and Chrome.",
  },
];
---

<BaseLayout title="Yes!" description="With Invoice Ninja, the answer is always YES! Free invoicing, PCI compliant, multi-currency, payment gateways, and 35+ features." path="/yes/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl lg:text-6xl font-bold text-dark mb-6">Yes!</h1>
      <p class="text-xl lg:text-2xl text-gray-600 max-w-2xl mx-auto mb-8">With Invoice Ninja, the answer is always <strong class="text-primary">YES!</strong></p>
      <Button href="https://app.invoicing.co/#/register" size="lg">YES!</Button>
    </div>
  </section>

  <!-- Section 1: Core Invoicing & Billing -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-4 text-center">YES!</h2>
      <p class="text-gray-500 text-center mb-10">Everything you need to create, send, and get paid.</p>

      <div class="space-y-3">
        {section1.map((item) => (
          <details class="group border border-gray-200 rounded-lg overflow-hidden hover:border-primary/40 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 bg-white hover:bg-gray-50 transition-colors">
              <span class="font-medium text-dark pr-4">{item.q}</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 pt-1 text-gray-600 border-t border-gray-100">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Integrations, Projects & Reporting -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-4 text-center">YES!</h2>
      <p class="text-gray-500 text-center mb-10">Power tools for growing businesses.</p>

      <div class="space-y-3">
        {section2.map((item) => (
          <details class="group border border-gray-200 rounded-lg overflow-hidden hover:border-primary/40 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 bg-white hover:bg-gray-50 transition-colors">
              <span class="font-medium text-dark pr-4">{item.q}</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 pt-1 text-gray-600 border-t border-gray-100">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Start Invoicing Today!</h2>
      <p class="text-xl text-gray-600 mb-8">Create. Send. Get Paid.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="https://app.invoicing.co/#/register" size="lg">Sign Up</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
