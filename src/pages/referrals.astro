---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Referral Program" description="Earn 50% commission on all referrals for 3 years. Share Invoice Ninja and get paid." path="/referrals/">
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 bg-gradient-to-br from-[#1e293b] to-[#0f172a] overflow-hidden">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">Get Paid While Getting Paid</h1>
      <p class="text-xl lg:text-2xl text-gray-300 mb-8">With our referral program, earn 50% on all referrals for three years!!!</p>
      <Button href="https://app.invoicing.co/#/register" size="lg">Get Started!</Button>
    </div>
  </section>

  <!-- $7,000 Earnings Highlight -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-6xl lg:text-8xl font-bold text-primary mb-6">$7,000!</p>
      <p class="text-xl lg:text-2xl text-gray-700 max-w-3xl mx-auto">If you sign up 100 Pro Plan Users from your referral URL that would be <strong>$7,000/year</strong> commission earned, recurring every year!</p>
    </div>
  </section>

  <!-- 3-Step Process -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark text-center mb-12">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-primary text-white text-2xl font-bold flex items-center justify-center mx-auto mb-4">1</div>
          <h3 class="text-xl font-bold text-dark mb-2">Sign Up</h3>
          <p class="text-gray-600">Create your free Invoice Ninja account and confirm your email address.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-primary text-white text-2xl font-bold flex items-center justify-center mx-auto mb-4">2</div>
          <h3 class="text-xl font-bold text-dark mb-2">Share Link</h3>
          <p class="text-gray-600">Find your referral URL in Settings &gt; Account Management &gt; Referral Program.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-primary text-white text-2xl font-bold flex items-center justify-center mx-auto mb-4">3</div>
          <h3 class="text-xl font-bold text-dark mb-2">Get Paid</h3>
          <p class="text-gray-600">Earn 50% commissions recurring for 3 years on every referral that upgrades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Case Examples -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark text-center mb-12">Use Case Examples</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-8 text-center">
          <div class="text-4xl mb-4">&#9993;</div>
          <h3 class="text-xl font-bold text-dark mb-3">Email Signatures</h3>
          <p class="text-gray-600">Hyperlink your referral URL in your email signature and newsletters. Every email you send becomes an opportunity to earn.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center">
          <div class="text-4xl mb-4">&#128176;</div>
          <h3 class="text-xl font-bold text-dark mb-3">Invoice & Payment Emails</h3>
          <p class="text-gray-600">Include your referral link when sending invoices and payment reminders to clients. They already trust your recommendations.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center">
          <div class="text-4xl mb-4">&#128221;</div>
          <h3 class="text-xl font-bold text-dark mb-3">Blog Articles</h3>
          <p class="text-gray-600">Write compelling articles about invoicing and embed your referral link. Content marketing that pays you back.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Promotional Image -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <img
        src="/images/referrals/ADS-1-v4-1024x1024.png"
        alt="Invoice Ninja Referral Program - Earn 50% for 3 years"
        loading="lazy"
        class="w-full max-w-lg mx-auto rounded-xl shadow-lg"
      />
    </div>
  </section>

  <!-- Logos & Ads Section -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-6">Logos & ads to help you get started!</h2>
      <p class="text-xl text-gray-600 mb-8">Download our logos (color and monochrome versions) and advertisement templates in various dimensions to promote Invoice Ninja on your website and social media channels.</p>
      <Button href="https://app.invoicing.co/#/register" size="lg">Get Started!</Button>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-[#1e293b] to-[#0f172a]">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">Ready to start earning?</h2>
      <p class="text-xl text-gray-300 mb-8">Sign up today and start sharing your referral link. It's free to join.</p>
      <Button href="https://app.invoicing.co/#/register" size="lg">Get Started!</Button>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
