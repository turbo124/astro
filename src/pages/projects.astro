---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";

const faqs = [
  {
    question: "Can I invoice tasks & products together?",
    answer: `<p>Yes, you can include both completed timed-tasks on an invoice with regular items from your product library!</p>`,
  },
  {
    question: "Can I invoice a task and re-invoice expenses in the same project?",
    answer: `<p>Yes, you can combine completed tasks, re-billed expenses, and items from your product library all together on a single invoice!</p>`,
  },
  {
    question: "How do I assign different users to different tasks?",
    answer: `<p>As part of the <a href="/pricing-plans/" class="text-primary hover:underline">Enterprise plan</a> you can have additional account users and set access-permissions per user. When creating new tasks you can assign it to a user!</p>`,
  },
  {
    question: "Can I set a total # budget hours for a project?",
    answer: `<p>Yes, you can set a budgeted number of work-hours per project, and define the task rates per project or per individual project task.</p>`,
  },
];

const featureCards = [
  {
    title: "Create & Organize",
    description: "Create & organize projects, tasks & track billable work-time.",
    icon: `<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10.5v6m3-3H9m4.06-7.19l-2.12-2.12a1.5 1.5 0 00-1.06-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V8.25a2.25 2.25 0 00-2.25-2.25h-5.38a1.5 1.5 0 01-1.06-.44z" /></svg>`,
  },
  {
    title: "Invoice Tasks with 1-Click",
    description: "Send/add completed tasks to invoice line-items with 1-click.",
    icon: `<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zM12 2.25V4.5m5.834.166l-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243l-1.59-1.59" /></svg>`,
  },
  {
    title: "Assign Tasks to Users",
    description: "Assign project tasks to different company account users.",
    icon: `<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`,
  },
  {
    title: "Kanban Board View",
    description: "Switch between line-item and Kanban board views to manage projects & tasks.",
    icon: `<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z" /></svg>`,
  },
  {
    title: "Define Tasks Workflow",
    description: "Define default work-rates at an account level, per client, or per each work-task.",
    icon: `<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>`,
  },
  {
    title: "Auto & Manual Tracking",
    description: "Platform timer options to auto-start/stop tasks or adjust work-times manually.",
    icon: `<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
];
---

<BaseLayout title="Projects, Tasks & Time Tracking" description="Create projects, manage tasks with Kanban boards, track billable hours, and convert timed-tasks to invoices with 1-click." path="/projects/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-3">Time-Tracking & Projects</p>
      <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-6">Create Projects, Tasks & Track-Time</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">Task time-tracking allows you to accurately record every second spent on each individual task and quickly transfer timed data to the relevant invoice.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="https://react.invoicing.co/demo" size="lg">Test Drive!</Button>
        <Button href="https://app.invoicing.co/#/register" variant="outline" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <!-- Time-Tracking & Projects -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-3xl font-bold text-dark mb-6">Time-Tracking & Projects</h2>
          <ul class="space-y-4 mb-6">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Create Project, Tasks, and Track Billable-Work</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Convert Timed-Tasks to Invoices with 1-Click</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Easily Categorize to Search Tasks & Projects</span>
            </li>
          </ul>
          <p class="text-gray-600">When you're done with a task or series of tasks within a project, simply click and send your work-time to an invoice with 1-click!</p>
        </div>
        <img src="/images/how-it-works/track-work-tasks.png" alt="Time tracking and projects" class="w-full rounded-xl shadow-lg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Projects & Kanban Boards -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <img src="/images/how-it-works/track-work-tasks.png" alt="Projects and Kanban boards" class="w-full rounded-xl shadow-lg md:order-first" loading="lazy" />
        <div>
          <h2 class="text-3xl font-bold text-dark mb-6">Projects & Kanban Boards</h2>
          <ul class="space-y-4 mb-6">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Organize Projects & Workflow with Kanban Boards</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Attach Files to Projects &/or Invoiced Tasks</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-700">Assign tasks within a project to different users</span>
            </li>
          </ul>
          <p class="text-gray-600">At Invoice Ninja we have created our own Kanban boards which can be used to plan, update, and analyze your workflows. Columns and cards can be customized to suit your exact workflow!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Feature Cards -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-12 text-center">Project & Task Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featureCards.map((card) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white hover:shadow-lg transition-shadow text-center">
            <div class="flex justify-center mb-4" set:html={card.icon} />
            <h3 class="text-lg font-bold text-dark mb-2">{card.title}</h3>
            <p class="text-sm text-gray-600">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-12 text-center">Frequently Asked Questions</h2>
      <div class="space-y-3" id="projects-faq-list">
        {faqs.map((faq) => (
          <div class="faq-item border border-gray-200 rounded-xl overflow-hidden bg-white">
            <button
              class="faq-toggle w-full flex items-center justify-between px-6 py-5 text-left hover:bg-gray-50 transition-colors"
              aria-expanded="false"
            >
              <span class="text-base font-semibold text-dark pr-4">{faq.question}</span>
              <svg class="faq-arrow w-5 h-5 text-gray-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-content hidden px-6 pb-6">
              <div class="text-sm text-gray-600 leading-relaxed space-y-3" set:html={faq.answer} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Support & Community -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-dark mb-4 text-center">Hey there! Talk to us!</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        <div class="p-6 rounded-xl border border-gray-200 bg-white text-center">
          <svg class="w-10 h-10 text-primary mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>
          <h3 class="text-lg font-bold text-dark mb-2">Community Forums</h3>
          <p class="text-sm text-gray-600 mb-3">Connect with thousands of Invoice Ninja users on our community forums.</p>
          <a href="https://forum.invoiceninja.com" class="text-sm font-semibold text-primary hover:underline" target="_blank" rel="noopener">Visit Forums &rarr;</a>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white text-center">
          <svg class="w-10 h-10 text-primary mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          <h3 class="text-lg font-bold text-dark mb-2">Contact</h3>
          <p class="text-sm text-gray-600 mb-3">We want to hear from you!</p>
          <a href="mailto:contact@invoiceninja.com" class="text-sm font-semibold text-primary hover:underline">contact@invoiceninja.com</a>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white text-center">
          <svg class="w-10 h-10 text-primary mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
          <h3 class="text-lg font-bold text-dark mb-2">Slack Community</h3>
          <p class="text-sm text-gray-600 mb-3">Join over 5,000 Invoice Ninja members on our Slack Support Channel!</p>
          <a href="https://slack.invoiceninja.com/" class="text-sm font-semibold text-primary hover:underline" target="_blank" rel="noopener">Join Slack &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 bg-primary">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-white mb-3">Start Invoicing Today!</h2>
      <p class="text-lg text-white/80 mb-8">Create. Send. Get Paid.</p>
      <Button href="https://react.invoicing.co/demo" size="lg" variant="outline" class="border-white text-white hover:bg-white hover:text-primary">Test Drive!</Button>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // FAQ accordion toggle
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const arrow = btn.querySelector('.faq-arrow');
      const isOpen = content?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      arrow?.classList.toggle('rotate-180', isOpen);
    });
  });
</script>
