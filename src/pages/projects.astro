---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Projects, Tasks & Time Tracking" description="Create projects, manage tasks with Kanban boards, track billable hours, and convert to invoices." path="/projects/">
  <Header slot="header" />

  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-4">Projects, Tasks & Time Tracking</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">Create projects, manage tasks with Kanban boards, track billable hours, and convert to invoices.</p>
      </div>

      <div class="mt-12 text-center">
        <Button href="https://app.invoicing.co/#/register" size="lg">Get Started Free</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
