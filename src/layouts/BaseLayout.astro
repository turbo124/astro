---
import SEOHead from '../components/seo/SEOHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  locale?: Locale;
  path?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Invoice Ninja — Free open-source invoicing, payments, expenses & time-tracking.",
  canonicalURL,
  ogImage,
  ogType,
  locale = 'en',
  path,
  noindex,
} = Astro.props;

const htmlLang = locale === 'be' ? 'nl-BE' : locale;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Invoice Ninja',
  url: 'https://invoiceninja.com',
  logo: 'https://invoiceninja.com/images/logo-circle.png',
  sameAs: [
    'https://github.com/invoiceninja',
    'https://twitter.com/invoiceninja',
    'https://www.facebook.com/invoiceninja',
  ],
};
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <SEOHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      ogType={ogType}
      locale={locale}
      path={path}
      noindex={noindex}
    />

    <JsonLd data={organizationSchema} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Global CSS -->
    <style>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="font-sans text-dark bg-white antialiased">
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
