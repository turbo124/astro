---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
  locale?: Locale;
  path?: string;
}

const {
  title,
  description = `${title} — Invoice Ninja`,
  lastUpdated,
  locale = 'en',
  path,
} = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale} path={path}>
  <Header slot="header" />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
    <header class="mb-10 border-b border-gray-200 pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-dark mb-3">{title}</h1>
      {lastUpdated && (
        <p class="text-sm text-gray-500">Last updated: {lastUpdated}</p>
      )}
    </header>

    <div class="prose prose-gray max-w-none
      prose-headings:font-bold prose-headings:text-dark
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-li:marker:text-gray-400">
      <slot />
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
